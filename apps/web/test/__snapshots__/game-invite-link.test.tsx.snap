exports[`weekly game invite link > preserves the pair page and share card byte for byte > pair page 1`] = `"<link rel="preload" as="image" href="/logo-dark.svg"/><div class="@container flex flex-1 flex-col bg-[#1C1915] text-[#FFFCF6]"><div class="flex flex-1 flex-col @5xl:flex-row @5xl:items-center @5xl:justify-center @5xl:gap-20"><div class="mx-auto flex w-full max-w-[26rem] flex-1 flex-col px-6 pb-6 pt-3 sm:my-auto sm:flex-none sm:py-16 @5xl:mx-0"><div class="flex h-11 shrink-0 items-center"><img alt="Murph" class="h-[25px] w-auto" height="25" src="/logo-dark.svg" width="112" data-priority="true"/></div><section class="pt-5"><h1 class="text-balance font-serif text-[40px] font-semibold leading-[44px] tracking-[-0.02em] sm:text-5xl sm:leading-[52px]">Leo challenged you.</h1><p class="mt-2.5 text-pretty text-base font-medium leading-[22px] text-[#FFFCF6]/60">Weekdays for a week. Starts once you say yes.</p><p class="mt-1 text-pretty text-base font-medium leading-[22px] text-[#FFFCF6]/60">Prove it with a photo.</p><ul class="mt-[22px] flex flex-col gap-2"><li class="flex min-h-16 items-center gap-3 rounded-[18px] bg-[#2A2622] py-2.5 pl-3 pr-4"><span aria-hidden="true" class="flex size-[38px] shrink-0 items-center justify-center rounded-full" style="background:#8B5D3F"><svg fill="#FFFCF6" height="20" viewBox="0 0 20 20" width="20"><circle cx="10" cy="6.6" r="3.6"></circle><path d="M3.2 17.2c.6-3.6 3.4-5.8 6.8-5.8s6.2 2.2 6.8 5.8c.1.5-.3.8-.7.8H3.9c-.4 0-.8-.3-.7-.8z"></path></svg></span><div class="flex min-w-0 flex-col gap-px"><span class="text-xs font-semibold leading-4 text-[#FFFCF6]/55">You</span><span class="text-balance break-words text-lg font-semibold leading-[23px]">10 min abs</span></div></li><li class="flex min-h-16 items-center gap-3 rounded-[18px] bg-[#2A2622] py-2.5 pl-3 pr-4"><span aria-hidden="true" class="flex size-[38px] shrink-0 items-center justify-center rounded-full" style="background:#5A6E32"><span class="text-base font-semibold">L</span></span><div class="flex min-w-0 flex-col gap-px"><span class="text-xs font-semibold leading-4 text-[#FFFCF6]/55">Leo</span><span class="text-balance break-words text-lg font-semibold leading-[23px]">100 pushups</span></div></li><li class="pt-2"><div class="relative flex flex-col gap-1 overflow-hidden px-5 py-[18px]" style="background:linear-gradient(135deg, #EBD18B 0%, #D9B969 55%, #C59D4E 100%)"><span class="font-mono text-[10px] uppercase leading-[14px] tracking-[0.2em] text-[#3B2A12]/80">For the winner</span><span class="text-balance break-words font-serif text-[26px] font-semibold leading-8 text-[#3B2A12]">Breakfast in bed</span><span aria-hidden="true" class="absolute size-[18px] rounded-full -left-[9px] -top-[9px]" style="background:#1C1915"></span><span aria-hidden="true" class="absolute size-[18px] rounded-full -right-[9px] -top-[9px]" style="background:#1C1915"></span><span aria-hidden="true" class="absolute size-[18px] rounded-full -bottom-[9px] -left-[9px]" style="background:#1C1915"></span><span aria-hidden="true" class="absolute size-[18px] rounded-full -bottom-[9px] -right-[9px]" style="background:#1C1915"></span></div></li></ul></section><div class="mt-auto flex flex-col items-center gap-4 pt-10 sm:mt-0 sm:pt-12"><a class="flex h-14 w-full items-center justify-center gap-2 rounded-full bg-[#FFFCF6] text-[17px] font-semibold text-[#2D3436] outline-none transition-opacity hover:opacity-90 focus-visible:ring-2 focus-visible:ring-[#FFFCF6]/70 focus-visible:ring-offset-2 focus-visible:ring-offset-[#1C1915]" href="https://apps.apple.com/us/app/murph-ai/id6786145859"><svg aria-hidden="true" fill="currentColor" height="20" viewBox="0 0 17 20" width="17"><path d="M14.1 10.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.5 1.3 0 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.2 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9 0 0-2.7-1-2.7-4zM11.6 3c.7-.9 1.2-2 1.1-3.2-1 0-2.3.7-3 1.6-.7.8-1.2 2-1.1 3.1 1.2.1 2.3-.6 3-1.5z"></path></svg>Get the app</a><p class="text-center text-[15px] font-medium leading-5 text-[#FFFCF6]/60">Already have Murph? <a class="rounded-sm font-semibold text-[#FFFCF6] underline-offset-4 outline-none hover:underline focus-visible:ring-2 focus-visible:ring-[#FFFCF6]/70" href="ai.withmurph.app://invite/synthetic">Open it</a></p></div></div></div></div>"`;

exports[`weekly game invite link > preserves the pair page and share card byte for byte > pair share card 1`] = `"<div style="align-items:center;background:linear-gradient(180deg, #98704F 0%, #7E5A3E 50%, #644630 100%);display:flex;height:100%;justify-content:center;width:100%"><div style="border-radius:26px;box-shadow:0 18px 36px rgba(46, 24, 10, 0.3), 0 3px 8px rgba(46, 24, 10, 0.2);display:flex;flex-direction:column;width:520px"><div style="align-items:center;background:linear-gradient(180deg, #FFFCF6 0%, #F3EEE4 100%);border-top-left-radius:26px;border-top-right-radius:26px;display:flex;flex-direction:column;gap:28px;padding:40px 36px 36px"><div style="color:#8B5D3F;display:flex;font-family:DM Sans;font-size:20px;letter-spacing:5.6px">CHALLENGE</div><div style="align-items:flex-start;display:flex;justify-content:space-between;width:100%"><div style="align-items:center;display:flex;flex-direction:column;gap:8px;width:190px"><div style="color:#2D3436;display:flex;font-family:Fraunces;font-size:62px;font-weight:600;letter-spacing:-0.6px;line-height:70px;text-align:center">Leo</div><div style="background:#5A6E32;border-radius:2px;display:flex;height:4px;width:40px"></div><div style="color:#736A58;display:flex;font-family:DM Sans;font-size:24px;line-height:1.3;text-align:center">100 pushups</div></div><div style="color:#A39782;display:flex;font-family:Fraunces;font-size:30px;font-weight:600;line-height:70px">vs.</div><div style="align-items:center;display:flex;flex-direction:column;gap:8px;width:190px"><div style="color:#2D3436;display:flex;font-family:Fraunces;font-size:62px;font-weight:600;letter-spacing:-0.6px;line-height:70px;text-align:center">You</div><div style="background:#8B5D3F;border-radius:2px;display:flex;height:4px;width:40px"></div><div style="color:#736A58;display:flex;font-family:DM Sans;font-size:24px;line-height:1.3;text-align:center">10 min abs</div></div></div><div style="color:#A39782;display:flex;font-family:DM Sans;font-size:18px;letter-spacing:3.6px">WEEKDAYS · 7 DAYS</div></div><div style="background:linear-gradient(180deg, #F3EEE4 50%, #E6CC87 50%);display:flex;height:30px;position:relative"><div style="border-top:2px dashed rgba(59, 42, 18, 0.35);display:flex;margin-left:26px;margin-right:26px;margin-top:14px;width:468px"></div><div style="background:#8B5D3F;border-radius:15px;display:flex;height:30px;left:-15px;position:absolute;top:0;width:30px"></div><div style="background:#8B5D3F;border-radius:15px;display:flex;height:30px;position:absolute;right:-15px;top:0;width:30px"></div></div><div style="align-items:center;background:linear-gradient(135deg, #E6CC87 0%, #C4A058 45%, #E2C785 75%, #B08A45 100%);border-bottom-left-radius:26px;border-bottom-right-radius:26px;display:flex;flex-direction:column;gap:6px;padding:24px 36px 32px"><div style="color:rgba(59, 42, 18, 0.7);display:flex;font-family:DM Sans;font-size:18px;letter-spacing:4.3px">FOR THE WINNER</div><div style="color:#3B2A12;display:flex;font-family:Fraunces;font-size:44px;font-weight:600;line-height:1.2;text-align:center">Breakfast in bed</div></div></div></div>"`;
