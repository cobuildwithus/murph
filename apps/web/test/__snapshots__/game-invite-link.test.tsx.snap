g:3.6px">WEEKDAYS · 7 DAYS</div></div><div style="background:linear-gradient(180deg, #F3EEE4 50%, #E6CC87 50%);display:flex;height:30px;position:relative"><div style="border-top:2px dashed rgba(59, 42, 18, 0.35);display:flex;margin-left:26px;margin-right:26px;margin-top:14px;width:468px"></div><div style="background:#8B5D3F;border-radius:15px;display:flex;height:30px;left:-15px;position:absolute;top:0;width:30px"></div><div style="background:#8B5D3F;border-radius:15px;display:flex;height:30px;position:absolute;right:-15px;top:0;width:30px"></div></div><div style="align-items:center;background:linear-gradient(135deg, #E6CC87 0%, #C4A058 45%, #E2C785 75%, #B08A45 100%);border-bottom-left-radius:26px;border-bottom-right-radius:26px;display:flex;flex-direction:column;gap:6px;padding:24px 36px 32px"><div style="color:rgba(59, 42, 18, 0.7);display:flex;font-family:DM Sans;font-size:18px;letter-spacing:4.3px">FOR THE WINNER</div><div style="color:#3B2A12;display:flex;font-family:Fraunces;font-size:44px;font-weight:600;line-height:1.2;text-align:center">Breakfast in bed</div></div></div></div>"`;
