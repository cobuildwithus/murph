  failedAt                 DateTime? @map("failed_at")
  retryAfterAt             DateTime? @map("retry_after_at")
  skippedAt                DateTime? @map("skipped_at")
  lastReceiptAt            DateTime? @map("last_receipt_at")
  lastProviderEventId      String?  @map("last_provider_event_id")
  failureCode              String?  @map("failure_code")
  failureReason            String?  @map("failure_reason")
  skipReason               String?  @map("skip_reason")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")
  groupJoinOutreach        HostedGroupJoinOutreach? @relation(fields: [groupJoinOutreachId], references: [id], onDelete: Cascade)
  line                     HostedLinqLine? @relation(fields: [phoneNumberLookupKey], references: [phoneNumberLookupKey], onDelete: SetNull)
  alerts                   HostedLinqAlert[]
  ingressLatencyTraces     HostedIngressLatencyTrace[]
  messages                 HostedLinqDeliveryMessage[]

  @@index([groupJoinOutreachId, status, attemptedAt], map: "hosted_linq_delivery_group_join_outreach_status_idx")
  @@index([phoneNumberLookupKey, attemptedAt])
  @@index([status, attemptedAt])
  @@index([linqChatLookupKey, attemptedAt])
  @@index([lastReceiptAt])
  @@index([acceptedAt, id], map: "hosted_linq_delivery_accepted_at_id_idx")
  @@map("hosted_linq_delivery")
}

model HostedLinqDeliveryMessage {
  id                  String   @id
  deliveryId          String   @map("delivery_id")
  ordinal             Int
  messageLookupKey    String   @unique @map("message_lookup_key")
  messageIdSuffix     String?  @map("message_id_suffix")
  status              String   @default("accepted")
  acceptedAt          DateTime @map("accepted_at")
  deliveredAt         DateTime? @map("delivered_at")
  failedAt            DateTime? @map("failed_at")
  lastReceiptAt       DateTime? @map("last_receipt_at")
  lastProviderEventId String?  @map("last_provider_event_id")
  failureCode         String?  @map("failure_code")
  failureReason       String?  @map("failure_reason")
  service             String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  delivery            HostedLinqDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, ordinal])
  @@index([deliveryId, status])
  @@index([lastReceiptAt])
  @@map("hosted_linq_delivery_message")
}

model HostedLinqAlert {
  id                   String   @id
  kind                 String
  status               String   @default("pending")
  eventId              String?  @map("event_id")
  deliveryId           String?  @map("delivery_id")
  phoneNumberLookupKey String?  @map("phone_number_lookup_key")
  phoneNumberHint      String?  @map("phone_number_hint")
  subject              String
  detailsJson          Json     @map("details_json")
  claimedAt            DateTime @map("claimed_at")
  lastAttemptedAt      DateTime? @map("last_attempted_at")
  sentAt               DateTime? @map("sent_at")
  providerMessageId    String?  @map("provider_message_id")
  attemptCount         Int      @default(0) @map("attempt_count")
  lastErrorCode        String?  @map("last_error_code")
  lastProviderStatus   Int?     @map("last_provider_status")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  event                HostedLinqProviderEvent? @relation(fields: [eventId], references: [eventId], onDelete: SetNull)
  delivery             HostedLinqDelivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  line                 HostedLinqLine? @relation(fields: [phoneNumberLookupKey], references: [phoneNumberLookupKey], onDelete: SetNull)

  @@unique([kind, eventId])
  @@index([status, claimedAt])
  @@index([phoneNumberLookupKey, createdAt])
  @@map("hosted_linq_alert")
}

model HostedAiUsage {
