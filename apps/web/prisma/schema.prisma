  updatedAt                  DateTime     @updatedAt @map("updated_at")
  member                     HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([turnId, attemptCount, providerRequestOrdinal], map: "hosted_ai_usage_turn_attempt_provider_request_idx")
  @@index([featureKey, createdAt])
  @@index([memberId, allowancePeriodStart])
  @@index([memberId, occurredAt])
  @@index([reportingUserId, createdAt])
  @@index([stripeMeterStatus, stripeMeterNextAttemptAt, occurredAt], map: "hosted_ai_usage_stripe_meter_due_idx")
  @@index([surface, createdAt])
  @@map("hosted_ai_usage")
