generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DeviceConnection {
  id                       String             @id
  userId                   String             @map("user_id")
  provider                 String
  providerAccountBlindIndex String            @map("provider_account_blind_index")
  status                   String             @default("active")
  displayName              String?            @map("display_name")
  scopesJson               Json?              @map("scopes_json")
  metadataJson             Json?              @map("metadata_json")
  externalAccountIdEncrypted String?          @map("external_account_id_encrypted")
  accessTokenEncrypted     String?            @map("access_token_encrypted")
  refreshTokenEncrypted    String?            @map("refresh_token_encrypted")
  accessTokenExpiresAt     DateTime?          @map("access_token_expires_at")
  tokenVersion             Int?               @map("token_version")
  keyVersion               String?            @map("key_version")
  connectedAt              DateTime           @map("connected_at")
  lastWebhookAt            DateTime?          @map("last_webhook_at")
  lastSyncStartedAt        DateTime?          @map("last_sync_started_at")
  lastSyncCompletedAt      DateTime?          @map("last_sync_completed_at")
  lastSyncErrorAt          DateTime?          @map("last_sync_error_at")
  lastErrorCode            String?            @map("last_error_code")
  lastErrorMessage         String?            @map("last_error_message")
  nextReconcileAt          DateTime?          @map("next_reconcile_at")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  signals                  DeviceSyncSignal[]
  tokenAudits              DeviceTokenAudit[]

  @@unique([provider, providerAccountBlindIndex])
  @@index([userId, provider])
  @@map("device_connection")
}

model DeviceTokenAudit {
  id                   Int              @id @default(autoincrement())
  userId               String           @map("user_id")
  connectionId         String           @map("connection_id")
  provider             String
  action               String
  channel              String
  sessionId            String?          @map("session_id")
  tokenVersion         Int              @map("token_version")
  keyVersion           String           @map("key_version")
  expectedTokenVersion Int?             @map("expected_token_version")
  forceRefresh         Boolean?         @map("force_refresh")
  refreshOutcome       String?          @map("refresh_outcome")
  tokenVersionChanged  Boolean?         @map("token_version_changed")
  createdAt            DateTime         @default(now()) @map("created_at")
  connection           DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([connectionId, createdAt])
  @@index([createdAt])
  @@map("device_token_audit")
}

model DeviceOauthSession {
  state        String   @id
  userId       String?  @map("user_id")
  provider     String
  returnTo     String?  @map("return_to")
  createdAt    DateTime @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@index([userId, provider])
  @@map("device_oauth_session")
}

model DeviceWebhookTrace {
  provider                 String
  traceId                  String    @map("trace_id")
  providerAccountBlindIndex String   @map("provider_account_blind_index")
  eventType                String    @map("event_type")
  status                   String    @default("processed")
  processingExpiresAt      DateTime? @map("processing_expires_at")
  receivedAt               DateTime  @map("received_at")
  createdAt                DateTime  @default(now()) @map("created_at")

  @@id([provider, traceId])
  @@index([provider, providerAccountBlindIndex])
  @@index([receivedAt])
  @@map("device_webhook_trace")
}

model DeviceSyncSignal {
  id                   Int               @id @default(autoincrement())
  userId               String            @map("user_id")
  connectionId         String?           @map("connection_id")
  provider             String
  kind                 String
  occurredAt           DateTime?         @map("occurred_at")
  traceId              String?           @map("trace_id")
  eventType            String?           @map("event_type")
  resourceCategory     String?           @map("resource_category")
  reason               String?           @map("reason")
  nextReconcileAt      DateTime?         @map("next_reconcile_at")
  revokeWarningCode    String?           @map("revoke_warning_code")
  revokeWarningMessage String?           @map("revoke_warning_message")
  createdAt            DateTime          @default(now()) @map("created_at")
  connection           DeviceConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([connectionId])
  @@map("device_sync_signal")
}

model DeviceAgentSession {
  id                  String    @id
  userId              String    @map("user_id")
  label               String?
  tokenHash           String    @unique @map("token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  expiresAt           DateTime  @map("expires_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  revokedAt           DateTime? @map("revoked_at")
  revokeReason        String?   @map("revoke_reason")
  replacedBySessionId String?   @map("replaced_by_session_id")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([replacedBySessionId])
  @@map("device_agent_session")
}

model DeviceBrowserAssertionNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("device_browser_assertion_nonce")
}

model HostedWebInternalRequestNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  search    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("hosted_web_internal_request_nonce")
}

enum HostedBillingStatus {
  not_started
  active
  incomplete
  past_due
  canceled
  unpaid
  paused
}

enum HostedStripeEventStatus {
  pending
  processing
  completed
  failed
  poisoned
}

enum HostedRevnetIssuanceStatus {
  pending
  submitting
  submitted
  confirmed
  failed
}

enum HostedIngressBehavior {
  ordered
  coalescing
}

model HostedMember {
  id              String                  @id
  billingStatus   HostedBillingStatus     @default(not_started) @map("billing_status")
  suspendedAt     DateTime?               @map("suspended_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")
  invites         HostedInvite[]
  revnetIssuances HostedRevnetIssuance[]
  aiUsage         HostedAiUsage[]
  linqDailyStates HostedLinqDailyState[]
  identity        HostedMemberIdentity?
  routing         HostedMemberRouting?
  billingRef      HostedMemberBillingRef?
  emailAuthorization HostedMemberEmailAuthorization?
  executionCursor HostedExecutionCursor?
  hostedIngressEvents        HostedIngressEvent[]
  hostedIngressEventAliases  HostedIngressEventAlias[]
  hostedIngressPayloads      HostedIngressPayload[]
  hostedRuns         HostedRun[]
  hostedRunLogs      HostedRunLog[]
  vaultSyncSessions  HostedVaultSyncSession[]
  vaultSyncPayloads  HostedVaultSyncPayload[]

  @@index([billingStatus])
  @@map("hosted_member")
}

model HostedMemberIdentity {
  memberId                       String       @unique @map("member_id")
  maskedPhoneNumberHint          String?      @map("masked_phone_number_hint")
  phoneLookupKey                 String?      @unique @map("phone_lookup_key")
  phoneNumberEncrypted           String?      @map("phone_number_encrypted")
  phoneNumberVerifiedAt          DateTime?    @map("phone_number_verified_at")
  privyUserLookupKey             String?      @unique @map("privy_user_lookup_key")
  privyUserIdEncrypted           String?      @map("privy_user_id_encrypted")
  walletAddressLookupKey         String?      @unique @map("wallet_address_lookup_key")
  walletAddressEncrypted         String?      @map("wallet_address_encrypted")
  walletChainType                String?      @map("wallet_chain_type")
  walletProvider                 String?      @map("wallet_provider")
  walletCreatedAt                DateTime?    @map("wallet_created_at")
  signupPhoneNumberEncrypted     String?      @map("signup_phone_number_encrypted")
  signupPhoneCodeSentAt          DateTime?    @map("signup_phone_code_sent_at")
  signupPhoneCodeSendAttemptId   String?      @map("signup_phone_code_send_attempt_id")
  signupPhoneCodeSendAttemptStartedAt DateTime? @map("signup_phone_code_send_attempt_started_at")
  createdAt                      DateTime     @default(now()) @map("created_at")
  updatedAt                      DateTime     @updatedAt @map("updated_at")
  member                         HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_member_identity")
}

model HostedMemberRouting {
  memberId                       String       @unique @map("member_id")
  /// Sticky post-activation Linq home thread for the member's long-lived Murph number.
  linqChatLookupKey              String?      @unique @map("linq_chat_lookup_key")
  linqChatIdEncrypted            String?      @map("linq_chat_id_encrypted")
  linqRecipientPhoneLookupKey    String?      @map("linq_recipient_phone_lookup_key")
  linqRecipientPhoneEncrypted    String?      @map("linq_recipient_phone_encrypted")
  /// Pre-activation Linq acquisition/referral thread before a home line is chosen.
  pendingLinqChatLookupKey       String?      @unique @map("pending_linq_chat_lookup_key")
  pendingLinqChatIdEncrypted     String?      @map("pending_linq_chat_id_encrypted")
  pendingLinqRecipientPhoneLookupKey String?  @map("pending_linq_recipient_phone_lookup_key")
  pendingLinqRecipientPhoneEncrypted String?  @map("pending_linq_recipient_phone_encrypted")
  replyAliasLookupKey            String?      @unique @map("reply_alias_lookup_key")
  telegramUserLookupKey          String?      @unique @map("telegram_user_lookup_key")
  telegramUserIdEncrypted        String?      @map("telegram_user_id_encrypted")
  createdAt                      DateTime     @default(now()) @map("created_at")
  updatedAt                      DateTime     @updatedAt @map("updated_at")
  member                         HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([linqRecipientPhoneLookupKey])
  @@index([pendingLinqRecipientPhoneLookupKey])
  @@map("hosted_member_routing")
}

model HostedMemberBillingRef {
  memberId                      String       @unique @map("member_id")
  stripeCustomerLookupKey       String?      @unique @map("stripe_customer_lookup_key")
  stripeCustomerIdEncrypted     String?      @map("stripe_customer_id_encrypted")
  stripeSubscriptionLookupKey   String?      @unique @map("stripe_subscription_lookup_key")
  stripeSubscriptionIdEncrypted String?      @map("stripe_subscription_id_encrypted")
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")
  member                        HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_member_billing_ref")
}

model HostedMemberEmailAuthorization {
  memberId                         String       @unique @map("member_id")
  verifiedEmailLookupKey           String?      @unique @map("verified_email_lookup_key")
  verifiedEmailAddressEncrypted    String?      @map("verified_email_address_encrypted")
  verifiedEmailVerifiedAt          DateTime?    @map("verified_email_verified_at")
  directPublicSenderLookupKey      String?      @unique @map("direct_public_sender_lookup_key")
  directPublicSenderAddressEncrypted String?    @map("direct_public_sender_address_encrypted")
  directPublicSenderAuthorizedAt   DateTime?    @map("direct_public_sender_authorized_at")
  createdAt                        DateTime     @default(now()) @map("created_at")
  updatedAt                        DateTime     @updatedAt @map("updated_at")
  member                           HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_member_email_authorization")
}

model HostedExecutionCursor {
  userId       String       @id @map("user_id")
  nextSeq      BigInt       @default(1) @map("next_seq")
  committedSeq BigInt       @default(0) @map("committed_seq")
  nextRuntimeWakeAt DateTime? @map("next_runtime_wake_at")
  nextRuntimeWakeReason String? @map("next_runtime_wake_reason")
  snapshotRef  Json?        @map("snapshot_ref")
  browserVaultReplicaRef Json? @map("browser_vault_replica_ref")
  version      BigInt       @default(0) @map("version")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  member       HostedMember @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("hosted_execution_cursor")
}

model HostedIngressEvent {
  id                    String             @id
  userId                String             @map("user_id")
  runId                 String?            @map("run_id")
  seq                   BigInt             @map("seq")
  kind                  String
  behavior              HostedIngressBehavior
  state                 String             @default("pending")
  dedupeKey             String?            @map("dedupe_key")
  coalescingKey         String?            @map("coalescing_key")
  occurredAt            DateTime           @map("occurred_at")
  payloadSchema         String             @map("payload_schema")
  payloadInlineCiphertext String?          @map("payload_inline_ciphertext")
  payloadRef            String?            @map("payload_ref")
  payloadBytes          Int?               @map("payload_bytes")
  completedAt           DateTime?          @map("completed_at")
  quarantinedAt         DateTime?          @map("quarantined_at")
  quarantineCode        String?            @map("quarantine_code")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  member                HostedMember       @relation(fields: [userId], references: [id], onDelete: Cascade)
  run                   HostedRun?         @relation(fields: [runId], references: [id], onDelete: SetNull)
  aliases               HostedIngressEventAlias[]
  payload               HostedIngressPayload?

  @@unique([userId, seq])
  @@unique([userId, dedupeKey])
  @@index([userId, seq])
  @@index([userId, state, seq])
  @@index([runId])
  @@index([userId, coalescingKey, seq])
  @@index([userId, kind, seq])
  @@map("hosted_ingress_event")
}

model HostedRun {
  id                   String         @id
  userId               String         @map("user_id")
  executorKind         String         @default("cloudflare-container") @map("executor_kind")
  executorCodeDigest   String?        @map("executor_code_digest")
  attestationRef       String?        @map("attestation_ref")
  signedResultRef      String?        @map("signed_result_ref")
  status               String
  triggerKind          String         @map("trigger_kind")
  runTokenHash         String         @unique @map("run_token_hash")
  inputCommittedSeq    BigInt         @map("input_committed_seq")
  outputCommittedSeq   BigInt?        @map("output_committed_seq")
  inputCursorVersion   BigInt         @map("input_cursor_version")
  outputCursorVersion  BigInt?        @map("output_cursor_version")
  inputSnapshotRef     Json?          @map("input_snapshot_ref")
  preparedSnapshotRef  Json?          @map("prepared_snapshot_ref")
  finalSnapshotRef     Json?          @map("final_snapshot_ref")
  nextRuntimeWakeAt    DateTime?      @map("next_runtime_wake_at")
  nextRuntimeWakeReason String?       @map("next_runtime_wake_reason")
  eventCount           Int            @default(0) @map("event_count")
  eventKindsJson       Json           @map("event_kinds_json")
  eventSeqsJson        Json           @map("event_seqs_json")
  ingressEventIdsJson  Json           @map("wake_ids_json")
  redactedSummaryJson  Json?          @map("redacted_summary_json")
  errorCode            String?        @map("error_code")
  errorClass           String?        @map("error_class")
  attempt              Int            @default(1)
  acquiredAt           DateTime       @map("acquired_at")
  startedAt            DateTime?      @map("started_at")
  preparedAt           DateTime?      @map("prepared_at")
  committedAt          DateTime?      @map("committed_at")
  finalizedAt          DateTime?      @map("finalized_at")
  failedAt             DateTime?      @map("failed_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")
  member               HostedMember   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingressEvents        HostedIngressEvent[]
  logs                 HostedRunLog[]

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([triggerKind, createdAt])
  @@map("hosted_run")
}

model HostedRunLog {
  id             String       @id
  runId          String       @map("run_id")
  userId         String       @map("user_id")
  at             DateTime
  level          String
  component      String
  phase          String
  message        String
  redactedJson   Json?        @map("redacted_json")
  createdAt      DateTime     @default(now()) @map("created_at")
  member         HostedMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  run            HostedRun    @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, at])
  @@index([runId, at])
  @@index([level, at])
  @@map("hosted_run_log")
}

model HostedIngressEventAlias {
  eventId           String       @map("event_id")
  ingressEventId    String       @map("ingress_event_id")
  userId            String       @map("user_id")
  replacedByEventId String?      @map("replaced_by_event_id")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  member            HostedMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingressEvent      HostedIngressEvent @relation(fields: [ingressEventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
  @@index([userId])
  @@index([userId, replacedByEventId])
  @@index([ingressEventId])
  @@map("hosted_ingress_event_alias")
}

model HostedIngressPayload {
  ingressEventId    String       @id @map("ingress_event_id")
  userId            String       @map("user_id")
  payloadCiphertext String       @map("payload_ciphertext")
  payloadSchema     String       @map("payload_schema")
  payloadBytes      Int          @map("payload_bytes")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  member            HostedMember @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingressEvent      HostedIngressEvent @relation(fields: [ingressEventId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("hosted_ingress_payload")
}

model HostedInvite {
  id         String                  @id
  memberId   String                  @map("member_id")
  inviteCode String                  @unique @map("invite_code")
  channel    String                  @default("linq")
  sentAt     DateTime?               @map("sent_at")
  expiresAt  DateTime                @map("expires_at")
  createdAt  DateTime                @default(now()) @map("created_at")
  updatedAt  DateTime                @updatedAt @map("updated_at")
  member     HostedMember            @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([expiresAt])
  @@map("hosted_invite")
}

model HostedStripeEvent {
  eventId          String                  @id @map("event_id")
  type             String
  stripeCreatedAt  DateTime                @map("stripe_created_at")
  receivedAt       DateTime                @map("received_at")
  status           HostedStripeEventStatus @default(pending)
  attemptCount     Int                     @default(0) @map("attempt_count")
  nextAttemptAt    DateTime                @default(now()) @map("next_attempt_at")
  claimExpiresAt   DateTime?               @map("claim_expires_at")
  processedAt      DateTime?               @map("processed_at")
  lastErrorCode    String?                 @map("last_error_code")
  lastErrorMessage String?                 @map("last_error_message")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  @@index([status, stripeCreatedAt, createdAt])
  @@index([status, nextAttemptAt, stripeCreatedAt, createdAt])
  @@index([claimExpiresAt])
  @@map("hosted_stripe_event")
}

model HostedRevnetIssuance {
  id                       String                     @id
  memberId                 String                     @map("member_id")
  idempotencyKey           String                     @unique @map("idempotency_key")
  stripeInvoiceId          String                     @unique @map("stripe_invoice_id")
  stripePaymentIntentId    String?                    @map("stripe_payment_intent_id")
  stripeChargeId           String?                    @map("stripe_charge_id")
  chainId                  Int                        @map("chain_id")
  projectId                String                     @map("project_id")
  terminalAddress          String                     @map("terminal_address")
  paymentAssetAddress      String                     @map("payment_asset_address")
  beneficiaryAddress       String                     @map("beneficiary_address")
  stripePaymentAmountMinor Int                        @map("stripe_payment_amount_minor")
  stripePaymentCurrency    String                     @map("stripe_payment_currency")
  paymentAmount            String                     @map("payment_amount")
  status                   HostedRevnetIssuanceStatus @default(pending)
  attemptCount             Int                        @default(0) @map("attempt_count")
  nextAttemptAt            DateTime                   @default(now()) @map("next_attempt_at")
  payTxHash                String?                    @unique @map("pay_tx_hash")
  failureCode              String?                    @map("failure_code")
  failureMessage           String?                    @map("failure_message")
  submittedAt              DateTime?                  @map("submitted_at")
  confirmedAt              DateTime?                  @map("confirmed_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  updatedAt                DateTime                   @updatedAt @map("updated_at")
  member                   HostedMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt, createdAt])
  @@index([stripePaymentIntentId])
  @@index([stripeChargeId])
  @@map("hosted_revnet_issuance")
}

model HostedShareLink {
  id                 String    @id
  codeHash           String    @unique @map("code_hash")
  senderMemberId     String    @map("sender_member_id")
  previewJson        Json      @map("preview_json")
  expiresAt          DateTime  @map("expires_at")
  acceptedAt         DateTime? @map("accepted_at")
  acceptedByMemberId String?   @map("accepted_by_member_id")
  consumedAt         DateTime? @map("consumed_at")
  consumedByMemberId String?   @map("consumed_by_member_id")
  lastEventId        String?   @map("last_event_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  payload            HostedSharePayload?

  @@index([senderMemberId, createdAt])
  @@index([expiresAt])
  @@index([acceptedByMemberId, acceptedAt])
  @@index([consumedByMemberId, consumedAt])
  @@map("hosted_share_link")
}

model HostedSharePayload {
  shareId          String          @unique @map("share_id")
  payloadSchema    String          @default("murph.hosted-share-payload.v1") @map("payload_schema")
  payloadEncrypted String          @map("payload_encrypted")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  share            HostedShareLink @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@map("hosted_share_payload")
}


model HostedVaultSyncSession {
  id                   String    @id
  memberId             String    @map("member_id")
  direction            String    @default("local_to_hosted")
  status               String    @default("pending")
  pairingCodeHash      String?   @unique @map("pairing_code_hash")
  agentTokenHash       String?   @unique @map("agent_token_hash")
  sourceVaultId        String?   @map("source_vault_id")
  sourceVaultTitle     String?   @map("source_vault_title")
  sourceSchemaVersion  String?   @map("source_schema_version")
  localManifestHash    String?   @map("local_manifest_hash")
  queuedIngressEventId String?   @unique @map("queued_ingress_event_id")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  expiresAt            DateTime  @map("expires_at")
  uploadedAt           DateTime? @map("uploaded_at")
  queuedAt             DateTime? @map("queued_at")
  revokedAt            DateTime? @map("revoked_at")
  member               HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  payload              HostedVaultSyncPayload?

  @@index([memberId, createdAt])
  @@index([memberId, status, createdAt])
  @@index([expiresAt])
  @@map("hosted_vault_sync_session")
}

model HostedVaultSyncPayload {
  sessionId        String    @id @map("session_id")
  memberId         String    @map("member_id")
  payloadSchema    String    @default("murph.hosted-vault-sync-payload.v1") @map("payload_schema")
  payloadEncrypted String    @map("payload_encrypted")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  member           HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  session          HostedVaultSyncSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("hosted_vault_sync_payload")
}

model HostedAiUsage {
  id                         String       @id
  memberId                   String       @map("member_id")
  sessionId                  String       @map("session_id")
  turnId                     String       @map("turn_id")
  attemptCount               Int          @map("attempt_count")
  occurredAt                 DateTime     @map("occurred_at")
  provider                   String
  routeId                    String?      @map("route_id")
  requestedModel             String?      @map("requested_model")
  servedModel                String?      @map("served_model")
  providerName               String?      @map("provider_name")
  baseUrl                    String?      @map("base_url")
  apiKeyEnv                  String?      @map("api_key_env")
  credentialSource           String?      @map("credential_source")
  featureKey                 String?      @map("feature_key")
  surface                    String?
  triggerKind                String?      @map("trigger_kind")
  reportingUserId            String?      @map("reporting_user_id")
  gatewayTagsJson            Json?        @map("gateway_tags_json")
  stripeMeterSource          String       @default("murph") @map("stripe_meter_source")
  inputTokens                Int?         @map("input_tokens")
  outputTokens               Int?         @map("output_tokens")
  reasoningTokens            Int?         @map("reasoning_tokens")
  cachedInputTokens          Int?         @map("cached_input_tokens")
  cacheWriteTokens           Int?         @map("cache_write_tokens")
  totalTokens                Int?         @map("total_tokens")
  stripeMeterStatus          String       @default("pending") @map("stripe_meter_status")
  stripeMeterAttemptCount    Int          @default(0) @map("stripe_meter_attempt_count")
  stripeMeterLastAttemptedAt DateTime?    @map("stripe_meter_last_attempted_at")
  stripeMeterNextAttemptAt   DateTime?    @map("stripe_meter_next_attempt_at")
  stripeMeteredAt            DateTime?    @map("stripe_metered_at")
  stripeMeterIdentifier      String?      @map("stripe_meter_identifier")
  stripeMeterError           String?      @map("stripe_meter_error")
  createdAt                  DateTime     @default(now()) @map("created_at")
  updatedAt                  DateTime     @updatedAt @map("updated_at")
  member                     HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([featureKey, createdAt])
  @@index([memberId, occurredAt])
  @@index([reportingUserId, createdAt])
  @@index([stripeMeterStatus, stripeMeterNextAttemptAt, occurredAt], map: "hosted_ai_usage_stripe_meter_due_idx")
  @@index([surface, createdAt])
  @@index([turnId, attemptCount])
  @@map("hosted_ai_usage")
}

model HostedAssistantRuntimeIssue {
  id          String   @id
  occurredAt  DateTime @map("occurred_at")
  expiresAt   DateTime @map("expires_at")
  environment String
  surface     String?
  phase       String
  severity    String
  issueKind   String   @map("issue_kind")
  component   String
  operation   String?
  errorCode   String?  @map("error_code")
  summary     String
  fingerprint String
  detailsJson Json     @map("details_json")
  releaseSha  String?  @map("release_sha")
  runtimeName String?  @map("runtime_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([fingerprint, occurredAt])
  @@index([severity, occurredAt])
  @@index([issueKind, occurredAt])
  @@index([expiresAt])
  @@map("hosted_assistant_runtime_issue")
}

model HostedLinqDailyState {
  memberId             String       @map("member_id")
  dayUtc               DateTime     @map("day_utc")
  inboundCount         Int          @default(0) @map("inbound_count")
  outboundCount        Int          @default(0) @map("outbound_count")
  onboardingLinkSentAt DateTime?    @map("onboarding_link_sent_at")
  quotaReplySentAt     DateTime?    @map("quota_reply_sent_at")
  firstSeenAt          DateTime     @map("first_seen_at")
  lastSeenAt           DateTime     @map("last_seen_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  member               HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@id([memberId, dayUtc])
  @@index([dayUtc])
  @@map("hosted_linq_daily_state")
}

model LinqRecipientBinding {
  id                 String             @id
  userId             String             @map("user_id")
  recipientPhone     String             @map("recipient_phone")
  recipientPhoneMask String?            @map("recipient_phone_mask")
  label              String?
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  events             LinqWebhookEvent[]

  @@unique([recipientPhone])
  @@index([userId, recipientPhone])
  @@index([userId, recipientPhoneMask])
  @@map("linq_recipient_binding")
}

model LinqWebhookEvent {
  id             Int                  @id @default(autoincrement())
  userId         String               @map("user_id")
  bindingId      String               @map("binding_id")
  recipientPhone String               @map("recipient_phone")
  eventId        String               @map("event_id")
  traceId        String?              @map("trace_id")
  eventType      String               @map("event_type")
  chatId         String?              @map("chat_id")
  messageId      String?              @map("message_id")
  occurredAt     DateTime?            @map("occurred_at")
  receivedAt     DateTime             @map("received_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  binding        LinqRecipientBinding @relation(fields: [bindingId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@index([userId, id])
  @@index([bindingId, id])
  @@index([recipientPhone, id])
  @@index([receivedAt])
  @@map("linq_webhook_event")
}
