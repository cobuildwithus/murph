generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DeviceConnection {
  id                         String                   @id
  userId                     String                   @map("user_id")
  provider                   String
  providerAccountBlindIndex  String                   @map("provider_account_blind_index")
  status                     String                   @default("active")
  displayName                String?                  @map("display_name")
  scopesJson                 Json?                    @map("scopes_json")
  metadataJson               Json?                    @map("metadata_json")
  credentialKind             String                   @default("oauth_tokens") @map("credential_kind")
  providerConfigKey          String?                  @map("provider_config_key")
  providerApplicationId      String?                  @map("provider_application_id")
  providerApplicationRevision Int?                    @map("provider_application_revision")
  credentialMetadataJson     Json?                    @map("credential_metadata_json")
  setupPhase                 String?                  @map("setup_phase")
  setupExpiresAt             DateTime?                @map("setup_expires_at")
  externalAccountIdEncrypted String?                  @map("external_account_id_encrypted")
  accessTokenEncrypted       String?                  @map("access_token_encrypted")
  refreshTokenEncrypted      String?                  @map("refresh_token_encrypted")
  accessTokenExpiresAt       DateTime?                @map("access_token_expires_at")
  tokenVersion               Int?                     @map("token_version")
  refreshLeaseOwner          String?                  @map("refresh_lease_owner")
  refreshLeaseExpiresAt      DateTime?                @map("refresh_lease_expires_at")
  refreshLeaseTokenVersion   Int?                     @map("refresh_lease_token_version")
  keyVersion                 String?                  @map("key_version")
  connectedAt                DateTime                 @map("connected_at")
  lastWebhookAt              DateTime?                @map("last_webhook_at")
  lastSyncStartedAt          DateTime?                @map("last_sync_started_at")
  lastSyncCompletedAt        DateTime?                @map("last_sync_completed_at")
  lastSyncErrorAt            DateTime?                @map("last_sync_error_at")
  lastErrorCode              String?                  @map("last_error_code")
  lastErrorMessage           String?                  @map("last_error_message")
  nextReconcileAt            DateTime?                @map("next_reconcile_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  signals                    DeviceSyncSignal[]
  sources                    DeviceConnectionSource[]
  tokenAudits                DeviceTokenAudit[]
  dirtyState                 DeviceSyncDirtyConnection?
  dirtyPayloads              DeviceSyncDirtyPayload[]
  companionCaptureReceipts   DeviceSyncCompanionCaptureReceipt[]
  providerApplication        DeviceProviderApplication? @relation(fields: [providerApplicationId], references: [id], onDelete: Restrict)

  @@unique([provider, providerAccountBlindIndex])
  @@index([providerApplicationId])
  @@index([status, nextReconcileAt, updatedAt, id], map: "device_connection_due_reconcile_sweep_idx")
  @@index([userId, provider])
  @@index([setupPhase, setupExpiresAt])
  @@map("device_connection")
}

model DeviceConnectionSource {
  id                              String           @id
  connectionId                    String           @map("connection_id")
  sourceInstanceKey               String           @map("source_instance_key")
  sourceProviderSlug              String           @map("source_provider_slug")
  displayName                     String?          @map("display_name")
  status                          String           @default("connected")
  resourceAvailabilitySummaryJson Json?            @map("resource_availability_summary_json")
  lastErrorCode                   String?          @map("last_error_code")
  lastErrorMessage                String?          @map("last_error_message")
  firstSeenAt                     DateTime         @map("first_seen_at")
  lastSeenAt                      DateTime         @map("last_seen_at")
  lastDataAt                      DateTime?        @map("last_data_at")
  createdAt                       DateTime         @default(now()) @map("created_at")
  updatedAt                       DateTime         @updatedAt @map("updated_at")
  connection                      DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, sourceInstanceKey])
  @@index([connectionId, lastSeenAt(sort: Desc), sourceProviderSlug, sourceInstanceKey], map: "device_connection_source_list_idx")
  @@index([connectionId, status])
  @@map("device_connection_source")
}

model DeviceTokenAudit {
  id                   Int              @id @default(autoincrement())
  userId               String           @map("user_id")
  connectionId         String           @map("connection_id")
  provider             String
  action               String
  channel              String
  sessionId            String?          @map("session_id")
  tokenVersion         Int              @map("token_version")
  keyVersion           String           @map("key_version")
  expectedTokenVersion Int?             @map("expected_token_version")
  forceRefresh         Boolean?         @map("force_refresh")
  refreshOutcome       String?          @map("refresh_outcome")
  tokenVersionChanged  Boolean?         @map("token_version_changed")
  createdAt            DateTime         @default(now()) @map("created_at")
  connection           DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([connectionId, createdAt])
  @@index([createdAt])
  @@map("device_token_audit")
}

model DeviceOauthSession {
  state                       String    @id
  userId                      String?   @map("user_id")
  provider                    String
  providerApplicationId       String?   @map("provider_application_id")
  providerApplicationRevision Int?      @map("provider_application_revision")
  returnTo                    String?   @map("return_to")
  metadataJson                Json?     @map("metadata_json")
  createdAt                   DateTime  @map("created_at")
  expiresAt                   DateTime  @map("expires_at")
  consumedAt                  DateTime? @map("consumed_at")
  providerApplication         DeviceProviderApplication? @relation(fields: [providerApplicationId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, provider])
  @@index([providerApplicationId])
  @@map("device_oauth_session")
}

model DeviceProviderApplication {
  id                    String    @id
  memberId              String    @map("member_id")
  provider              String
  revision              Int       @default(1)
  configEncrypted       String    @map("config_encrypted")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")
  member                HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  connections           DeviceConnection[]
  oauthSessions         DeviceOauthSession[]

  @@unique([memberId, provider])
  @@map("device_provider_application")
}

model DeviceConnectIntent {
  claimHash            String    @id @map("claim_hash")
  memberId             String    @map("member_id")
  provider             String
  connectSourceId      String    @map("connect_source_id")
  connectTarget        String    @map("connect_target")
  sourceProviderSlug   String?   @map("source_provider_slug")
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime  @map("expires_at")
  startedAt            DateTime? @map("started_at")

  @@index([expiresAt])
  @@index([memberId, expiresAt])
  @@index([startedAt])
  @@map("device_connect_intent")
}

model DeviceWebhookTrace {
  provider                  String
  traceId                   String    @map("trace_id")
  providerAccountBlindIndex String    @map("provider_account_blind_index")
  eventType                 String    @map("event_type")
  claimToken                String?   @map("claim_token")
  status                    String    @default("processed")
  processingExpiresAt       DateTime? @map("processing_expires_at")
  receivedAt                DateTime  @map("received_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  @@id([provider, traceId])
  @@index([provider, providerAccountBlindIndex])
  @@index([receivedAt])
  @@map("device_webhook_trace")
}


model DeviceSyncSignal {
  id                   Int               @id @default(autoincrement())
  userId               String            @map("user_id")
  connectionId         String?           @map("connection_id")
  provider             String
  kind                 String
  occurredAt           DateTime?         @map("occurred_at")
  traceId              String?           @map("trace_id")
  eventType            String?           @map("event_type")
  resourceCategory     String?           @map("resource_category")
  sourceProviderSlug   String?           @map("source_provider_slug")
  reason               String?           @map("reason")
  nextReconcileAt      DateTime?         @map("next_reconcile_at")
  revokeWarningCode    String?           @map("revoke_warning_code")
  revokeWarningMessage String?           @map("revoke_warning_message")
  createdAt            DateTime          @default(now()) @map("created_at")
  connection           DeviceConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([userId, sourceProviderSlug, id], map: "device_sync_signal_user_source_idx")
  @@index([connectionId])
  @@map("device_sync_signal")
}

model DeviceSyncDirtyConnection {
  connectionId               String           @id @map("connection_id")
  userId                     String           @map("user_id")
  provider                   String
  dirtyRevision              BigInt           @default(0) @map("dirty_revision")
  processedRevision          BigInt           @default(0) @map("processed_revision")
  firstDirtyAt               DateTime         @map("first_dirty_at")
  latestDirtyAt              DateTime         @map("latest_dirty_at")
  windowStart                DateTime?        @map("window_start")
  windowEnd                  DateTime?        @map("window_end")
  eventCount                 BigInt           @default(0) @map("event_count")
  latestTraceId              String?          @map("latest_trace_id")
  latestEventType            String?          @map("latest_event_type")
  latestResourceCategory     String?          @map("latest_resource_category")
  sourceProviderCountsJson   Json?            @map("source_provider_counts_json")
  resourceCategoryCountsJson Json?            @map("resource_category_counts_json")
  dirtyResourcesJson         Json?            @map("dirty_resources_json")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  connection                 DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([userId, dirtyRevision, processedRevision])
  @@index([userId, firstDirtyAt, connectionId])
  @@index([latestDirtyAt])
  @@map("device_sync_dirty_connection")
}

model DeviceSyncDirtyPayload {
  id                    String           @id
  connectionId          String           @map("connection_id")
  userId                String           @map("user_id")
  provider              String
  dirtyRevision         BigInt           @map("dirty_revision")
  resourceEncrypted     String           @map("resource_encrypted")
  credentialIndependent Boolean?         @map("credential_independent")
  createdAt             DateTime         @default(now()) @map("created_at")
  connection    DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, dirtyRevision])
  @@index([userId, connectionId, dirtyRevision])
  @@index([createdAt])
  @@map("device_sync_dirty_payload")
}

model DeviceSyncCompanionCaptureReceipt {
  id           String           @id
  connectionId String           @map("connection_id")
  userId       String           @map("user_id")
  envelopeHash String           @map("envelope_hash")
  createdAt    DateTime         @default(now()) @map("created_at")
  connection   DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, connectionId, createdAt])
  @@map("device_sync_companion_capture_receipt")
}

model DeviceAgentSession {
  id                  String    @id
  userId              String    @map("user_id")
  label               String?
  tokenHash           String    @unique @map("token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  expiresAt           DateTime  @map("expires_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  revokedAt           DateTime? @map("revoked_at")
  revokeReason        String?   @map("revoke_reason")
  replacedBySessionId String?   @map("replaced_by_session_id")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([replacedBySessionId])
  @@map("device_agent_session")
}

model DeviceBrowserAssertionNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("device_browser_assertion_nonce")
}

model ClinicalRecordConnectIntent {
  claimHash                String       @id @map("claim_hash")
  memberId                 String       @map("member_id")
  providerDirectoryEntryId String?      @map("provider_directory_entry_id")
  createdAt                DateTime     @default(now()) @map("created_at")
  expiresAt                DateTime     @map("expires_at")
  startedAt                DateTime?    @map("started_at")
  completedAt              DateTime?    @map("completed_at")
  member                   HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([memberId, expiresAt])
  @@index([startedAt])
  @@map("clinical_record_connect_intent")
}

model ClinicalRecordOauthSession {
  stateHash                String       @id @map("state_hash")
  memberId                 String       @map("member_id")
  webSessionId             String       @map("web_session_id")
  connectIntentClaimHash   String       @map("connect_intent_claim_hash")
  providerDirectoryEntryId String       @map("provider_directory_entry_id")
  fhirBaseHash             String       @map("fhir_base_hash")
  tokenEndpoint            String       @map("token_endpoint")
  clientId                 String       @map("client_id")
  redirectUri              String       @map("redirect_uri")
  requestedScopesJson      Json         @map("requested_scopes_json")
  codeVerifierEncrypted    String       @map("code_verifier_encrypted")
  createdAt                DateTime     @default(now()) @map("created_at")
  expiresAt                DateTime     @map("expires_at")
  consumedAt               DateTime?    @map("consumed_at")
  member                   HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([memberId, providerDirectoryEntryId])
  @@index([connectIntentClaimHash])
  @@map("clinical_record_oauth_session")
}

model ClinicalRecordConnection {
  id                       String                           @id
  memberId                 String                           @map("member_id")
  providerDirectoryEntryId String                           @map("provider_directory_entry_id")
  sourceSystem             String                           @map("source_system")
  displayName              String                           @map("display_name")
  fhirBaseUrlEncrypted     String                           @map("fhir_base_url_encrypted")
  fhirBaseHash             String                           @map("fhir_base_hash")
  tokenEndpoint            String                           @map("token_endpoint")
  clientId                 String                           @map("client_id")
  status                   String                           @default("active")
  patientIdEncrypted       String?                          @map("patient_id_encrypted")
  accessTokenEncrypted     String?                          @map("access_token_encrypted")
  refreshTokenEncrypted    String?                          @map("refresh_token_encrypted")
  accessTokenExpiresAt     DateTime?                        @map("access_token_expires_at")
  requestedScopesJson      Json                             @map("requested_scopes_json")
  grantedScopesJson        Json                             @map("granted_scopes_json")
  tokenVersion             Int                              @default(1) @map("token_version")
  retrievalGeneration      Int                              @default(0) @map("retrieval_generation")
  connectedAt              DateTime                         @map("connected_at")
  disconnectedAt           DateTime?                        @map("disconnected_at")
  lastSyncCompletedAt      DateTime?                        @map("last_sync_completed_at")
  lastErrorCode            String?                          @map("last_error_code")
  createdAt                DateTime                         @default(now()) @map("created_at")
  updatedAt                DateTime                         @updatedAt @map("updated_at")
  member                   HostedMember                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  retrievalRuns            ClinicalRecordRetrievalRun[]
  retrievalRequests        ClinicalRecordRetrievalRequest[]

  @@unique([memberId, providerDirectoryEntryId])
  @@index([memberId, status, updatedAt])
  @@index([fhirBaseHash])
  @@map("clinical_record_connection")
}

model ClinicalRecordRetrievalRun {
  id                   String                           @id
  memberId             String                           @map("member_id")
  connectionId         String                           @map("connection_id")
  generation           Int
  status               String                           @default("queued")
  resourceTypesJson    Json                             @map("resource_types_json")
  retrievalPlanJson    Json?                            @map("retrieval_plan_json")
  retrievalProtocol    String?                          @map("retrieval_protocol")
  grantedScopesJson    Json                             @map("granted_scopes_json")
  pageCount            Int                              @default(0) @map("page_count")
  fetchedBytes         Int                              @default(0) @map("fetched_bytes")
  egressBytes          Int                              @default(0) @map("egress_bytes")
  providerRequestCount Int                              @default(0) @map("provider_request_count")
  importedCount        Int                              @default(0) @map("imported_count")
  reviewCount          Int                              @default(0) @map("review_count")
  lastErrorCode        String?                          @map("last_error_code")
  outcomeCountsJson    Json?                            @map("outcome_counts_json")
  createdAt            DateTime                         @default(now()) @map("created_at")
  startedAt            DateTime?                        @map("started_at")
  completedAt          DateTime?                        @map("completed_at")
  connection           ClinicalRecordConnection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  member               HostedMember                     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  requests             ClinicalRecordRetrievalRequest[]

  @@unique([connectionId, generation])
  @@index([memberId, status, createdAt])
  @@index([connectionId, createdAt])
  @@map("clinical_record_retrieval_run")
}

model ClinicalRecordRetrievalRequest {
  id                 String                     @id
  memberId           String                     @map("member_id")
  connectionId       String                     @map("connection_id")
  runId              String                     @map("run_id")
  generation         Int
  requestFingerprint String                     @map("request_fingerprint")
  queryScopeId       String?                    @map("query_scope_id")
  sliceId            String?                    @map("slice_id")
  reservedBytes      Int                        @default(0) @map("reserved_bytes")
  responseBytes      Int?                       @map("response_bytes")
  claimVersion       Int                        @default(1) @map("claim_version")
  claimedAt          DateTime                   @map("claimed_at")
  completedAt        DateTime?                  @map("completed_at")
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @updatedAt @map("updated_at")
  connection         ClinicalRecordConnection   @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  run                ClinicalRecordRetrievalRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  member             HostedMember               @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([runId, requestFingerprint])
  @@index([memberId, createdAt])
  @@index([connectionId, generation])
  @@map("clinical_record_retrieval_request")
}

model HostedWebInternalRequestNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  search    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("hosted_web_internal_request_nonce")
}

enum HostedBillingStatus {
  not_started
  active
  incomplete
  past_due
  canceled
  unpaid
  paused
}

enum HostedStripeEventStatus {
  pending
  processing
  completed
  failed
  poisoned
}

enum HostedUsageCreditPurchaseStatus {
  created
  checkout_open
  payment_pending
  fulfilled
  expired
  payment_failed
}

enum HostedGroupSponsorshipAuthorizationStatus {
  pending_activation
  active
  paused
  recovery_required
  canceled
}

enum HostedUsageCreditEntryKind {
  starter_grant
  purchase_grant
  referral_grant
  usage_debit
  refund_adjustment
  dispute_adjustment
}

enum HostedUsageReferralPolicyCode {
  new_person_activation_v1
  active_group_v1
}

enum HostedUsageReferralStatus {
  armed
  target_bound
  rewarded
  superseded
  canceled
  expired
  disqualified
}

enum HostedCryptoDomain {
  control
  device
  ingress
  runtime

  @@map("hosted_crypto_domain")
}

enum HostedCryptoEnvelopeStatus {
  active
  decrypt_only
  retired
  disabled

  @@map("hosted_crypto_envelope_status")
}

enum HostedComputerRunStatus {
  running
  awaiting_user
  cleanup_pending
  completed
  failed
  expired
  canceled
}

enum HostedComputerAwaitingReason {
  login_needed
  payment_needed
  final_confirmation
  stuck
  other
}

enum HostedComputerHandoffStatus {
  open
  checkpointing
  completed
  expired
}

enum HostedPhoneCallResultNotificationChannel {
  telegram
}

enum HostedPhoneCallResultDeliveryStatus {
  pending
  queued
  sending
  delivered
  failed
  ambiguous
}

enum HostedPhoneCallStatus {
  starting
  calling
  ended
  completed
  needs_user
  failed
}

enum HostedPhysicalNoteStatus {
  starting
  accepted
  failed
}

enum HostedPhysicalNoteFailureReason {
  recipient_address
  artwork
  service_unavailable
  request_invalid
  prior_note_unresolved
  prior_note_accepted
  unknown
}

model HostedMember {
  id                             String                          @id
  billingStatus                  HostedBillingStatus             @default(not_started) @map("billing_status")
  usageCreditBalanceUsdMicros    BigInt?                         @default(0) @map("usage_credit_balance_usd_micros")
  usageCreditLedgerVersion       BigInt?                         @default(0) @map("usage_credit_ledger_version")
  assistantModelPreference       String?                         @map("assistant_model_preference")
  assistantProviderPreference    String?                         @map("assistant_provider_preference")
  assistantReasoningEffortPreference String?                     @map("assistant_reasoning_effort_preference")
  assistantPersona               String?                         @map("assistant_persona")
  assistantPersonaCausalSeq      BigInt?                         @map("assistant_persona_causal_seq")
  assistantTone                  String?                         @map("assistant_tone")
  assistantToneCausalSeq         BigInt?                         @map("assistant_tone_causal_seq")
  assistantVoice                 String?                         @map("assistant_voice")
  assistantVoiceCausalSeq        BigInt?                         @map("assistant_voice_causal_seq")
  assistantHumor                 Int?                            @map("assistant_humor")
  assistantHumorCausalSeq        BigInt?                         @map("assistant_humor_causal_seq")
  assistantPush                  Int?                            @map("assistant_push")
  assistantPushCausalSeq         BigInt?                         @map("assistant_push_causal_seq")
  assistantDetail                Int?                            @map("assistant_detail")
  assistantDetailCausalSeq       BigInt?                         @map("assistant_detail_causal_seq")
  assistantUnhinged              Int?                            @map("assistant_unhinged")
  assistantUnhingedCausalSeq     BigInt?                         @map("assistant_unhinged_causal_seq")
  initialOnboardingCompletedAt   DateTime?                       @default(now()) @map("initial_onboarding_completed_at")
  pendingActivationTimeZone      String?                         @map("pending_activation_time_zone")
  signupNotificationEmailAttemptedAt DateTime?                   @map("signup_notification_email_attempted_at")
  signupWelcomeEmailAttemptedAt  DateTime?                       @map("signup_welcome_email_attempted_at")
  suspendedAt                    DateTime?                       @map("suspended_at")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  invites                        HostedInvite[]                 @relation("HostedInviteMember")
  signupReferralInvites          HostedInvite[]                 @relation("HostedInviteReferrer")
  accountGroupsOwned             HostedAccountGroup[]            @relation("HostedAccountGroupOwner")
  accountGroupMemberships        HostedAccountGroupMembership[]   @relation("HostedAccountGroupMember")
  accountGroupInvitesSent        HostedAccountGroupInvite[]       @relation("HostedAccountGroupInviteSender")
  accountGroupInvitesAccepted    HostedAccountGroupInvite[]       @relation("HostedAccountGroupInviteAcceptor")
  aiUsage                        HostedAiUsage[]
  linqDailyStates                HostedLinqDailyState[]
  linqContactCardShares          HostedLinqContactCardShare[]
  identity                       HostedMemberIdentity?
  routing                        HostedMemberRouting?
  billingRef                     HostedMemberBillingRef?
  subscriptionCheckouts          HostedMemberSubscriptionCheckout[]
  emailAuthorization             HostedMemberEmailAuthorization?
  hostedMailboxItems             HostedMailboxItem[]
  hostedMailboxPayloads          HostedMailboxPayload[]
  hostedMailboxLaneCounters      HostedMailboxLaneCounter[]
  hostedWorkspace                HostedWorkspace?
  hostedAiUsagePeriods           HostedAiUsagePeriod[]
  usageCreditPurchasesPaid       HostedUsageCreditPurchase[]     @relation("HostedUsageCreditPurchasePayer")
  usageCreditPurchasesReceived   HostedUsageCreditPurchase[]     @relation("HostedUsageCreditPurchaseBeneficiary")
  groupSponsorshipsPaid          HostedGroupSponsorshipAuthorization[] @relation("HostedGroupSponsorshipAuthorizationPayer")
  groupSponsorshipsReceived      HostedGroupSponsorshipAuthorization[] @relation("HostedGroupSponsorshipAuthorizationBeneficiary")
  groupSponsorshipMomentsCreated HostedGroupSponsorshipMoment[]  @relation("HostedGroupSponsorshipMomentCreator")
  usageCreditEntries             HostedUsageCreditEntry[]
  usageReferralsAsReferrer       HostedUsageReferral[]            @relation("HostedUsageReferralReferrer")
  usageReferralsAsBeneficiary    HostedUsageReferral[]            @relation("HostedUsageReferralBeneficiary")
  usageReferralsAsIntroduced     HostedUsageReferral[]            @relation("HostedUsageReferralIntroducedMember")
  consentEvents                  HostedConsentEvent[]
  consentGrants                  HostedConsentGrant[]
  vaultSharesGranted             HostedVaultShare[]              @relation("VaultShareGrantor")
