generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DeviceConnection {
  id                         String                   @id
  userId                     String                   @map("user_id")
  provider                   String
  providerAccountBlindIndex  String                   @map("provider_account_blind_index")
  status                     String                   @default("active")
  displayName                String?                  @map("display_name")
  scopesJson                 Json?                    @map("scopes_json")
  metadataJson               Json?                    @map("metadata_json")
  credentialKind             String                   @default("oauth_tokens") @map("credential_kind")
  providerConfigKey          String?                  @map("provider_config_key")
  credentialMetadataJson     Json?                    @map("credential_metadata_json")
  setupPhase                 String?                  @map("setup_phase")
  setupExpiresAt             DateTime?                @map("setup_expires_at")
  externalAccountIdEncrypted String?                  @map("external_account_id_encrypted")
  accessTokenEncrypted       String?                  @map("access_token_encrypted")
  refreshTokenEncrypted      String?                  @map("refresh_token_encrypted")
  accessTokenExpiresAt       DateTime?                @map("access_token_expires_at")
  tokenVersion               Int?                     @map("token_version")
  refreshLeaseOwner          String?                  @map("refresh_lease_owner")
  refreshLeaseExpiresAt      DateTime?                @map("refresh_lease_expires_at")
  refreshLeaseTokenVersion   Int?                     @map("refresh_lease_token_version")
  keyVersion                 String?                  @map("key_version")
  connectedAt                DateTime                 @map("connected_at")
  lastWebhookAt              DateTime?                @map("last_webhook_at")
  lastSyncStartedAt          DateTime?                @map("last_sync_started_at")
  lastSyncCompletedAt        DateTime?                @map("last_sync_completed_at")
  lastSyncErrorAt            DateTime?                @map("last_sync_error_at")
  lastErrorCode              String?                  @map("last_error_code")
  lastErrorMessage           String?                  @map("last_error_message")
  nextReconcileAt            DateTime?                @map("next_reconcile_at")
  createdAt                  DateTime                 @default(now()) @map("created_at")
  updatedAt                  DateTime                 @updatedAt @map("updated_at")
  signals                    DeviceSyncSignal[]
  sources                    DeviceConnectionSource[]
  tokenAudits                DeviceTokenAudit[]
  dirtyState                 DeviceSyncDirtyConnection?
  dirtyPayloads              DeviceSyncDirtyPayload[]

  @@unique([provider, providerAccountBlindIndex])
  @@index([status, nextReconcileAt, updatedAt, id], map: "device_connection_due_reconcile_sweep_idx")
  @@index([userId, provider])
  @@index([setupPhase, setupExpiresAt])
  @@map("device_connection")
}

model DeviceConnectionSource {
  id                              String           @id
  connectionId                    String           @map("connection_id")
  sourceInstanceKey               String           @map("source_instance_key")
  sourceProviderSlug              String           @map("source_provider_slug")
  displayName                     String?          @map("display_name")
  status                          String           @default("connected")
  resourceAvailabilitySummaryJson Json?            @map("resource_availability_summary_json")
  lastErrorCode                   String?          @map("last_error_code")
  lastErrorMessage                String?          @map("last_error_message")
  firstSeenAt                     DateTime         @map("first_seen_at")
  lastSeenAt                      DateTime         @map("last_seen_at")
  createdAt                       DateTime         @default(now()) @map("created_at")
  updatedAt                       DateTime         @updatedAt @map("updated_at")
  connection                      DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, sourceInstanceKey])
  @@index([connectionId, lastSeenAt(sort: Desc), sourceProviderSlug, sourceInstanceKey], map: "device_connection_source_list_idx")
  @@index([connectionId, status])
  @@map("device_connection_source")
}

model DeviceTokenAudit {
  id                   Int              @id @default(autoincrement())
  userId               String           @map("user_id")
  connectionId         String           @map("connection_id")
  provider             String
  action               String
  channel              String
  sessionId            String?          @map("session_id")
  tokenVersion         Int              @map("token_version")
  keyVersion           String           @map("key_version")
  expectedTokenVersion Int?             @map("expected_token_version")
  forceRefresh         Boolean?         @map("force_refresh")
  refreshOutcome       String?          @map("refresh_outcome")
  tokenVersionChanged  Boolean?         @map("token_version_changed")
  createdAt            DateTime         @default(now()) @map("created_at")
  connection           DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([connectionId, createdAt])
  @@index([createdAt])
  @@map("device_token_audit")
}

model DeviceOauthSession {
  state        String   @id
  userId       String?  @map("user_id")
  provider     String
  returnTo     String?  @map("return_to")
  metadataJson Json?    @map("metadata_json")
  createdAt    DateTime @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@index([userId, provider])
  @@map("device_oauth_session")
}

model DeviceConnectIntent {
  claimHash            String    @id @map("claim_hash")
  memberId             String    @map("member_id")
  provider             String
  connectSourceId      String    @map("connect_source_id")
  connectTarget        String    @map("connect_target")
  sourceProviderSlug   String?   @map("source_provider_slug")
  createdAt            DateTime  @default(now()) @map("created_at")
  expiresAt            DateTime  @map("expires_at")
  startedAt            DateTime? @map("started_at")

  @@index([expiresAt])
  @@index([memberId, expiresAt])
  @@index([startedAt])
  @@map("device_connect_intent")
}

model DeviceWebhookTrace {
  provider                  String
  traceId                   String    @map("trace_id")
  providerAccountBlindIndex String    @map("provider_account_blind_index")
  eventType                 String    @map("event_type")
  claimToken                String?   @map("claim_token")
  status                    String    @default("processed")
  processingExpiresAt       DateTime? @map("processing_expires_at")
  receivedAt                DateTime  @map("received_at")
  createdAt                 DateTime  @default(now()) @map("created_at")

  @@id([provider, traceId])
  @@index([provider, providerAccountBlindIndex])
  @@index([receivedAt])
  @@map("device_webhook_trace")
}

model DeviceSyncSignal {
  id                   Int               @id @default(autoincrement())
  userId               String            @map("user_id")
  connectionId         String?           @map("connection_id")
  provider             String
  kind                 String
  occurredAt           DateTime?         @map("occurred_at")
  traceId              String?           @map("trace_id")
  eventType            String?           @map("event_type")
  resourceCategory     String?           @map("resource_category")
  reason               String?           @map("reason")
  nextReconcileAt      DateTime?         @map("next_reconcile_at")
  revokeWarningCode    String?           @map("revoke_warning_code")
  revokeWarningMessage String?           @map("revoke_warning_message")
  createdAt            DateTime          @default(now()) @map("created_at")
  connection           DeviceConnection? @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@index([connectionId])
  @@map("device_sync_signal")
}

model DeviceSyncDirtyConnection {
  connectionId               String           @id @map("connection_id")
  userId                     String           @map("user_id")
  provider                   String
  dirtyRevision              BigInt           @default(0) @map("dirty_revision")
  processedRevision          BigInt           @default(0) @map("processed_revision")
  firstDirtyAt               DateTime         @map("first_dirty_at")
  latestDirtyAt              DateTime         @map("latest_dirty_at")
  windowStart                DateTime?        @map("window_start")
  windowEnd                  DateTime?        @map("window_end")
  eventCount                 BigInt           @default(0) @map("event_count")
  latestTraceId              String?          @map("latest_trace_id")
  latestEventType            String?          @map("latest_event_type")
  latestResourceCategory     String?          @map("latest_resource_category")
  sourceProviderCountsJson   Json?            @map("source_provider_counts_json")
  resourceCategoryCountsJson Json?            @map("resource_category_counts_json")
  dirtyResourcesJson         Json?            @map("dirty_resources_json")
  createdAt                  DateTime         @default(now()) @map("created_at")
  updatedAt                  DateTime         @updatedAt @map("updated_at")
  connection                 DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([userId, provider])
  @@index([userId, dirtyRevision, processedRevision])
  @@index([userId, firstDirtyAt, connectionId])
  @@index([latestDirtyAt])
  @@map("device_sync_dirty_connection")
}

model DeviceSyncDirtyPayload {
  id            String           @id
  connectionId  String           @map("connection_id")
  userId        String           @map("user_id")
  provider      String
  dirtyRevision BigInt           @map("dirty_revision")
  resourceEncrypted String       @map("resource_encrypted")
  createdAt     DateTime         @default(now()) @map("created_at")
  connection    DeviceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, dirtyRevision])
  @@index([userId, connectionId, dirtyRevision])
  @@index([createdAt])
  @@map("device_sync_dirty_payload")
}

model DeviceAgentSession {
  id                  String    @id
  userId              String    @map("user_id")
  label               String?
  tokenHash           String    @unique @map("token_hash")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  expiresAt           DateTime  @map("expires_at")
  lastSeenAt          DateTime? @map("last_seen_at")
  revokedAt           DateTime? @map("revoked_at")
  revokeReason        String?   @map("revoke_reason")
  replacedBySessionId String?   @map("replaced_by_session_id")

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([replacedBySessionId])
  @@map("device_agent_session")
}

model DeviceBrowserAssertionNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("device_browser_assertion_nonce")
}

model HostedWebInternalRequestNonce {
  nonceHash String   @id @map("nonce_hash")
  userId    String   @map("user_id")
  method    String
  path      String
  search    String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("hosted_web_internal_request_nonce")
}

enum HostedBillingStatus {
  not_started
  active
  incomplete
  past_due
  canceled
  unpaid
  paused
}

enum HostedStripeEventStatus {
  pending
  processing
  completed
  failed
  poisoned
}

enum HostedCryptoDomain {
  control
  device
  ingress
  runtime

  @@map("hosted_crypto_domain")
}

enum HostedCryptoEnvelopeStatus {
  active
  decrypt_only
  retired
  disabled

  @@map("hosted_crypto_envelope_status")
}

enum HostedComputerRunStatus {
  running
  awaiting_user
  cleanup_pending
  completed
  failed
  expired
  canceled
}

enum HostedComputerAwaitingReason {
  login_needed
  payment_needed
  final_confirmation
  stuck
  other
}

enum HostedComputerHandoffStatus {
  open
  checkpointing
  completed
  expired
}

model HostedMember {
  id                             String                          @id
  billingStatus                  HostedBillingStatus             @default(not_started) @map("billing_status")
  pendingActivationTimeZone      String?                         @map("pending_activation_time_zone")
  signupNotificationEmailAttemptedAt DateTime?                   @map("signup_notification_email_attempted_at")
  signupWelcomeEmailAttemptedAt  DateTime?                       @map("signup_welcome_email_attempted_at")
  suspendedAt                    DateTime?                       @map("suspended_at")
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  invites                        HostedInvite[]
  aiUsage                        HostedAiUsage[]
  linqDailyStates                HostedLinqDailyState[]
  identity                       HostedMemberIdentity?
  routing                        HostedMemberRouting?
  billingRef                     HostedMemberBillingRef?
  emailAuthorization             HostedMemberEmailAuthorization?
  hostedMailboxItems             HostedMailboxItem[]
  hostedMailboxPayloads          HostedMailboxPayload[]
  hostedMailboxLaneCounters      HostedMailboxLaneCounter[]
  hostedWorkspace                HostedWorkspace?
  hostedRuntimeLogs              HostedRuntimeLog[]
  hostedAiUsagePeriods           HostedAiUsagePeriod[]
  consentEvents                  HostedConsentEvent[]
  consentGrants                  HostedConsentGrant[]
  vaultSharesGranted             HostedVaultShare[]              @relation("VaultShareGrantor")
  vaultSharesReceived            HostedVaultShare[]              @relation("VaultShareDestination")
  hostedCryptoEnvelopes          HostedUserCryptoEnvelope[]
  hostedCryptoAudits             HostedUserCryptoAudit[]
  webSessions                    HostedWebSession[]
  connectedAppsSession           HostedConnectedAppsSession?
  connectedAppConnectIntents     HostedConnectedAppConnectIntent[]
  codexAuthConnection            HostedCodexAuthConnection?
  computerRuns                   HostedComputerRun[]
  computerHandoffs               HostedComputerHandoff[]
  productFeedback                HostedProductFeedback[]
  sensitiveActionChallenges      HostedSensitiveActionChallenge[]
  threadContainer                HostedThreadContainer?

  @@index([billingStatus])
  @@map("hosted_member")
}

model HostedCodexAuthConnection {
  memberId        String       @id @map("member_id")
  state           String
  attemptId       String       @map("attempt_id")
  verificationUrl String?      @map("verification_url")
  userCode        String?      @map("user_code")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  member          HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_codex_auth_connection")
}

model HostedProductFeedback {
  id                          String       @id
  memberId                    String       @map("member_id")
  kind                        String
  relatedChangelogItemIdsJson Json         @map("related_changelog_item_ids_json")
  summary                     String?
  createdAt                   DateTime     @default(now()) @map("created_at")
  member                      HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@map("hosted_product_feedback")
}

model HostedWebSession {
  id           String       @id
  tokenHash    String       @unique @map("token_hash")
  memberId     String       @map("member_id")
  privyUserId  String       @map("privy_user_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  expiresAt    DateTime     @map("expires_at")
  lastSeenAt   DateTime?    @map("last_seen_at")
  revokedAt    DateTime?    @map("revoked_at")
  revokeReason String?      @map("revoke_reason")
  member       HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([memberId, privyUserId, createdAt, id])
  @@index([privyUserId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("hosted_web_session")
}

model HostedSensitiveActionChallenge {
  tokenHash          String                                @id @map("token_hash")
  memberId           String                                @map("member_id")
  kind               String
  bindingHash        String                                @map("binding_hash")
  createdAt          DateTime                              @default(now()) @map("created_at")
  expiresAt          DateTime                              @map("expires_at")
  approvalKey        String?                               @unique @map("approval_key")
  actionId           String?                               @map("action_id")
  actionHash         String?                               @map("action_hash")
  presentationTitle  String?                               @map("presentation_title")
  presentationBody   String?                               @map("presentation_body")
  approvalStatus     HostedSensitiveActionApprovalStatus?  @map("approval_status")
  decidedAt          DateTime?                             @map("decided_at")
  returnContactKind  String?                               @map("return_contact_kind")
  member             HostedMember                          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, expiresAt])
  @@index([expiresAt])
  @@index([memberId, approvalStatus, expiresAt], map: "hosted_sensitive_action_approval_member_status_due_idx")
  @@map("hosted_sensitive_action_challenge")
}

enum HostedSensitiveActionApprovalStatus {
  pending
  approved
  denied
}

model HostedConnectedAppsSession {
  memberId        String       @id @map("member_id")
  remoteSessionId String       @unique @map("remote_session_id")
  policyRevision  Int          @map("policy_revision")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  member          HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_connected_apps_session")
}

model HostedConnectedAppConnectIntent {
  claimHash          String       @id @map("claim_hash")
  memberId           String       @map("member_id")
  toolkit            String
  alias              String?
  connectedAccountId String?      @map("connected_account_id")
  createdAt          DateTime     @default(now()) @map("created_at")
  expiresAt          DateTime     @map("expires_at")
  startedAt          DateTime?    @map("started_at")
  completedAt        DateTime?    @map("completed_at")
  member             HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([memberId, expiresAt])
  @@index([startedAt])
  @@index([completedAt])
  @@map("hosted_connected_app_connect_intent")
}

model HostedComputerRun {
  id                         String                         @id
  memberId                   String                         @map("member_id")
  kernelProfileName          String                         @map("kernel_profile_name")
  status                     HostedComputerRunStatus        @default(running)
  kernelSessionId            String?                        @map("kernel_session_id")
  kernelLiveViewUrlEncrypted String?                        @map("kernel_live_view_url_encrypted")
  lastUrl                    String?                        @map("last_url")
  lastTitle                  String?                        @map("last_title")
  awaitingReason             HostedComputerAwaitingReason?  @map("awaiting_reason")
  awaitingMessage            String?                        @map("awaiting_message")
  suggestedReply             String?                        @map("suggested_reply")
  pausedAt                   DateTime?                      @map("paused_at")
  pendingHandoffId           String?                        @map("pending_handoff_id")
  metadataJson               Json?                          @map("metadata_json")
  expiresAt                  DateTime                       @map("expires_at")
  createdAt                  DateTime                       @default(now()) @map("created_at")
  updatedAt                  DateTime                       @updatedAt @map("updated_at")
  completedAt                DateTime?                      @map("completed_at")
  member                     HostedMember                   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  handoffs                   HostedComputerHandoff[]

  @@index([memberId, status, updatedAt])
  @@index([memberId, awaitingReason, updatedAt])
  @@index([status, expiresAt])
  @@map("hosted_computer_run")
}

model HostedComputerHandoff {
  id             String                       @id
  runId          String                       @map("run_id")
  memberId       String                       @map("member_id")
  tokenHash      String                       @unique @map("token_hash")
  purpose        String
  status         HostedComputerHandoffStatus  @default(open)
  suggestedReply String?                      @map("suggested_reply")
  createdAt      DateTime                     @default(now()) @map("created_at")
  expiresAt      DateTime                     @map("expires_at")
  completedAt    DateTime?                    @map("completed_at")
  updatedAt      DateTime                     @updatedAt @map("updated_at")
  member         HostedMember                 @relation(fields: [memberId], references: [id], onDelete: Cascade)
  run            HostedComputerRun            @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([memberId, status, expiresAt])
  @@index([runId, status])
  @@index([expiresAt])
  @@map("hosted_computer_handoff")
}

model HostedMemberIdentity {
  memberId                            String       @unique @map("member_id")
  maskedPhoneNumberHint               String?      @map("masked_phone_number_hint")
  phoneLookupKey                      String?      @unique @map("phone_lookup_key")
  phoneNumberEncrypted                String?      @map("phone_number_encrypted")
  phoneNumberVerifiedAt               DateTime?    @map("phone_number_verified_at")
  privyUserLookupKey                  String?      @unique @map("privy_user_lookup_key")
  privyUserIdEncrypted                String?      @map("privy_user_id_encrypted")
  walletAddressLookupKey              String?      @unique @map("wallet_address_lookup_key")
  walletAddressEncrypted              String?      @map("wallet_address_encrypted")
  walletChainType                     String?      @map("wallet_chain_type")
  walletProvider                      String?      @map("wallet_provider")
  walletCreatedAt                     DateTime?    @map("wallet_created_at")
  signupPhoneNumberEncrypted          String?      @map("signup_phone_number_encrypted")
  signupPhoneCodeSentAt               DateTime?    @map("signup_phone_code_sent_at")
  signupPhoneCodeSendAttemptId        String?      @map("signup_phone_code_send_attempt_id")
  signupPhoneCodeSendAttemptStartedAt DateTime?    @map("signup_phone_code_send_attempt_started_at")
  createdAt                           DateTime     @default(now()) @map("created_at")
  updatedAt                           DateTime     @updatedAt @map("updated_at")
  member                              HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_member_identity")
}

model HostedMemberRouting {
  memberId                           String       @unique @map("member_id")
  /// Sticky post-activation Linq home thread for the member's long-lived Murph number.
  linqChatLookupKey                  String?      @unique @map("linq_chat_lookup_key")
  linqChatIdEncrypted                String?      @map("linq_chat_id_encrypted")
  linqRecipientPhoneLookupKey        String?      @map("linq_recipient_phone_lookup_key")
  linqRecipientPhoneEncrypted        String?      @map("linq_recipient_phone_encrypted")
  /// Pre-activation Linq acquisition/referral thread before a home line is chosen.
  pendingLinqChatLookupKey           String?      @unique @map("pending_linq_chat_lookup_key")
  pendingLinqChatIdEncrypted         String?      @map("pending_linq_chat_id_encrypted")
  pendingLinqRecipientPhoneLookupKey String?      @map("pending_linq_recipient_phone_lookup_key")
  pendingLinqRecipientPhoneEncrypted String?      @map("pending_linq_recipient_phone_encrypted")
  pendingLinqParticipantContactKind       String?   @map("pending_linq_participant_contact_kind")
  pendingLinqParticipantContactLookupKey  String?   @unique @map("pending_linq_participant_contact_lookup_key")
  pendingLinqParticipantContactEncrypted  String?   @map("pending_linq_participant_contact_encrypted")
  pendingLinqParticipantContactObservedAt DateTime? @map("pending_linq_participant_contact_observed_at")
  replyAliasLookupKey                String?      @unique @map("reply_alias_lookup_key")
  telegramUserLookupKey              String?      @unique @map("telegram_user_lookup_key")
  telegramUserIdEncrypted            String?      @map("telegram_user_id_encrypted")
  createdAt                          DateTime     @default(now()) @map("created_at")
  updatedAt                          DateTime     @updatedAt @map("updated_at")
  member                             HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([linqRecipientPhoneLookupKey])
  @@index([pendingLinqRecipientPhoneLookupKey])
  @@map("hosted_member_routing")
}

model HostedMemberBillingRef {
  memberId                      String       @unique @map("member_id")
  stripeCustomerLookupKey       String?      @unique @map("stripe_customer_lookup_key")
  stripeCustomerIdEncrypted     String?      @map("stripe_customer_id_encrypted")
  stripeSubscriptionLookupKey   String?      @unique @map("stripe_subscription_lookup_key")
  stripeSubscriptionIdEncrypted String?      @map("stripe_subscription_id_encrypted")
  stripeSubscriptionScheduleLookupKey   String?      @unique @map("stripe_subscription_schedule_lookup_key")
  stripeSubscriptionScheduleIdEncrypted String?      @map("stripe_subscription_schedule_id_encrypted")
  currentBillingPlanCode        String?      @map("current_billing_plan_code")
  currentBillingPhase           String?      @map("current_billing_phase")
  currentCheckoutOffer          String?      @map("current_checkout_offer")
  scheduledBillingPlanCode      String?      @map("scheduled_billing_plan_code")
  scheduledBillingEffectiveAt   DateTime?    @map("scheduled_billing_effective_at")
  pulseTrialRedeemedAt          DateTime?    @map("pulse_trial_redeemed_at")
  pulseTrialPolicyVersion       String?      @map("pulse_trial_policy_version")
  currentPeriodStart            DateTime?    @map("current_period_start")
  currentPeriodEnd              DateTime?    @map("current_period_end")
  currentTrialStartedAt         DateTime?    @map("current_trial_started_at")
  currentTrialEndsAt            DateTime?    @map("current_trial_ends_at")
  lastStripeEventCreatedAt      DateTime?    @map("last_stripe_event_created_at")
  createdAt                     DateTime     @default(now()) @map("created_at")
  updatedAt                     DateTime     @updatedAt @map("updated_at")
  member                        HostedMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("hosted_member_billing_ref")
}

model HostedMemberEmailAuthorization {
  memberId                            String       @unique @map("member_id")
  verifiedEmailLookupKey              String?      @unique @map("verified_email_lookup_key")
  verifiedEmailAddressEncrypted       String?      @map("verified_email_address_encrypted")
  verifiedEmailVerifiedAt             DateTime?    @map("verified_email_verified_at")
  directPublicSenderLookupKey         String?      @unique @map("direct_public_sender_lookup_key")
