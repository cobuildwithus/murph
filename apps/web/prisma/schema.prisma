  // Null means the row predates split capture, never zero.
  individualMrrUsdCents Int? @map("individual_mrr_usd_cents")
  familyMrrUsdCents     Int? @map("family_mrr_usd_cents")

  @@map("hosted_growth_daily_snapshot")
}

