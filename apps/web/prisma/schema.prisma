  gatewayTagsJson            Json?        @map("gateway_tags_json")
  stripeMeterSource          String       @default("murph") @map("stripe_meter_source")
  inputTokens                Int?         @map("input_tokens")
  outputTokens               Int?         @map("output_tokens")
  reasoningTokens            Int?         @map("reasoning_tokens")
  cachedInputTokens          Int?         @map("cached_input_tokens")
  cacheWriteTokens           Int?         @map("cache_write_tokens")
  totalTokens                Int?         @map("total_tokens")
  providerRequestOutcome     String       @default("succeeded") @map("provider_request_outcome")
  allowanceAccountedAt       DateTime?    @map("allowance_accounted_at")
