# Copy this file to an untracked local `.env.local` or `.env` for development, or load the values from your deploy secret manager.
# Keep every value below as a placeholder until you replace it with live credentials; never commit a real hosted `.env.local` or `.env`.
# If a live hosted `.env.local`, `.env`, or deploy secret is exposed, rotate the database credential,
# provider client secrets, webhook verification token, hosted crypto roots, and index HMAC keys.
# Device-sync credential ciphertexts use hosted device secure-box roots; the routing index key only HMACs provider-account lookup identifiers.
# Use a stable project or custom domain for DEVICE_SYNC_PUBLIC_BASE_URL, not a preview deployment URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/murph_device_sync"
# Direct, non-pooled Postgres endpoint for `pnpm --dir apps/web prisma:migrate:deploy`.
# In production this is required and must not point at pooler ports such as 6432 or 6543.
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/murph_device_sync"
# Shared read-only product labels database used by /api/foods and /api/supplements.
MURPH_LABELS_DB_URL="postgresql://postgres:postgres@localhost:5432/murph_labels"
# Shared server-to-server data API key for hosted web data routes such as /api/foods and /api/supplements.
MURPH_DATA_API_KEY="replace-with-random-data-api-key"
# Hosted connected apps. Keep these in web/server secret storage only.
COMPOSIO_API_KEY="replace-me"
# COMPOSIO_BASE_URL="https://backend.composio.dev"
# COMPOSIO_CONNECTED_APP_TOOLKITS="gmail,googlecalendar,outlook,zoho_mail,googledrive,one_drive,dropbox,googletasks,todoist,notion"
OPENWEATHER_API_KEY="replace-me"
HOSTED_DEVICE_ROUTING_INDEX_KEY="replace-with-separate-32-byte-base64url-hmac-key"
DEVICE_SYNC_PUBLIC_BASE_URL="https://your-project.vercel.app/api/device-sync"
DEVICE_SYNC_ALLOWED_MUTATION_ORIGINS="https://your-project.vercel.app,http://localhost:3000"
DEVICE_SYNC_ALLOWED_RETURN_ORIGINS="https://your-project.vercel.app,http://localhost:3000"
DEVICE_SYNC_TRUSTED_USER_ASSERTION_HEADER="x-hosted-user-assertion"
DEVICE_SYNC_TRUSTED_USER_SIGNATURE_HEADER="x-hosted-user-signature"
DEVICE_SYNC_TRUSTED_USER_SIGNING_SECRET="replace-with-shared-signing-secret"
# Trusted auth middleware/proxy must mint a fresh signed assertion per request.
# Assertions should be short-lived (<= 5 minutes), bound to audience/method/path/origin,
# and carry a strong random nonce because the hosted control plane consumes each nonce once.
JUNCTION_API_KEY="replace-me"
JUNCTION_CLIENT_USER_ID_SECRET="replace-me"
JUNCTION_ENV="sandbox"
JUNCTION_REGION="us"
# Optional. Leave empty to use the shared hosted connect-source default list.
JUNCTION_PROVIDER_FILTER=""
WHOOP_CLIENT_ID="replace-me"
WHOOP_CLIENT_SECRET="replace-me"
OURA_CLIENT_ID="replace-me"
OURA_CLIENT_SECRET="replace-me"
OURA_WEBHOOK_VERIFICATION_TOKEN="replace-me"
STRAVA_CLIENT_ID="replace-me"
STRAVA_CLIENT_SECRET="replace-me"
# Optional Strava provider overrides.
# STRAVA_AUTH_BASE_URL="https://www.strava.com"
# STRAVA_API_BASE_URL="https://www.strava.com/api/v3"
# STRAVA_SCOPES="activity:read"
# STRAVA_BACKFILL_DAYS="30"
# STRAVA_RECONCILE_DAYS="7"
# STRAVA_RECONCILE_INTERVAL_MS="21600000"
# STRAVA_REQUEST_TIMEOUT_MS="15000"
# Optional but required to auto-register and validate Strava webhooks.
STRAVA_WEBHOOK_VERIFY_TOKEN="replace-me"

LINQ_WEBHOOK_SECRET="replace-me"

# Hosted WhatsApp Cloud API ingress.
WHATSAPP_VERIFY_TOKEN="replace-me"
WHATSAPP_APP_SECRET="replace-me"
# Required once WhatsApp outbound delivery is enabled.
# WHATSAPP_ACCESS_TOKEN="replace-me"
# WHATSAPP_PHONE_NUMBER_ID="replace-me"
# WHATSAPP_WABA_ID="replace-me"
# WHATSAPP_GRAPH_VERSION="v25.0"

# Hosted onboarding / Privy phone auth / billing / Linq SMS handoff
HOSTED_ONBOARDING_PUBLIC_BASE_URL="https://your-app.vercel.app"
# Local development only. Add the local Caddy TLS proxy origin too if you use it (see ./Caddyfile + README).
# HOSTED_ONBOARDING_ALLOWED_MUTATION_ORIGINS="http://localhost:3000,https://local.withmurph.ai:3443"
HOSTED_CONTACT_PRIVACY_KEYS="v1:replace-with-separate-32-byte-base64url-key"
# HOSTED_CONTACT_PRIVACY_CURRENT_KEY_VERSION="v1" # required when HOSTED_CONTACT_PRIVACY_KEYS includes multiple versions
HOSTED_MAILBOX_FINGERPRINT_KEY="replace-with-separate-32-byte-base64url-key"
HOSTED_ONBOARDING_SIGNUP_PHONE_NUMBER="+1 555 010 1234"
# Optional transactional welcome email after hosted signup activation.
# Configure these in production with a Resend-verified sender domain.
RESEND_API_KEY="re_replace_me"
HOSTED_SIGNUP_WELCOME_EMAIL_FROM="Murph <welcome@example.com>"
HOSTED_SIGNUP_WELCOME_EMAIL_FOUNDER_NAME="Murph founder"
# Optional comma-separated internal recipients for signup notifications.
# HOSTED_SIGNUP_NOTIFICATION_EMAILS="founder@example.com,cofounder@example.com"
# HOSTED_SIGNUP_WELCOME_EMAIL_TIMEOUT_MS="10000"
# Optional Linq operational alerts for delivery failures and phone-line status changes.
# Uses RESEND_API_KEY plus this dedicated sender/recipient config.
# HOSTED_LINQ_ALERT_EMAIL_FROM="Murph Alerts <alerts@example.com>"
# HOSTED_LINQ_ALERT_EMAILS="founder@example.com,ops@example.com"
NEXT_PUBLIC_PRIVY_APP_ID="cm_app_replace_me"
NEXT_PUBLIC_PRIVY_CLIENT_ID="client_replace_me"
PRIVY_APP_SECRET="app_secret_replace_me"
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
# In the Privy dashboard:
# - restrict allowed domains to your real hosted origins and remove stale test/dev domains
# - enable email login/linking so /settings can verify user email addresses
# - enable identity tokens at User management > Authentication > Advanced
# - enable access + identity tokens for the hosted web client so browser requests can authenticate with bearer + identity-token headers
# - keep Privy app-client session duration aligned with your desired risk window
# - if you use separate localhost and production web app clients, set NEXT_PUBLIC_PRIVY_CLIENT_ID per environment
# Optional: if you set a Privy base domain for other web clients, also set PRIVY_BASE_DOMAIN so apps/web CSP can allow the
# domain-specific Privy instance (for example: example.com -> https://privy.example.com).
PRIVY_BASE_DOMAIN="example.com"
HOSTED_ONBOARDING_INVITE_TTL_HOURS="168"
# Hosted onboarding checkout is subscription-only.
# Hosted AI usage is recorded for allowance and audit. Stripe usage metering is not active.
HOSTED_AI_USAGE_REPORTING_SECRET="replace-me-with-random-usage-reporting-secret"
# Optional rollout gates. No-card Pulse Trial signup is enabled by default; set
# HOSTED_AUTO_PULSE_TRIAL_ENABLED="0" to force card checkout fallback.
HOSTED_AUTO_PULSE_TRIAL_ENABLED="1"
# Card-based Pulse Trial checkout fallback stays disabled unless explicitly enabled.
HOSTED_PULSE_TRIAL_CHECKOUT_ENABLED="0"
# For root `pnpm dev`, prefer putting local-only test checkout values in
# `.tmp/.env.hosted-local-stripe` so they override Vercel Development env
# without being committed.
HOSTED_ONBOARDING_STRIPE_PRICE_ID_LAUNCH_MONTHLY="price_replace_me"
HOSTED_ONBOARDING_STRIPE_PRICE_ID_LAUNCH_EDGE_MONTHLY="price_replace_me"
STRIPE_SECRET_KEY="sk_test_replace_me"
# STRIPE_WEBHOOK_SECRET is auto-populated by `pnpm dev` from the local `stripe listen` CLI
# login when the Stripe CLI is installed. Shell overrides and repo-root .env values are
# preserved; a stale value pulled from Vercel Development env is discarded in favor of the
# listener's live secret. Set MURPH_DEV_SKIP_STRIPE_LISTEN=1 to opt out of the auto-listener.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
LINQ_API_TOKEN="replace-me"
LINQ_API_BASE_URL="https://api.linqapp.com/api/partner/v3"
# Optional shared Linq conversation pool used after activation.
# Leave blank to keep members on the inbound Linq thread when activation already started on a Linq number.
# Configure at least one value here before enabling a non-Linq acquisition path such as a shared Twilio activation number.
HOSTED_ONBOARDING_LINQ_CONVERSATION_PHONE_NUMBERS="+15550100001,+15550100002"
# Local-only guard for `pnpm dev` / hosted-local runs that share a real Linq webhook.
HOSTED_ONBOARDING_LINQ_LOCAL_ALLOWED_INBOUND_PHONE_NUMBERS="+15550109999"
# Optional soft cap for new home-line assignments. Once a line reaches this many active members, activation chooses another line in the pool.
HOSTED_ONBOARDING_LINQ_MAX_ACTIVE_MEMBERS_PER_PHONE_NUMBER="1000"
# Optional first-contact admission gate for unknown Linq/iMessage inbound join links.
# Keep off by default. When enforced, unknown first contacts are classified before Murph sends an invite link.
HOSTED_ONBOARDING_LINQ_FIRST_CONTACT_ADMISSION_MODE="off"
HOSTED_ONBOARDING_LINQ_FIRST_CONTACT_ADMISSION_MODEL="gpt-5.4-nano"
# Optional override; falls back to OPENAI_API_KEY when unset.
# HOSTED_ONBOARDING_LINQ_FIRST_CONTACT_ADMISSION_OPENAI_API_KEY="replace-me"
# Hosted web -> Cloudflare control uses Vercel OIDC in production; no shared web-to-worker secret is required.
HOSTED_EXECUTION_CONTROL_URL="https://your-cloudflare-worker.example.com"
HOSTED_EXECUTION_CONTROL_TIMEOUT_MS="30000"
# Hosted web -> Temporal Cloud signal client.
# Required for hosted web to signal the per-user runtime workflow after mailbox,
# browser-vault, manual, billing, and device-sync demand commits.
HOSTED_TEMPORAL_ADDRESS="your-namespace.your-account.tmprl.cloud:7233"
HOSTED_TEMPORAL_NAMESPACE="your-namespace.your-account"
HOSTED_TEMPORAL_TASK_QUEUE="murph-hosted-runtime"
HOSTED_TEMPORAL_TLS_ENABLED="true"
HOSTED_TEMPORAL_API_KEY="replace-me"
# Optional Temporal mTLS/custom CA material. Prefer provider-managed secret
# storage for multiline PEMs; use the BASE64 variants when the target platform
# cannot preserve newlines.
# HOSTED_TEMPORAL_CLIENT_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----\n"
# HOSTED_TEMPORAL_CLIENT_CERT_BASE64="replace-me-base64-pem"
# HOSTED_TEMPORAL_CLIENT_KEY_PEM="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"
# HOSTED_TEMPORAL_CLIENT_KEY_BASE64="replace-me-base64-pem"
# HOSTED_TEMPORAL_SERVER_ROOT_CA_CERT_PEM="-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----\n"
# HOSTED_TEMPORAL_SERVER_ROOT_CA_CERT_BASE64="replace-me-base64-pem"
# HOSTED_TEMPORAL_TLS_SERVER_NAME_OVERRIDE="temporal.example.com"
# Hosted managed crypto. Production should use Vercel OIDC / GCP Workload
# Identity Federation. Bind only the Vercel production project/environment
# principal to the hosted crypto service account with roles/iam.workloadIdentityUser,
# then grant that service account key-level Cloud KMS access only:
# - roles/cloudkms.cryptoKeyEncrypterDecrypter on HOSTED_CRYPTO_GCP_WEB_WRAP_KEY_NAME
# - roles/cloudkms.signer on the key containing HOSTED_CRYPTO_GCP_AUTHORITY_SIGN_KEY_VERSION
# Do not use service-account keys, broad project roles, or production static tokens.
HOSTED_CRYPTO_ENV="development"
HOSTED_CRYPTO_GCP_WEB_WRAP_KEY_NAME="projects/your-gcp-project/locations/global/keyRings/murph-hosted/cryptoKeys/hosted-web-wrap"
HOSTED_CRYPTO_GCP_AUTHORITY_SIGN_KEY_VERSION="projects/your-gcp-project/locations/global/keyRings/murph-hosted/cryptoKeys/hosted-authority-sign/cryptoKeyVersions/1"
HOSTED_CRYPTO_GCP_AUTHORITY_SIGN_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}'
HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_KEY_ID="cloudflare-automation:v1"
HOSTED_CRYPTO_GCP_PROJECT_NUMBER="123456789012"
HOSTED_CRYPTO_GCP_SERVICE_ACCOUNT_EMAIL="murph-hosted-crypto@your-gcp-project.iam.gserviceaccount.com"
HOSTED_CRYPTO_GCP_WORKLOAD_IDENTITY_POOL_ID="vercel"
HOSTED_CRYPTO_GCP_WORKLOAD_IDENTITY_PROVIDER_ID="vercel"
# Optional local/dev escape hatch. Hosted production rejects static GCP access
# tokens; production must use Vercel OIDC / GCP Workload Identity Federation.
# HOSTED_CRYPTO_GCP_ACCESS_TOKEN="replace-with-short-lived-local-token"
# HOSTED_CRYPTO_ALLOW_STATIC_GCP_ACCESS_TOKEN_FOR_DEV="0"
# Optional future recipients for rotation/recovery/TEE lanes. Configure each
# commented recipient set completely or leave it fully unset.
# HOSTED_CRYPTO_TEE_RUNTIME_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}'
# HOSTED_CRYPTO_TEE_RUNTIME_KEY_ID="tee-runtime:v1"
# HOSTED_CRYPTO_TEE_RUNTIME_POLICY_ID="tee-policy:v1"
# HOSTED_CRYPTO_RECOVERY_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}'
# HOSTED_CRYPTO_RECOVERY_KEY_ID="recovery:v1"
# Vercel-owned hosted cron routes under /api/internal/**/cron.
CRON_SECRET="replace-with-a-random-cron-secret"
# Optional hidden ops pages. Empty or unset denies access.
# HOSTED_OPS_MEMBER_IDS="hosted-member-id-1,hosted-member-id-2"
# Cloudflare-owned callback verification key published by apps/cloudflare.
HOSTED_WEB_CALLBACK_SIGNING_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}'
HOSTED_WEB_CALLBACK_SIGNING_KEY_ID="v1"
# Optional overlapping callback verification keyring during rotation.
# HOSTED_WEB_CALLBACK_SIGNING_PUBLIC_KEYRING_JSON='{"v0":{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}}'
