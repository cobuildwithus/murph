# Copy this file to an untracked local `.env.local` or `.env` for development, or load the values from your deploy secret manager.
# Keep every value below as a placeholder until you replace it with live credentials; never commit a real hosted `.env.local` or `.env`.
# If a live hosted `.env.local`, `.env`, or deploy secret is exposed, rotate the database credential, provider client secrets,
# webhook verification token, and the hosted device-sync encryption key.
# The hosted web control plane now supports an explicit keyring for device-sync control-plane secrecy.
# Set the current key in `DEVICE_SYNC_ENCRYPTION_KEY`, keep the active version in
# `DEVICE_SYNC_ENCRYPTION_KEY_VERSION`, and optionally provide prior readable versions in
# `DEVICE_SYNC_ENCRYPTION_KEYRING_JSON`.
# Use a stable project or custom domain for DEVICE_SYNC_PUBLIC_BASE_URL, not a preview deployment URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/murph_device_sync"
DEVICE_SYNC_ENCRYPTION_KEY="replace-with-32-byte-base64url-key"
DEVICE_SYNC_ENCRYPTION_KEY_VERSION="v1"
DEVICE_SYNC_ENCRYPTION_KEYRING_JSON='{"v1":"replace-with-32-byte-base64url-key"}'
DEVICE_SYNC_PUBLIC_BASE_URL="https://your-project.vercel.app/api/device-sync"
DEVICE_SYNC_ALLOWED_MUTATION_ORIGINS="https://your-project.vercel.app,http://localhost:3000"
DEVICE_SYNC_ALLOWED_RETURN_ORIGINS="https://your-project.vercel.app,http://localhost:3000"
DEVICE_SYNC_TRUSTED_USER_ASSERTION_HEADER="x-hosted-user-assertion"
DEVICE_SYNC_TRUSTED_USER_SIGNATURE_HEADER="x-hosted-user-signature"
DEVICE_SYNC_TRUSTED_USER_SIGNING_SECRET="replace-with-shared-signing-secret"
# Trusted auth middleware/proxy must mint a fresh signed assertion per request.
# Assertions should be short-lived (<= 5 minutes), bound to audience/method/path/origin,
# and carry a strong random nonce because the hosted control plane consumes each nonce once.
GARMIN_CLIENT_ID="replace-me"
GARMIN_CLIENT_SECRET="replace-me"
WHOOP_CLIENT_ID="replace-me"
WHOOP_CLIENT_SECRET="replace-me"
OURA_CLIENT_ID="replace-me"
OURA_CLIENT_SECRET="replace-me"
OURA_WEBHOOK_VERIFICATION_TOKEN="replace-me"
STRAVA_CLIENT_ID="replace-me"
STRAVA_CLIENT_SECRET="replace-me"
# Optional Strava provider overrides.
# STRAVA_AUTH_BASE_URL="https://www.strava.com"
# STRAVA_API_BASE_URL="https://www.strava.com/api/v3"
# STRAVA_SCOPES="activity:read"
# STRAVA_BACKFILL_DAYS="30"
# STRAVA_RECONCILE_DAYS="7"
# STRAVA_RECONCILE_INTERVAL_MS="21600000"
# STRAVA_REQUEST_TIMEOUT_MS="15000"
# Optional but required to auto-register and validate Strava webhooks.
STRAVA_WEBHOOK_VERIFY_TOKEN="replace-me"

LINQ_WEBHOOK_SECRET="replace-me"

# Hosted onboarding / Privy phone auth / billing / Linq SMS handoff
HOSTED_ONBOARDING_PUBLIC_BASE_URL="https://your-app.vercel.app"
HOSTED_CONTACT_PRIVACY_KEYS="v1:replace-with-separate-32-byte-base64url-key"
# HOSTED_CONTACT_PRIVACY_CURRENT_KEY_VERSION="v1" # required when HOSTED_CONTACT_PRIVACY_KEYS includes multiple versions
HOSTED_WEB_ENCRYPTION_KEY="replace-with-separate-32-byte-base64url-key"
HOSTED_WEB_ENCRYPTION_KEY_VERSION="v1"
# Optional overlapping member/share private-field keyring during rotation.
# HOSTED_WEB_ENCRYPTION_KEYRING_JSON='{"v0":"replace-with-separate-32-byte-base64url-key"}'
HOSTED_WAKE_ENCRYPTION_KEY="replace-with-separate-32-byte-base64url-key"
HOSTED_WAKE_ENCRYPTION_KEY_VERSION="v1"
# Optional overlapping hosted wake payload keyring during rotation.
# HOSTED_WAKE_ENCRYPTION_KEYRING_JSON='{"v0":"replace-with-separate-32-byte-base64url-key"}'
HOSTED_ONBOARDING_SIGNUP_PHONE_NUMBER="+1 555 010 1234"
NEXT_PUBLIC_PRIVY_APP_ID="cm_app_replace_me"
NEXT_PUBLIC_PRIVY_CLIENT_ID="client_replace_me"
PRIVY_APP_SECRET="app_secret_replace_me"
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
# In the Privy dashboard:
# - restrict allowed domains to your real hosted origins and remove stale test/dev domains
# - enable email login/linking so /settings can verify user email addresses
# - enable identity tokens at User management > Authentication > Advanced
# - enable access + identity tokens for the hosted web client so browser requests can authenticate with bearer + identity-token headers
# - keep Privy app-client session duration aligned with your desired risk window
# - if you use separate localhost and production web app clients, set NEXT_PUBLIC_PRIVY_CLIENT_ID per environment
# Optional: if you set a Privy base domain for other web clients, also set PRIVY_BASE_DOMAIN so apps/web CSP can allow the
# domain-specific Privy instance (for example: example.com -> https://privy.example.com).
PRIVY_BASE_DOMAIN="example.com"
HOSTED_ONBOARDING_INVITE_TTL_HOURS="168"
# Hosted onboarding checkout is subscription-only.
# By default hosted AI usage is recorded but not billed while Stripe native LLM billing access is pending.
# Set HOSTED_AI_USAGE_BILLING_MODE="stripe_meter" only when you intentionally want the classic Stripe meter fallback.
# Missing or unsupported values fail closed to "disabled".
HOSTED_AI_USAGE_BILLING_MODE="disabled"
HOSTED_AI_USAGE_REPORTING_SECRET="replace-me-with-random-metering-secret"
# Optional preview-only Vercel AI Gateway -> Stripe token billing delegation.
# This is ignored unless HOSTED_AI_USAGE_BILLING_MODE="stripe_meter"; enable it
# on the Cloudflare execution worker only when Stripe Billing for LLM tokens is
# available on your account and Gateway requests should emit Stripe meter events
# directly instead of using the hosted-web fallback drain.
HOSTED_AI_USAGE_VERCEL_STRIPE_BILLING_ENABLED="0"
HOSTED_AI_USAGE_STRIPE_RESTRICTED_ACCESS_KEY="rk_test_replace_me"
# For root `pnpm dev`, prefer putting local-only test checkout values in
# `.tmp/.env.hosted-local-stripe` so they override Vercel Development env
# without being committed.
HOSTED_ONBOARDING_STRIPE_PRICE_ID_LAUNCH_MONTHLY="price_replace_me"
HOSTED_ONBOARDING_STRIPE_PRICE_ID_LAUNCH_EDGE_MONTHLY="price_replace_me"
# Required only when HOSTED_AI_USAGE_BILLING_MODE="stripe_meter".
# Configure these metered prices against the same Stripe Billing meter used by HOSTED_AI_USAGE_STRIPE_METER_EVENT_NAME.
# The fallback meter event shape emits input/output token events with model and token_type dimensions.
HOSTED_ONBOARDING_STRIPE_USAGE_PRICE_ID_LAUNCH_MONTHLY="price_meter_replace_me"
HOSTED_ONBOARDING_STRIPE_USAGE_PRICE_ID_LAUNCH_EDGE_MONTHLY="price_meter_replace_me"
STRIPE_SECRET_KEY="sk_test_replace_me"
# STRIPE_WEBHOOK_SECRET is auto-populated by `pnpm dev` from the local `stripe listen` CLI
# login when the Stripe CLI is installed. Shell overrides and repo-root .env values are
# preserved; a stale value pulled from Vercel Development env is discarded in favor of the
# listener's live secret. Set MURPH_DEV_SKIP_STRIPE_LISTEN=1 to opt out of the auto-listener.
STRIPE_WEBHOOK_SECRET="whsec_replace_me"
HOSTED_AI_USAGE_STRIPE_METER_EVENT_NAME=""
HOSTED_AI_USAGE_STRIPE_BATCH_LIMIT="32"
LINQ_API_TOKEN="replace-me"
LINQ_API_BASE_URL="https://api.linqapp.com/api/partner/v3"
# Optional shared Linq conversation pool used after activation.
# Leave blank to keep members on the inbound Linq thread when activation already started on a Linq number.
# Configure at least one value here before enabling a non-Linq acquisition path such as a shared Twilio activation number.
HOSTED_ONBOARDING_LINQ_CONVERSATION_PHONE_NUMBERS="+15550100001,+15550100002"
# Optional soft cap for new home-line assignments. Once a line reaches this many active members, activation chooses another line in the pool.
HOSTED_ONBOARDING_LINQ_MAX_ACTIVE_MEMBERS_PER_PHONE_NUMBER="1000"
# Hosted web -> Cloudflare control uses Vercel OIDC in production; no shared web-to-worker secret is required.
HOSTED_EXECUTION_CONTROL_URL="https://your-cloudflare-worker.example.com"
HOSTED_EXECUTION_CONTROL_TIMEOUT_MS="30000"
# Vercel-owned hosted cron routes under /api/internal/**/cron.
CRON_SECRET="replace-with-a-random-cron-secret"
# Cloudflare-owned callback verification key published by apps/cloudflare.
HOSTED_WEB_CALLBACK_SIGNING_PUBLIC_JWK='{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}'
HOSTED_WEB_CALLBACK_SIGNING_KEY_ID="v1"
# Optional overlapping callback verification keyring during rotation.
# HOSTED_WEB_CALLBACK_SIGNING_PUBLIC_KEYRING_JSON='{"v0":{"kty":"EC","crv":"P-256","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}}'
