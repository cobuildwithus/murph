{
  "name": "@murphai/hosted-web",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "dev": "vercel env run -- pnpm dev:local-env",
    "dev:local-env": "bash -c 'pnpm legal:pdf && pnpm health-commons:generate && { trap \"rm -rf .next-dev/.dev-server.lock\" INT TERM EXIT; pnpm --dir ../.. exec tsx apps/web/scripts/dev-local.ts \"$@\"; }' --",
    "build": "pnpm legal:pdf && pnpm health-commons:generate && pnpm prisma:generate && next build && pnpm health-commons:trace-check",
    "health-commons:generate": "pnpm --dir ../.. health-commons:generate",
    "health-commons:trace-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-health-commons-traces.ts",
    "lint": "eslint .",
    "start": "next start",
    "dev:smoke": "pnpm --dir ../.. exec tsx apps/web/scripts/dev-smoke.ts",
    "legal:pdf": "pnpm --dir ../.. exec tsx apps/web/scripts/generate-legal-pdfs.ts",
    "typecheck": "pnpm health-commons:generate && pnpm --dir ../.. exec tsx scripts/ensure-next-route-type-stubs.ts apps/web && pnpm prisma:generate && tsc -p tsconfig.json --pretty false",
    "typecheck:prepared": "pnpm health-commons:generate && pnpm --dir ../.. exec tsx scripts/ensure-next-route-type-stubs.ts apps/web && tsc -p tsconfig.json --pretty false",
    "test": "pnpm health-commons:generate && pnpm --dir ../.. exec vitest run --config apps/web/vitest.workspace.ts --no-coverage",
    "prisma:generate": "prisma generate && pnpm --dir ../.. exec tsx apps/web/scripts/ensure-prisma-client-link.ts",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "migrate:production:prebuild": "pnpm --dir ../.. exec tsx apps/web/scripts/run-production-migrations.ts",
    "verify": "bash scripts/verify-fast.sh",
    "verify:parallel": "MURPH_VERIFY_STEP_PARALLEL=1 bash scripts/verify-fast.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.3.0",
    "@murphai/cloudflare-hosted-control": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/device-syncd": "workspace:*",
    "@murphai/health-commons": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/messaging-ingress": "workspace:*",
    "@murphai/query": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "@privy-io/node": "^0.11.0",
    "@privy-io/react-auth": "^3.18.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "^3.1.0",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "input-otp": "1.4.2",
    "lucide-react": "1.7.0",
    "markdown-to-jsx": "9.7.16",
    "next": "^16.2.4",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "recharts": "3.8.0",
    "shadcn": "4.1.1",
    "stripe": "^20.4.1",
    "tailwind-merge": "3.5.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "workflow": "4.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.4",
    "linkedom": "0.18.12",
    "prisma": "^7.5.0",
    "tailwindcss": "^4.2.1"
  }
}
