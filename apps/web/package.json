{
  "name": "@murphai/hosted-web",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "^24.22.1"
  },
  "scripts": {
    "dev": "vercel env run -- pnpm dev:local-env",
    "dev:local-env": "bash -c 'pnpm legal:pdf && pnpm changelog:generate && pnpm health-commons:generate && pnpm prisma:generate && pnpm --dir ../.. exec tsx apps/web/scripts/dev-local.ts \"$@\"' --",
    "dev:prepared-local-env": "bash -c 'pnpm --dir ../.. exec tsx apps/web/scripts/dev-local.ts \"$@\"' --",
    "build:hosted-local": "pnpm --dir ../.. exec tsx apps/web/scripts/build-hosted-local-production.ts",
    "prebuild": "pnpm --dir ../../packages/runtime-state build",
    "build": "pnpm public-routes:waf-check && pnpm product-labels:env-check && pnpm hosted-crypto:env-check && pnpm legal:pdf && pnpm changelog:generate && pnpm health-commons:generate && pnpm prisma:generate:build && pnpm typecheck:prepared && bash scripts/run-production-next-build.sh && pnpm --dir ../.. workflow:clean-web-artifacts -- --quiet && pnpm health-commons:trace-check && pnpm og-assets:trace-check && pnpm og-assets:runtime-check",
    "changelog:generate": "pnpm --dir ../.. exec tsx apps/web/scripts/generate-changelog-fragments.ts",
    "health-commons:generate": "pnpm --dir ../.. health-commons:generate",
    "health-commons:trace-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-health-commons-traces.ts",
    "og-assets:trace-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-og-asset-traces.ts",
    "og-assets:runtime-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-og-emitted-runtime.ts",
    "og-assets:render": "pnpm --dir ../.. exec tsx apps/web/scripts/render-og-image.ts",
    "lint": "oxlint .",
    "start": "next start",
    "dev:smoke": "pnpm --dir ../.. exec tsx apps/web/scripts/dev-smoke.ts",
    "product-labels:env-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-product-label-runtime-env.ts",
    "hosted-crypto:env-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-hosted-crypto-standby-env.ts",
    "public-routes:waf-check": "pnpm --dir ../.. exec tsx apps/web/scripts/check-public-routes-waf.ts",
    "device:reconnect-link": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/create-device-reconnect-link.ts",
    "clinical-records:providers:import": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/import-epic-clinical-provider-directory.ts",
    "linq:sync-lines": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/sync-hosted-linq-lines.ts",
    "linq:ack-reaction-eval": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/linq-ack-reaction-eval.ts",
    "linq:production-canary": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/run-production-conversation-canary.ts",
    "linq:backfill-thread-route-accounts": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/backfill-hosted-thread-route-account-projections.ts",
    "privacy:backfill-vault-share-recent-dates": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/backfill-hosted-vault-share-recent-date-generations.ts",
    "stripe:migrate-legacy-usage-items": "pnpm --dir ../.. exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/migrate-legacy-stripe-usage-items.ts",
    "legal:pdf": "pnpm --dir ../.. exec tsx apps/web/scripts/generate-legal-pdfs.ts",
    "typecheck": "pnpm health-commons:generate && pnpm prisma:generate && pnpm typecheck:prepared",
    "typecheck:prepared": "pnpm changelog:generate && pnpm --dir ../.. exec tsx scripts/ensure-next-route-type-stubs.ts apps/web && node ../../scripts/run-typescript.mjs web -p tsconfig.json --pretty false",
    "typecheck:watch": "pnpm changelog:generate && pnpm health-commons:generate && pnpm prisma:generate && pnpm --dir ../.. exec tsx scripts/ensure-next-route-type-stubs.ts apps/web && node ../../scripts/run-typescript.mjs watch -p tsconfig.json --pretty false --watch --tsBuildInfoFile typecheck.watch.tsbuildinfo",
    "test": "pnpm health-commons:generate && pnpm test:prepared",
    "test:prepared": "pnpm changelog:generate && pnpm --dir ../.. exec tsx apps/web/scripts/run-hosted-web-vitest.mts",
    "test:viewport-overflow": "pnpm legal:pdf && pnpm changelog:generate && pnpm health-commons:generate && pnpm prisma:generate && MURPH_PLAYWRIGHT_GENERATED_INPUTS_PREPARED=1 playwright test e2e/viewport-overflow.spec.ts e2e/group-sponsorship-management-alert-dialog.spec.ts e2e/public-content-journeys.spec.ts",
    "prisma:generate": "prisma generate && pnpm --dir ../.. exec tsx apps/web/scripts/ensure-prisma-client-link.ts",
    "prisma:generate:build": "pnpm --dir ../.. exec tsx apps/web/scripts/prepare-prisma-client-for-build.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate:deploy": "pnpm --dir ../.. exec tsx apps/web/scripts/run-prisma-migrate-deploy.ts",
    "prisma:migrate:dev": "prisma migrate dev",
    "runtime-logs:migrate:deploy": "pnpm --dir ../.. exec tsx apps/web/scripts/run-runtime-log-migrate-deploy.ts",
    "release:production:contract-migrate": "pnpm --dir ../.. exec tsx apps/web/scripts/run-production-contract-migrations.ts",
    "release:production:migrate": "pnpm --dir ../../packages/hosted-execution build && pnpm --dir ../.. exec tsx apps/web/scripts/run-production-migrations.ts",
    "release:production:verify-deployment-protection": "pnpm --dir ../.. exec tsx apps/web/scripts/verify-vercel-production-deployment-protection.ts",
    "release:production:verify-exact-deployment": "pnpm --dir ../.. exec tsx apps/web/scripts/verify-vercel-production-deployment.ts",
    "verify": "bash scripts/verify-fast.sh",
    "verify:parallel": "MURPH_VERIFY_STEP_PARALLEL=1 bash scripts/verify-fast.sh"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@composio/client": "0.1.0-alpha.76",
    "@junction-api/sdk": "1.2.0",
    "@linqapp/sdk": "0.34.0",
    "@lob/lob-typescript-sdk": "1.4.2",
    "@murphai/clinical-records": "workspace:*",
    "@murphai/cloudflare-hosted-control": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/device-syncd": "workspace:*",
    "@murphai/health-commons": "workspace:*",
    "@murphai/health-metrics": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/messaging-ingress": "workspace:*",
    "@murphai/operator-config": "workspace:*",
    "@murphai/query": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "@onkernel/sdk": "^0.76.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@temporalio/client": "~1.16.3",
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.11.2",
    "@vercel/oidc": "^3.4.1",
    "@vercel/speed-insights": "2.1.0",
    "better-auth": "1.7.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "google-auth-library": "11.3.4",
    "input-otp": "1.4.2",
    "jose": "6.2.17",
    "lucide-react": "1.14.0",
    "next": "16.4.6",
    "openai": "6.45.0",
    "pg": "8.23.1",
    "qrcode-generator": "2.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.10.1",
    "resend": "6.38.0",
    "retell-sdk": "5.39.0",
    "server-only": "0.0.1",
    "shadcn": "4.7.0",
    "sharp": "0.35.5",
    "stripe": "^22.1.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "undici": "7.30.2",
    "vaul": "1.1.2",
    "viem": "2.47.12",
    "workflow": "5.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@murphai/assistant-runtime": "workspace:*",
    "@murphai/core": "workspace:*",
    "@murphai/hosted-local-harness": "workspace:*",
    "@murphai/vault-usecases": "workspace:*",
    "@next/eslint-plugin-next": "16.4.6",
    "@playwright/test": "^1.59.1",
    "@prisma/get-dmmf": "7.9.1",
    "@spectrum-ts/core": "12.8.0",
    "@spectrum-ts/imessage": "12.8.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@workflow/builders": "5.1.0",
    "@workflow/world": "5.2.0",
    "@workflow/world-local": "5.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "linkedom": "0.18.15",
    "oxlint": "1.93.0",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
