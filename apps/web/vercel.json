{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "sh scripts/vercel-build.sh",
  "ignoreCommand": "node ../../scripts/ci-markdown-docs-scope.mjs --vercel",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/hosted-onboarding/stripe/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hosted-growth/usage-referral/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hosted-onboarding/linq/contact-card/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/hosted-onboarding/linq/health/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/hosted-runtime/latency-alert/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/product-feedback/digest/cron",
      "schedule": "*/10 22,23 * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/nonces/cron",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/control-plane/cron",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/external/cron",
      "schedule": "35 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/runtime/cron",
      "schedule": "50 * * * *"
    },
    {
      "path": "/api/internal/hosted-growth/snapshot/cron",
      "schedule": "10 0 * * *"
    }
  ]
}
