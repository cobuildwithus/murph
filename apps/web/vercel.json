{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm release:production:migrate && pnpm build",
  "crons": [
    {
      "path": "/api/internal/hosted-onboarding/stripe/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hosted-onboarding/linq/contact-card/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/hosted-growth/snapshot/cron",
      "schedule": "10 0 * * *"
    },
    {
      "path": "/api/internal/call-circle/cron",
      "schedule": "*/10 * * * *"
    }
  ]
}
