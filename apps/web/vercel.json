{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm release:production:migrate && MURPH_HOSTED_WEB_PRISMA_GENERATED_BY_MIGRATIONS=1 pnpm build",
  "ignoreCommand": "exit 1",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "codex/vercel-build-oom": true,
      "*": false
    }
  },
  "crons": [
    {
      "path": "/api/internal/hosted-onboarding/stripe/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hosted-growth/usage-referral/cron",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/internal/hosted-onboarding/linq/contact-card/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/hosted-onboarding/linq/health/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/hosted-runtime/latency-alert/cron",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/internal/hosted-execution/product-feedback/digest/cron",
      "schedule": "*/10 22,23 * * *"
    },
    {
      "path": "/api/internal/hosted-execution/retention/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/internal/hosted-growth/snapshot/cron",
      "schedule": "10 0 * * *"
    }
  ]
}
