# Copy to apps/cloudflare/.dev.vars for wrangler dev or set these as real Cloudflare secrets/vars.
# This local scaffold mirrors the current hosted architecture:
# - Vercel OIDC authenticates the web -> Cloudflare control edge.
# - Dedicated callback signing keys authenticate the narrow Cloudflare -> web callback seam.
# - Runtime plaintext roots are fetched from hosted-web as signed per-user ingress/runtime envelopes.
# - Cloudflare unwraps only the cloudflare-automation-secret recipient and never stores canonical user roots.

HOSTED_CRYPTO_ENV=development
HOSTED_CRYPTO_AUTHORITY_SIGN_KEY_VERSION=projects/your-gcp-project/locations/global/keyRings/murph-hosted/cryptoKeys/hosted-authority-sign/cryptoKeyVersions/1
HOSTED_CRYPTO_AUTHORITY_SIGN_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-me\n-----END PUBLIC KEY-----"
HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_KEY_ID=cloudflare-automation:v1
HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"replace-me-base64url-private-scalar","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}

HOSTED_EXECUTION_VERCEL_OIDC_TEAM_SLUG=replace-me-with-your-vercel-team-slug
HOSTED_EXECUTION_VERCEL_OIDC_PROJECT_NAME=replace-me-with-your-vercel-project-name
HOSTED_EXECUTION_VERCEL_OIDC_ENVIRONMENT=development
# Publish the matching public JWK into apps/web as HOSTED_WEB_CALLBACK_SIGNING_PUBLIC_JWK.
HOSTED_WEB_CALLBACK_SIGNING_PRIVATE_JWK={"kty":"EC","crv":"P-256","d":"replace-me-base64url-private-scalar","x":"replace-me-base64url-x-coordinate","y":"replace-me-base64url-y-coordinate"}
HOSTED_WEB_CALLBACK_SIGNING_KEY_ID=v1
HOSTED_WEB_BASE_URL=http://127.0.0.1:3000

HOSTED_EXECUTION_DEFAULT_ALARM_DELAY_MS=21600000
HOSTED_EXECUTION_MAX_EVENT_ATTEMPTS=3
HOSTED_EXECUTION_RETRY_DELAY_MS=30000
HOSTED_EXECUTION_RUNNER_COMMIT_TIMEOUT_MS=30000
HOSTED_EXECUTION_RUNNER_TIMEOUT_MS=60000

# `pnpm dev` pulls Vercel development env for apps/web, injects required worker secrets through
# Wrangler's documented local process-env path when this file is absent, applies localhost worker/web
# var overrides with CLI `--var`, and starts this worker on http://127.0.0.1:8787 by default.

# Optional explicit native-container size for local/generated Wrangler config.
# Supported values are the named Wrangler presets such as `basic` or a JSON object like:
# CF_CONTAINER_INSTANCE_TYPE={"vcpu":0.5,"memory_mib":2048,"disk_mb":8192}
# CF_CONTAINER_INSTANCE_TYPE=basic

# Add any optional provider/runtime vars or secrets you need for wrangler dev here. The checked-in
# local scaffold no longer filters `.dev.vars` through `secrets.required`.
# OPENAI_API_KEY=...
# Configure Venice as one all-or-none group. The Web Settings choice stays
# hidden until these values have been deployed and HOSTED_VENICE_ENABLED is
# enabled in apps/web.
# VENICE_API_KEY=...
# HOSTED_VENICE_LUNA_MODEL=qwen3-4b
# HOSTED_VENICE_TERRA_MODEL=zai-org-glm-4.7
# HOSTED_VENICE_SOL_MODEL=qwen3-vl-235b-a22b
# MURPH_DATA_API_KEY=replace-with-random-data-api-key
# TELEGRAM_BOT_TOKEN=...

# Optional hosted email bridge settings for Cloudflare Email Routing + Email Sending.
# Keep these as operator-level Worker vars/secrets rather than per-user env overrides.
# HOSTED_EMAIL_DOMAIN=mail.example.test
# HOSTED_EMAIL_LOCAL_PART=assistant
# HOSTED_EMAIL_FROM_ADDRESS=assistant@mail.example.test
# HOSTED_EMAIL_SIGNING_SECRET=replace-me-with-a-random-email-routing-secret
# HOSTED_EMAIL_CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# HOSTED_EMAIL_CLOUDFLARE_API_TOKEN=your-cloudflare-api-token-with-email-sending-access
# HOSTED_EMAIL_CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
# HOSTED_EMAIL_DEFAULT_SUBJECT=Murph update

# Optional explicit hosted assistant seed for member activation.
# These are operator-level Worker vars, not per-user env overrides. The hosted runtime persists
# the selected active profile during bootstrap so later runs stay explicit.
# HOSTED_ASSISTANT_PROVIDER=vercel-ai-gateway
# HOSTED_ASSISTANT_MODEL=openai/gpt-5.6-terra
# HOSTED_ASSISTANT_CODEX_COMMAND=codex
# HOSTED_ASSISTANT_APPROVAL_POLICY=on-request
# HOSTED_ASSISTANT_SANDBOX=workspace-write
# HOSTED_ASSISTANT_PROFILE=default
# HOSTED_ASSISTANT_REASONING_EFFORT=medium
# HOSTED_ASSISTANT_OSS=false

# Optional allowlist extensions for encrypted per-user runner env overrides.
# Keep these in sync with the native container runtime when you extend the exact-key allowlist.
# Do not include platform-owned Telegram vars such as TELEGRAM_BOT_TOKEN,
# TELEGRAM_API_BASE_URL, or TELEGRAM_FILE_BASE_URL here.
# HOSTED_EXECUTION_ALLOWED_RUNNER_SECRET_KEYS=OPENAI_API_KEY,CUSTOM_API_KEY
