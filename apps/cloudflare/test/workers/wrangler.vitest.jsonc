{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hosted-runner-vitest",
  "main": "./worker-entry.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_RUNNER",
        "class_name": "VitestUserRunnerDurableObject"
      },
      {
        "name": "RUNNER_CONTAINER",
        "class_name": "RunnerContainerTestDouble"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["VitestUserRunnerDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RunnerContainerTestDouble"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "hosted-runner-vitest-bundles"
    }
  ],
  "vars": {
    "HOSTED_CRYPTO_AUTHORITY_SIGN_KEY_VERSION": "projects/test/locations/global/keyRings/ring/cryptoKeys/sign/cryptoKeyVersions/1",
    "HOSTED_CRYPTO_AUTHORITY_SIGN_PUBLIC_KEY_PEM": "-----BEGIN PUBLIC KEY-----\\nMFkwEwYHKoZIzj0CAQYIKoZIzj0DAQcDQgAExSelVJv6r6LPUS8GCNgj1T/7z5GX\\nOrhgY1cCdzGb5arweFyJLVwA8qz989+BmdvVRJ1G0Ff7g2+nxeIEe4xyZg==\\n-----END PUBLIC KEY-----",
    "HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_KEY_ID": "cloudflare-automation:v1",
    "HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_PRIVATE_JWK": "{\"crv\":\"P-256\",\"ext\":true,\"key_ops\":[\"deriveBits\"],\"kty\":\"EC\",\"x\":\"xSelVJv6r6LPUS8GCNgj1T_7z5GXOrhgY1cCdzGb5ao\",\"y\":\"8HhciS1cAPKs_fPfgZnb1USdRtBX-4Nvp8XiBHuMcmY\",\"d\":\"HAPljluiFVW3g-UEmrJ9NVYTlclAhaC8N5LT0h7vitQ\"}",
    "HOSTED_CRYPTO_ENV": "test",
    "HOSTED_EXECUTION_IDLE_CHECKPOINT_DELAY_MS": "54000",
    "HOSTED_EXECUTION_MAX_EVENT_ATTEMPTS": "3",
    "HOSTED_EXECUTION_RETRY_DELAY_MS": "1000",
    "HOSTED_EXECUTION_VERCEL_OIDC_PROJECT_NAME": "murph-web",
    "HOSTED_EXECUTION_VERCEL_OIDC_TEAM_SLUG": "murph-team",
    "HOSTED_WEB_BASE_URL": "http://127.0.0.1:8913",
    "HOSTED_WEB_CALLBACK_SIGNING_PRIVATE_JWK": "{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"xSelVJv6r6LPUS8GCNgj1T_7z5GXOrhgY1cCdzGb5ao\",\"y\":\"8HhciS1cAPKs_fPfgZnb1USdRtBX-4Nvp8XiBHuMcmY\",\"d\":\"HAPljluiFVW3g-UEmrJ9NVYTlclAhaC8N5LT0h7vitQ\",\"ext\":true,\"key_ops\":[\"sign\"]}",
    "MURPH_HOSTED_EXECUTION_STDIO_LOGS": "0",
    "VITEST": "true"
  }
}
