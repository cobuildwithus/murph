{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "murph-hosted",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-27",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "containers": [
    {
      "class_name": "RunnerContainer",
      "image": "../../Dockerfile.cloudflare-hosted-runner",
      "image_build_context": ".",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      },
      "max_instances": 1000,
      "rollout_active_grace_period": 300,
      "rollout_step_percentage": [10, 25, 50, 100]
    },
    {
      "class_name": "DeploySmokeRunnerContainer",
      "image": "../../Dockerfile.cloudflare-hosted-runner",
      "image_build_context": ".",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 6000
      },
      "max_instances": 1,
      "rollout_active_grace_period": 300,
      "rollout_step_percentage": [100]
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_RUNNER",
        "class_name": "UserRunnerDurableObject"
      },
      {
        "name": "RUNNER_CONTAINER",
        "class_name": "RunnerContainer"
      },
      {
        "name": "RUNNER_CONTAINER_SMOKE",
        "class_name": "DeploySmokeRunnerContainer"
      }
    ]
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserRunnerDurableObject"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RunnerContainer"]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["DeploySmokeRunnerContainer"]
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUNDLES",
      "bucket_name": "murph-hosted-bundles",
      "preview_bucket_name": "murph-hosted-bundles-preview"
    }
  ],
  "send_email": [
    {
      "name": "HOSTED_EMAIL"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "persist": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "secrets": {
    "required": [
      "HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_PRIVATE_JWK",
      "HOSTED_WEB_CALLBACK_SIGNING_PRIVATE_JWK"
    ]
  },
  "vars": {
    "HOSTED_CRYPTO_AUTHORITY_SIGN_KEY_VERSION": "projects/.../cryptoKeyVersions/1",
    "HOSTED_CRYPTO_AUTHORITY_SIGN_PUBLIC_KEY_PEM": "-----BEGIN PUBLIC KEY-----\\n...\\n-----END PUBLIC KEY-----",
    "HOSTED_CRYPTO_CLOUDFLARE_AUTOMATION_KEY_ID": "cloudflare-automation:v1",
    "HOSTED_CRYPTO_ENV": "prod",
    "HOSTED_EXECUTION_MAX_EVENT_ATTEMPTS": "3",
    "HOSTED_EXECUTION_RETRY_DELAY_MS": "30000",
    "HOSTED_EXECUTION_RUNNER_COMMIT_TIMEOUT_MS": "30000",
    "HOSTED_EXECUTION_RUNNER_IDLE_TTL_MS": "1200000",
    "HOSTED_EXECUTION_WEB_CONTROL_TIMEOUT_MS": "30000",
    "HOSTED_EXECUTION_VERCEL_OIDC_ENVIRONMENT": "production"
  },
  // Real deploys render this scaffold from environment-specific bucket names, OIDC vars,
  // and the required worker secrets above. Optional runtime integrations, callback base
  // URLs, assistant profile config, and keyrings are configured outside source control.
  // Wrangler's `secrets.required` support is experimental; keep the required list tight.
}
