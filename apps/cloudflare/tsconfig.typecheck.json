{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "../..",
    "tsBuildInfoFile": "typecheck.tsbuildinfo",
    "types": [
      "node",
      "@cloudflare/workers-types",
      "@cloudflare/vitest-pool-workers"
    ]
  },
  "include": [
    "*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "test/helpers/hosted-local-full-stack-scenario.ts",
    "test/helpers/hosted-local-linq-support.ts",
    "test/helpers/hosted-local-telegram-support.ts",
    "test/helpers/hosted-local-wake.test.ts",
    "test/helpers/hosted-local-wake.ts",
    "test/hosted-local-linq-first-contact-e2e.test.ts",
    "test/hosted-local-linq-webhook-e2e.test.ts",
    "test/hosted-local-telegram-first-contact-e2e.test.ts"
  ]
}
