{
  "name": "murph-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "engines": {
    "node": ">=24.14.1",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "prepare": "if [ -z \"${CI:-}\" ] && [ -z \"${VERCEL:-}\" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then scripts/install-git-hooks; fi",
    "hosted-local": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/hosted-local.ts",
    "dev": "pnpm hosted-local up",
    "dev:worktree": "pnpm hosted-local worktree up",
    "dev:reset": "MURPH_DEV_FORCE_RESET_LOCAL_DB=1 MURPH_DEV_TEMPORAL=managed pnpm hosted-local up",
    "temporal:cli:setup": "bash scripts/setup-temporal-cli.sh",
    "temporal:cli:check": "bash scripts/setup-temporal-cli.sh --check",
    "stripe:cli:setup": "bash scripts/setup-stripe-cli.sh",
    "stripe:cli:check": "bash scripts/setup-stripe-cli.sh --check",
    "hosted-billing:live:preflight": "pnpm exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/preflight-hosted-stripe-billing-live.ts",
    "hosted-billing:live:cleanup": "pnpm exec tsx --tsconfig apps/web/tsconfig.json apps/web/scripts/cleanup-hosted-stripe-billing-live.ts",
    "hosted-billing:ci-guard": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/check-hosted-stripe-billing-ci.ts",
    "temporal:dev": "bash scripts/temporal-dev-server.sh",
    "wearable:capture": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/wearable-fixture-capture.ts",
    "test:e2e:hosted-local": "pnpm hosted-local e2e",
    "build": "node scripts/run-with-host-verification-slot.mjs 'workspace package build' -- pnpm -r --sort --workspace-concurrency=${MURPH_BUILD_WORKSPACE_CONCURRENCY:-4} --filter './packages/**' build",
    "clean:build:workspace": "node scripts/clean-build-artifacts.mjs workspace",
    "clean:build:test-runtime": "node scripts/clean-build-artifacts.mjs test-runtime",
    "build:workspace:clean": "node scripts/run-with-host-verification-slot.mjs 'workspace clean build' -- bash -c 'pnpm clean:build:workspace && node scripts/run-typescript.mjs workspace-build -b tsconfig.json --force --pretty false && pnpm --dir packages/importers build'",
    "build:workspace:incremental": "node scripts/run-with-host-verification-slot.mjs 'workspace incremental build' -- bash -c 'node scripts/run-typescript.mjs workspace-build -b tsconfig.json --pretty false && pnpm --dir packages/importers build'",
    "build:test-runtime": "node scripts/run-with-host-verification-slot.mjs 'test runtime build' -- bash -c 'pnpm clean:build:test-runtime && node scripts/run-typescript.mjs workspace-build -b tsconfig.test-runtime.json --pretty false && pnpm --dir packages/importers build'",
    "clean": "node scripts/rm-paths.mjs tsconfig.tools.tsbuildinfo packages/*/dist packages/*/.dist-next packages/*/.dist-next.tsbuildinfo packages/*/.dist-publish-* packages/*/.dist-backup-* packages/*/.tsconfig.build-next.json packages/*/.next packages/*/.test-dist packages/*/.tsbuildinfo packages/*/*.tsbuildinfo apps/*/.next apps/*/.next-dev apps/*/.next-smoke apps/*/.next-smoke-* apps/*/.tsbuildinfo apps/*/*.tsbuildinfo && pnpm workflow:clean-web-artifacts -- --quiet && pnpm clean:source-sidecars",
    "clean:source-sidecars": "tsx scripts/prune-generated-source-sidecars.ts --quiet",
    "workflow:clean-web-artifacts": "tsx scripts/clean-hosted-web-workflow-artifacts.ts",
    "deps:guard": "node scripts/verify-dependency-policy.mjs",
    "deps:audit": "pnpm audit --audit-level=high",
    "deps:approve-builds": "pnpm approve-builds",
    "deps:ignored-builds": "pnpm ignored-builds",
    "typecheck": "bash scripts/workspace-verify.sh typecheck",
    "typecheck:packages": "bash scripts/workspace-verify.sh typecheck:packages",
    "test": "bash scripts/workspace-verify.sh test",
    "test:repo-tools": "pnpm exec vitest run --config scripts/vitest.config.ts --no-coverage",
    "test:frontend-design-proof": "node --test scripts/check-frontend-design-proof.test.mjs",
    "design-proof:upload": "pnpm exec tsx --tsconfig tsconfig.base.json scripts/upload-design-proof-image.ts",
    "test:packages": "bash scripts/workspace-verify.sh test:packages",
    "test:apps": "bash scripts/workspace-verify.sh test:apps",
    "test:packages:coverage": "bash scripts/workspace-verify.sh test:packages:coverage",
    "test:coverage": "bash scripts/workspace-verify.sh test:coverage",
    "test:diff": "node scripts/verification-dispatch.mjs test:diff",
    "test:diff:local": "bash scripts/workspace-verify.sh test:diff",
    "verify:acceptance": "node scripts/verification-dispatch.mjs verify:acceptance",
    "verify:acceptance:local": "bash scripts/workspace-verify.sh verify:acceptance",
    "generate:watch": "pnpm health-commons:generate:watch",
    "exercise-library:generate": "pnpm --dir packages/exercise-library generate",
    "health-commons:generate": "node scripts/ensure-health-commons-generated.mjs",
    "health-commons:generate:watch": "node scripts/watch-health-commons-generated.mjs",
    "test:scenario-integrity": "tsx e2e/smoke/verify-scenario-integrity.ts",
    "verify:cli": "bash scripts/workspace-verify.sh verify:cli",
    "hosted-crypto:guard": "node scripts/check-hosted-crypto-hardcut.mjs",
    "hosted-temporal:guard": "tsx scripts/check-hosted-temporal-orchestration-guards.ts",
    "logs:guard": "tsx scripts/check-raw-health-log-payloads.ts",
    "provider-requests:guard": "tsx scripts/check-provider-request-boundaries.ts",
    "no-js": "pnpm clean:source-sidecars && tsx scripts/check-no-js.ts",
    "docs:drift": "bash scripts/check-agent-docs-drift.sh",
    "docs:gardening": "bash scripts/doc-gardening.sh --fail-on-issues",
    "changelog:update": "bash scripts/update-changelog.sh",
    "release:notes": "bash scripts/generate-release-notes.sh",
    "release:check": "bash scripts/release-check.sh",
    "release:trust:github": "node scripts/configure-trusted-publishing.mjs",
    "release:dry-run": "bash scripts/release.sh patch --dry-run",
    "release:patch": "bash scripts/release.sh patch",
    "release:patch:rc": "bash scripts/release.sh prepatch --preid rc",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "plan:open": "bash scripts/open-exec-plan.sh",
    "plan:close": "bash scripts/close-exec-plan.sh",
    "task:finish": "bash scripts/finish-task",
    "review:gpt": "bash scripts/review-gpt-pr-head-preflight.sh --run",
    "benchmark:typescript": "node scripts/run-with-workspace-artifact-lock.mjs 'TypeScript benchmark' -- node scripts/run-with-host-verification-slot.mjs 'TypeScript benchmark' -- node scripts/benchmark-typescript.mjs",
    "onboard": "bash scripts/setup-host.sh",
    "chat": "pnpm exec tsx packages/cli/src/bin.ts assistant chat",
    "zip:src": "bash scripts/package-audit-context.sh --zip",
    "zip:src:full": "bash scripts/package-audit-context-full.sh --zip",
    "verify:repo": "pnpm verify:acceptance",
    "setup:macos": "bash scripts/setup-macos.sh",
    "setup:host": "bash scripts/setup-host.sh",
    "setup:linux": "bash scripts/setup-linux.sh",
    "verify:workspace-boundaries": "node scripts/verify-workspace-boundaries.mjs",
    "verify:workspace-package-cycles": "node scripts/check-workspace-package-cycles.mjs",
    "build:test-runtime:prepared": "node scripts/build-test-runtime-prepared.mjs"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/types": "^7.29.0",
    "@cobuild/repo-tools": "^0.1.15",
    "@cobuild/review-gpt": "^0.5.126",
    "@elevenlabs/elevenlabs-js": "2.62.0",
    "@murphai/health-metrics": "workspace:*",
    "@murphai/hosted-local-harness": "workspace:*",
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.6",
    "frog": "1.1.0",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.6"
  }
}
