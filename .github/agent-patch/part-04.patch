+      prisma,
+      providerStatus: "AT_RISK",
+      providerUpdatedAt: new Date("2026-07-29T16:00:00.000Z"),
+    })).resolves.toBe(false);
+
+    expect(updateMany).toHaveBeenCalledWith(expect.objectContaining({
