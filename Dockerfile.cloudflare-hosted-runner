ARG HOSTED_RUNNER_BASE_IMAGE=ghcr.io/cobuildwithus/murph-cloudflare-runner-base:node24.14.1-codex0.143.0

FROM ${HOSTED_RUNNER_BASE_IMAGE}

USER root

ARG HOSTED_RUNNER_BUNDLE_DIR=.deploy/runner-bundle

ENV MURPH_HOSTED_CODEX_MODEL_CATALOG_JSON="/usr/local/share/murph/codex-model-catalog.openai-flex.json"

# use_responses_lite must stay false: the OpenAI API rejects gpt-5.4-nano when
# Keep use_responses_lite false for the smoke model so future Codex upgrades do
# not hit the OpenAI response-lite rejection path for `gpt-5.4-nano`.
RUN mkdir -p /usr/local/share/murph \
  && codex debug models --bundled \
    | jq 'def add_gpt_55_flex: (.service_tiers) |= ((. // []) | if any(.[]?; .id == "flex") then . else . + [{"id":"flex","name":"Flex","description":"Lower-cost flexible processing"}] end); def first_model($slug): ([.models[]? | select(.slug == $slug)][0] // error("missing Codex model catalog entry: " + $slug)); def gpt_54_nano_from($model): $model | .slug = "gpt-5.4-nano" | .display_name = "GPT-5.4-Nano" | .description = "Fast, low-cost model for deploy smoke checks." | .priority = 5 | .service_tiers = [] | .supports_search_tool = false | .supports_parallel_tool_calls = false | .use_responses_lite = false; (.models[] | select(.slug == "gpt-5.5")) |= add_gpt_55_flex | if any(.models[]?; .slug == "gpt-5.4-nano") then (.models[] | select(.slug == "gpt-5.4-nano")) |= gpt_54_nano_from(.) else first_model("gpt-5.4-mini") as $mini | .models += [gpt_54_nano_from($mini)] end' \
    > /tmp/murph-codex-model-catalog.openai-flex.json \
  && jq -s -e 'length == 1 and (.[0] | any(.models[]?; .slug == "gpt-5.5" and any(.service_tiers[]?; .id == "flex")) and any(.models[]?; .slug == "gpt-5.4-nano" and .supports_search_tool == false and .supports_parallel_tool_calls == false and .use_responses_lite == false))' /tmp/murph-codex-model-catalog.openai-flex.json >/dev/null \
  && install -m 0444 /tmp/murph-codex-model-catalog.openai-flex.json "${MURPH_HOSTED_CODEX_MODEL_CATALOG_JSON}" \
  && rm -f /tmp/murph-codex-model-catalog.openai-flex.json

COPY --chown=root:root ${HOSTED_RUNNER_BUNDLE_DIR}/ /app/

RUN chmod -R a-w /app \
  && chmod -R a+rX /app

USER runner

ARG HOSTED_RUNNER_LOCAL_BUILD_ID=local

LABEL murph.hosted.local-build-id="${HOSTED_RUNNER_LOCAL_BUILD_ID}"

# Differentiates the per-class image config so sibling container classes built
# from this shared Dockerfile (RunnerContainer, DeploySmokeRunnerContainer)
# never share a Docker image ID in local dev. wrangler dev's duplicate-tag
# cleanup (`cleanupDuplicateImageTags` in @cloudflare/containers-shared) runs
# `docker rmi` on every other `cloudflare-dev/*` tag pointing at the same image
# ID, which untagged the runner image right after the deploy-smoke image build
# and made hosted-local cold starts fail with
# "No such image available named cloudflare-dev/runnercontainer:<tag>".
ARG HOSTED_RUNNER_CONTAINER_CLASS=RunnerContainer

LABEL murph.hosted.container-class="${HOSTED_RUNNER_CONTAINER_CLASS}"

ENTRYPOINT ["/usr/bin/tini", "-s", "--"]

# The bundled entrypoint evaluates ~27 chunk files at boot instead of the
# unbundled graph's ~960 module files — the difference between ~2s and
# sub-second nodeStartupMs on lazily pulled production image layers. Two
# assistant-engine resolvers derive asset paths from their own module location
# and would land inside dist-bundled/ when bundled; pin them to the installed
# package copies instead (both env overrides are first-class in the engine).
ENV MURPH_ASSISTANT_SKILLS_ROOT="/app/node_modules/@murphai/assistant-engine/skills"
ENV MURPH_ASSISTANT_CLI_SURFACE_PREBUILT_ARTIFACT_PATH="/app/node_modules/@murphai/assistant-engine/dist/assistant/cli-surface-contract.generated.json"

CMD ["node", "dist-bundled/container-entrypoint.js"]
