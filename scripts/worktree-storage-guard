#!/usr/bin/env bash
set -euo pipefail
original_args=("$@")
original_arg_count=$#

usage() {
  printf 'Usage: %s [--current-worktree <path>] [--reserve-worktree] [--target-path <path>]\n' "$(basename "$0")" >&2
  exit 2
}

reserve=0
target_path=''
current_worktree_path="${MURPH_WORKTREE_GUARD_CURRENT_WORKTREE:-}"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --current-worktree)
      [[ $# -ge 2 && -n "$2" ]] || usage
      current_worktree_path="$2"
      shift 2
      ;;
    --reserve-worktree)
      reserve=1
      shift
      ;;
    --target-path)
      [[ $# -ge 2 && -n "$2" ]] || usage
      target_path="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
max_regular="${MURPH_WORKTREE_MAX_LIVE:-100}"
min_free_gib="${MURPH_WORKTREE_MIN_FREE_GIB:-20}"

for value in "$max_regular" "$min_free_gib"; do
  if [[ ! "$value" =~ ^[0-9]+$ ]]; then
    printf 'worktree storage guard: limits must be non-negative integers\n' >&2
    exit 2
  fi
done
if (( max_regular < 1 )); then
  printf 'worktree storage guard: invalid worktree or free-space limit\n' >&2
  exit 2
fi

common_dir="$(git -C "$repo_root" rev-parse --path-format=absolute --git-common-dir)"
state_dir="${MURPH_WORKTREE_GUARD_STATE_DIR:-$common_dir/murph-worktree-storage-guard}"
state_file="$state_dir/regular-worktree-ceiling"
unmanaged_state_file="$state_dir/unmanaged-temp-checkouts"
authorization_initialized="$state_dir/authorization-initialized"
lock_file="$state_dir/lock"
if [[ -n "${MURPH_WORKTREE_MAX_LIVE+x}" && -z "${MURPH_WORKTREE_GUARD_STATE_DIR+x}" ]]; then
  printf 'worktree storage guard: a custom maximum requires isolated state\n' >&2
  exit 2
fi
mkdir -p "$state_dir"

primary_worktree="$(
  git -C "$repo_root" worktree list --porcelain |
    awk '$1 == "worktree" && !found { print substr($0, 10); found = 1 }'
)"
[[ -n "$primary_worktree" && -d "$primary_worktree" ]] || {
  printf 'worktree storage guard: primary checkout could not be resolved\n' >&2
  exit 1
}
primary_worktree="$(cd "$primary_worktree" && pwd -P)"
guard_is_primary=0
[[ "$repo_root" == "$primary_worktree" ]] && guard_is_primary=1

# Historical installers invoke the primary checkout's guard without arguments
# while their working directory remains the authorized historical checkout.
# Preserve that rollout path without weakening a no-argument audit run from the
# primary checkout itself or treating a different repository as a sibling.
if (( original_arg_count == 0 )) && [[ -z "$current_worktree_path" ]]; then
  invoking_worktree="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  invoking_common_dir="$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [[ -n "$invoking_worktree" && -n "$invoking_common_dir" ]]; then
    invoking_worktree="$(cd "$invoking_worktree" 2>/dev/null && pwd -P)" || invoking_worktree=''
    invoking_common_dir="$(cd "$invoking_common_dir" 2>/dev/null && pwd -P)" || invoking_common_dir=''
  fi
  if [[ -n "$invoking_worktree" && "$invoking_worktree" != "$repo_root" \
    && "$invoking_common_dir" == "$common_dir" ]]; then
    current_worktree_path="$invoking_worktree"
  fi
fi

if [[ -n "$current_worktree_path" ]]; then
  [[ -d "$current_worktree_path" ]] || {
    printf 'worktree storage guard: current worktree could not be resolved\n' >&2
    exit 1
  }
  current_worktree_path="$(cd "$current_worktree_path" && pwd -P)"
fi

historical_installer_compatibility=0
if (( original_arg_count == 0 )) \
  && [[ -n "$current_worktree_path" && "$current_worktree_path" != "$repo_root" ]]; then
  historical_installer_compatibility=1
fi

if [[ "${MURPH_WORKTREE_GUARD_LOCK_HELD:-0}" != 1 ]]; then
  if (( historical_installer_compatibility == 1 )); then
    # The pre-lock installer reaches this current-primary guard only after its
    # config writes. This bounded wait protects the final check during rollout;
    # it does not retroactively serialize those earlier writes.
    compatibility_wait_seconds=180
    printf 'worktree storage guard: historical installer final check waiting up to %s seconds for the storage guard lock\n' \
      "$compatibility_wait_seconds" >&2
    set +e
    if command -v flock >/dev/null 2>&1; then
      flock -w "$compatibility_wait_seconds" "$lock_file" \
        env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0"
      lock_status=$?
    elif command -v lockf >/dev/null 2>&1; then
      lockf -t "$compatibility_wait_seconds" "$lock_file" \
        env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0"
      lock_status=$?
    else
      set -e
      printf 'worktree storage guard: flock or lockf is required for serialization\n' >&2
      exit 1
    fi
    set -e
    if (( lock_status != 0 )); then
      printf 'worktree storage guard: historical installer final check failed within %s seconds\n' \
        "$compatibility_wait_seconds" >&2
    fi
    exit "$lock_status"
  fi

  if command -v flock >/dev/null 2>&1; then
    if (( original_arg_count > 0 )); then
      exec flock -w 5 "$lock_file" env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0" \
        "${original_args[@]}"
    else
      exec flock -w 5 "$lock_file" env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0"
    fi
  elif command -v lockf >/dev/null 2>&1; then
    if (( original_arg_count > 0 )); then
      exec lockf -t 5 "$lock_file" env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0" \
        "${original_args[@]}"
    else
      exec lockf -t 5 "$lock_file" env MURPH_WORKTREE_GUARD_LOCK_HELD=1 "$0"
    fi
  else
    printf 'worktree storage guard: flock or lockf is required for serialization\n' >&2
    exit 1
  fi
fi

regular_count=0
data_count=0
unauthorized_count=0
current_worktree_found=0
current_worktree_unauthorized=0
admin_dirs=()
registered_paths=()
disk_paths=("$repo_root")
record_path=''
record_locked=''

count_record() {
  local gitdir_line gitdir_value admin_dir canonical_record_path authorization_marker isolation_marker
  [[ -n "$record_path" && -d "$record_path" ]] || return 0
  canonical_record_path="$(cd "$record_path" 2>/dev/null && pwd -P)" || return 0
  registered_paths+=("$canonical_record_path")
  if [[ -n "$current_worktree_path" && "$canonical_record_path" == "$current_worktree_path" ]]; then
    current_worktree_found=1
  fi
  if [[ -d "$record_path/.git" ]]; then
    return 0
  fi
  [[ -f "$record_path/.git" ]] || return 0
  IFS= read -r gitdir_line <"$record_path/.git" || return 0
  [[ "$gitdir_line" == 'gitdir: '* ]] || return 0
  gitdir_value="${gitdir_line#gitdir: }"
  if [[ "$gitdir_value" == /* ]]; then
    admin_dir="$gitdir_value"
  else
    admin_dir="$record_path/$gitdir_value"
  fi
  admin_dir="$(cd "$admin_dir" 2>/dev/null && pwd -P)" || return 0
  case "$admin_dir" in
    "$common_dir"/worktrees/*)
      disk_paths+=("$record_path")
      authorization_marker="$admin_dir/murph-storage-guard-authorized"
      isolation_marker="$admin_dir/murph-storage-guard-isolated"
      if [[ -e "$isolation_marker" || -L "$isolation_marker" ]]; then
        unauthorized_count=$((unauthorized_count + 1))
        if [[ -n "$current_worktree_path" && "$canonical_record_path" == "$current_worktree_path" ]]; then
          current_worktree_unauthorized=1
        fi
        if (( guard_is_primary == 1 )); then
          # Retire the bounded state published by an earlier rejected guard.
          # Authorization must disappear first so every older guard fails
          # closed if cleanup is interrupted. Never follow marker symlinks.
          if [[ -f "$authorization_marker" || -L "$authorization_marker" ]]; then
            rm -f -- "$authorization_marker"
          fi
          if [[ ! -e "$authorization_marker" && ! -L "$authorization_marker" \
            && -f "$isolation_marker" && ! -L "$isolation_marker" ]]; then
            rm -f -- "$isolation_marker"
          fi
        fi
      else
        admin_dirs+=("$admin_dir")
        if [[ -f "$authorization_initialized" && ! -f "$authorization_marker" ]]; then
          unauthorized_count=$((unauthorized_count + 1))
          if [[ -n "$current_worktree_path" && "$canonical_record_path" == "$current_worktree_path" ]]; then
            current_worktree_unauthorized=1
          fi
        fi
      fi
      ;;
    *) return 0 ;;
  esac
  if [[ "$record_locked" == 'data/research:'* ]]; then
    data_count=$((data_count + 1))
  else
    regular_count=$((regular_count + 1))
  fi
}

worktree_output="$(git -C "$repo_root" worktree list --porcelain)"
while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ -z "$line" ]]; then
    count_record
    record_path=''
    record_locked=''
    continue
  fi
  case "$line" in
    worktree\ *) record_path="${line#worktree }" ;;
    locked\ *) record_locked="${line#locked }" ;;
    locked) record_locked='locked' ;;
  esac
done <<<"$worktree_output"
count_record

if [[ -n "$current_worktree_path" ]] && (( current_worktree_found == 0 )); then
  printf 'worktree storage guard: current worktree is not registered\n' >&2
  exit 1
fi
if (( current_worktree_unauthorized == 1 )); then
  printf 'worktree storage guard: current worktree bypassed scripts/create-worktree\n' >&2
  exit 1
fi
if (( unauthorized_count > 0 )) && [[ -z "$current_worktree_path" ]]; then
  printf 'worktree storage guard: %d worktree(s) bypassed scripts/create-worktree\n' \
    "$unauthorized_count" >&2
  exit 1
fi

if [[ ! -f "$authorization_initialized" ]] && (( guard_is_primary == 1 )); then
  if (( ${#admin_dirs[@]} > 0 )); then
    for admin_dir in "${admin_dirs[@]}"; do
      : >"$admin_dir/murph-storage-guard-authorized"
    done
  fi
  : >"$authorization_initialized"
fi

normalize_remote() {
  local remote="$1"
  remote="${remote%.git}"
  case "$remote" in
    git@*:* )
      remote="${remote#git@}"
      remote="${remote/:/\/}"
      ;;
    ssh://git@*) remote="${remote#ssh://git@}" ;;
    https://*) remote="${remote#https://}" ;;
    http://*) remote="${remote#http://}" ;;
  esac
  printf '%s' "$remote"
}

local_remote_points_to_current_repo() {
  local remote="$1" remote_path remote_common_dir
  case "$remote" in
    file://*) remote_path="${remote#file://}" ;;
    /*) remote_path="$remote" ;;
    *) return 1 ;;
  esac
  [[ -d "$remote_path" ]] || return 1
  remote_common_dir="$(git -C "$remote_path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
    || return 1
  remote_common_dir="$(cd "$remote_common_dir" 2>/dev/null && pwd -P)" || return 1
  [[ "$remote_common_dir" == "$common_dir" ]]
}

read_origin_from_config() {
  local config_path="$1" line in_origin=0
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line#"${line%%[![:space:]]*}"}"
    case "$line" in
      "[remote \"origin\"]")
        in_origin=1
        ;;
      '['*)
        in_origin=0
        ;;
      url\ =\ *)
        if (( in_origin == 1 )); then
          printf '%s' "${line#url = }"
          return 0
        fi
        ;;
    esac
  done <"$config_path"
  return 1
}

is_registered_path() {
  local candidate="$1" registered
  for registered in "${registered_paths[@]}"; do
    [[ "$candidate" == "$registered" ]] && return 0
  done
  return 1
}

temp_roots=()
if [[ -n "${MURPH_WORKTREE_TEMP_ROOTS+x}" ]]; then
  IFS=':' read -r -a temp_roots <<<"${MURPH_WORKTREE_TEMP_ROOTS:-}"
else
  temp_roots=(/private/tmp /tmp)
fi

canonical_temp_roots=()
for temp_root in "${temp_roots[@]}"; do
  [[ -n "$temp_root" && -d "$temp_root" ]] || continue
  canonical_temp_root="$(cd "$temp_root" 2>/dev/null && pwd -P)" || continue
  duplicate_root=0
  if (( ${#canonical_temp_roots[@]} > 0 )); then
    for existing_root in "${canonical_temp_roots[@]}"; do
      [[ "$existing_root" == "$canonical_temp_root" ]] && duplicate_root=1
    done
  fi
  (( duplicate_root == 0 )) && canonical_temp_roots+=("$canonical_temp_root")
done

primary_remote="$(git -C "$repo_root" config --get remote.origin.url 2>/dev/null || true)"
normalized_primary_remote=''
[[ -n "$primary_remote" ]] && normalized_primary_remote="$(normalize_remote "$primary_remote")"
unmanaged_fingerprints=()
unmanaged_candidates=()
temporary_pnpm_store_count=0
repo_fingerprint_identity="${normalized_primary_remote:-local:$common_dir}"
if (( ${#canonical_temp_roots[@]} > 0 )); then
  shopt -s nullglob
  for temp_root in "${canonical_temp_roots[@]}"; do
    for candidate in "$temp_root"/murph-*; do
      [[ -d "$candidate" && ! -L "$candidate" ]] || continue
      candidate_git_dir="$candidate/.git"
      if [[ ! -e "$candidate_git_dir" ]]; then
        case "${candidate##*/}" in
          *pnpm*store*) temporary_pnpm_store_count=$((temporary_pnpm_store_count + 1)) ;;
        esac
      fi
      [[ -d "$candidate_git_dir" ]] || continue
      canonical_candidate="$(cd "$candidate" 2>/dev/null && pwd -P)" || continue
      is_registered_path "$canonical_candidate" && continue
      candidate_remote="$(read_origin_from_config "$candidate_git_dir/config" 2>/dev/null || true)"
      [[ -n "$candidate_remote" ]] || continue
      normalized_candidate_remote="$(normalize_remote "$candidate_remote")"
      if [[ -z "$normalized_primary_remote" \
        || "$normalized_candidate_remote" != "$normalized_primary_remote" ]]; then
        local_remote_points_to_current_repo "$candidate_remote" || continue
      fi
      unmanaged_candidates+=("$canonical_candidate")
    done
  done
  shopt -u nullglob
fi
if (( temporary_pnpm_store_count > 0 )); then
  printf 'worktree storage guard: %d standalone temporary pnpm store(s) must use the ordinary shared store\n' \
    "$temporary_pnpm_store_count" >&2
  exit 1
fi
if (( ${#unmanaged_candidates[@]} > 0 )); then
  unmanaged_hash_output=''
  if ! unmanaged_hash_output="$(
    printf '%s\0' "${unmanaged_candidates[@]}" |
      MURPH_GUARD_REMOTE="$repo_fingerprint_identity" node -e '
        const crypto = require("node:crypto");
        const remote = process.env.MURPH_GUARD_REMOTE ?? "";
        const input = require("node:fs").readFileSync(0);
        for (const item of input.toString("utf8").split("\0")) {
          if (!item) continue;
          let stats;
          try {
            stats = require("node:fs").statSync(item + "/.git", { bigint: true });
          } catch {
            process.exit(1);
          }
          process.stdout.write(
            crypto.createHash("sha256")
              .update(remote).update("\0")
              .update(item).update("\0")
              .update(String(stats.dev)).update("\0")
              .update(String(stats.ino)).update("\0")
              .update(String(stats.birthtimeNs))
              .digest("hex") + "\n",
          );
        }
      '
  )"; then
    printf 'worktree storage guard: could not fingerprint unmanaged temporary checkouts\n' >&2
    exit 1
  fi
  while IFS= read -r fingerprint; do
    [[ -z "$fingerprint" ]] && continue
    [[ "$fingerprint" =~ ^[0-9a-f]{64}$ ]] || {
      printf 'worktree storage guard: invalid unmanaged-checkout fingerprint\n' >&2
      exit 1
    }
    unmanaged_fingerprints+=("$fingerprint")
  done <<<"$unmanaged_hash_output"
  if (( ${#unmanaged_fingerprints[@]} != ${#unmanaged_candidates[@]} )); then
    printf 'worktree storage guard: incomplete unmanaged-checkout fingerprint inventory\n' >&2
    exit 1
  fi
fi

new_unmanaged=0
if [[ -f "$unmanaged_state_file" ]]; then
  if grep -Evq '^([0-9a-f]{40}|[0-9a-f]{64})$|^$' "$unmanaged_state_file"; then
    printf 'worktree storage guard: invalid unmanaged-checkout state\n' >&2
    exit 1
  fi
  if (( ${#unmanaged_fingerprints[@]} > 0 )); then
    for fingerprint in "${unmanaged_fingerprints[@]}"; do
      grep -Fxq "$fingerprint" "$unmanaged_state_file" || new_unmanaged=$((new_unmanaged + 1))
    done
  fi
fi
if (( new_unmanaged > 0 )); then
  if [[ -z "$current_worktree_path" ]]; then
    printf 'worktree storage guard: %d new unmanaged temporary checkout(s) bypassed scripts/create-worktree\n' \
      "$new_unmanaged" >&2
    exit 1
  fi
  printf 'worktree storage guard: warning: %d new unmanaged temporary checkout(s) remain outside scripts/create-worktree; global audit remains blocked\n' \
    "$new_unmanaged" >&2
else
  tmp_unmanaged_state="$unmanaged_state_file.tmp.$$"
  if (( ${#unmanaged_fingerprints[@]} > 0 )); then
    printf '%s\n' "${unmanaged_fingerprints[@]}" | LC_ALL=C sort -u >"$tmp_unmanaged_state"
  else
    : >"$tmp_unmanaged_state"
  fi
  mv "$tmp_unmanaged_state" "$unmanaged_state_file"
fi

if [[ -n "$target_path" ]]; then
  if [[ "$target_path" != /* ]]; then
    target_path="$repo_root/$target_path"
  fi
  target_probe="$target_path"
  while [[ ! -e "$target_probe" ]]; do
    parent_probe="$(dirname "$target_probe")"
    [[ "$parent_probe" != "$target_probe" ]] || break
    target_probe="$parent_probe"
  done
  [[ -e "$target_probe" ]] || {
    printf 'worktree storage guard: target filesystem could not be resolved\n' >&2
    exit 1
  }
  disk_paths+=("$target_probe")
fi

df_output="$(df -Pk "${disk_paths[@]}" 2>/dev/null)" || {
  printf 'worktree storage guard: could not read filesystem capacity\n' >&2
  exit 1
}
minimum_kib=$((min_free_gib * 1024 * 1024))
minimum_available_kib=''
disk_rows=0
disk_floor_failed=0
disk_capacity_rows="$(awk '
  NR > 1 {
    for (field = 1; field <= NF; field++) {
      if ($field ~ /^[0-9]+%$/ && field >= 4) {
        print $(field - 1)
        break
      }
    }
  }
' <<<"$df_output")"
while read -r available_kib; do
  [[ -n "$available_kib" ]] || continue
  if [[ ! "$available_kib" =~ ^[0-9]+$ ]]; then
    printf 'worktree storage guard: could not read filesystem capacity\n' >&2
    exit 1
  fi
  disk_rows=$((disk_rows + 1))
  if [[ -z "$minimum_available_kib" ]] || (( available_kib < minimum_available_kib )); then
    minimum_available_kib="$available_kib"
  fi
  if (( available_kib < minimum_kib )); then
    disk_floor_failed=1
  fi
done <<<"$disk_capacity_rows"
if (( disk_rows == 0 )); then
  printf 'worktree storage guard: could not read filesystem capacity\n' >&2
  exit 1
fi
if (( disk_floor_failed == 1 )); then
  available_gib=$((minimum_available_kib / 1024 / 1024))
  printf 'worktree storage guard: a worktree filesystem has only %d GiB free; require at least %d GiB free\n' \
    "$available_gib" "$min_free_gib" >&2
  exit 1
fi

if [[ -f "$state_file" ]]; then
  ceiling="$(tr -d '[:space:]' <"$state_file")"
  if [[ ! "$ceiling" =~ ^[0-9]+$ ]]; then
    printf 'worktree storage guard: invalid local ceiling state\n' >&2
    exit 1
  fi
  (( ceiling < max_regular )) && ceiling="$max_regular"
else
  ceiling="$regular_count"
  (( ceiling < max_regular )) && ceiling="$max_regular"
fi

if (( regular_count > ceiling )); then
  printf 'worktree storage guard: %d regular worktrees exceeds the ratcheted ceiling of %d\n' \
    "$regular_count" "$ceiling" >&2
  exit 1
fi

ratcheted="$regular_count"
(( ratcheted < max_regular )) && ratcheted="$max_regular"
(( ratcheted > ceiling )) && ratcheted="$ceiling"

prospective="$regular_count"
(( reserve == 1 )) && prospective=$((prospective + 1))
if (( prospective > ratcheted )); then
  printf 'worktree storage guard: new worktree would exceed the ratcheted ceiling of %d (regular=%d, data=%d)\n' \
    "$ratcheted" "$regular_count" "$data_count" >&2
  exit 1
fi

tmp_state="$state_file.tmp.$$"
printf '%d\n' "$ratcheted" >"$tmp_state"
mv "$tmp_state" "$state_file"

available_gib=$((minimum_available_kib / 1024 / 1024))
printf 'worktree storage guard: regular=%d data=%d ceiling=%d free=%dGiB unmanaged_temp=%d\n' \
  "$regular_count" "$data_count" "$ratcheted" "$available_gib" "${#unmanaged_fingerprints[@]}"
