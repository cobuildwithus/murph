#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage: retire-worktree [--dry-run] [--inactive-no-pr] [--contained-detached] <target-worktree>

Retires one clean, inactive task worktree after its exact PR head is confirmed
merged or closed, or its HEAD is already contained in origin/main. Run this
command from a different checkout of the same repo. The task branch is preserved.
Use --inactive-no-pr only when the current user explicitly authorizes retiring
clean inactive branches that have no open PR; all other safety gates still apply.
Use --contained-detached only for a clean detached checkout whose exact HEAD is
already contained in origin/main. No branch is deleted.
EOF
  exit 2
}

refuse() {
  printf 'retire-worktree: refusing: %s\n' "$1" >&2
  exit 1
}

dry_run=false
allow_inactive_no_pr=false
allow_contained_detached=false
while [[ "${1:-}" == --* ]]; do
  case "$1" in
    --dry-run) dry_run=true ;;
    --inactive-no-pr) allow_inactive_no_pr=true ;;
    --contained-detached) allow_contained_detached=true ;;
    *) usage ;;
  esac
  shift
done

if [[ $# -ne 1 ]]; then
  usage
fi

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root_dir"
current_worktree="$(pwd -P)"

if [[ ! -d "$1" ]]; then
  refuse 'target directory is missing'
fi
target_worktree="$(cd "$1" 2>/dev/null && pwd -P)" \
  || refuse 'target directory cannot be resolved'
target_label="$(basename "$target_worktree")"

current_common_dir="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
  || refuse 'current checkout is not a Git worktree'
target_common_dir="$(git -C "$target_worktree" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
  || refuse 'target is not a Git worktree'
current_common_dir="$(cd "$current_common_dir" 2>/dev/null && pwd -P)" \
  || refuse 'current Git metadata cannot be resolved'
target_common_dir="$(cd "$target_common_dir" 2>/dev/null && pwd -P)" \
  || refuse 'target Git metadata cannot be resolved'
if [[ "$current_common_dir" != "$target_common_dir" ]]; then
  refuse 'target belongs to a different repository'
fi

target_registered=false
target_head=''
target_branch_ref=''
target_locked=false
target_prunable=false
primary_worktree=''
nested_worktree=false

load_worktree_record() {
  local worktree_output record_path='' record_head='' record_branch=''
  local record_locked=false record_prunable=false canonical_record_path=''

  target_registered=false
  target_head=''
  target_branch_ref=''
  target_locked=false
  target_prunable=false
  primary_worktree=''
  nested_worktree=false

  process_record() {
    [[ -n "$record_path" ]] || return 0
    canonical_record_path="$record_path"
    if [[ -d "$record_path" ]]; then
      canonical_record_path="$(cd "$record_path" 2>/dev/null && pwd -P)" \
        || refuse 'a registered worktree path cannot be resolved'
    fi

    if [[ -z "$primary_worktree" ]]; then
      primary_worktree="$canonical_record_path"
    fi
    if [[ "$canonical_record_path" == "$target_worktree" ]]; then
      target_registered=true
      target_head="$record_head"
      target_branch_ref="$record_branch"
      target_locked="$record_locked"
      target_prunable="$record_prunable"
    elif [[ "$canonical_record_path" == "$target_worktree"/* ]]; then
      nested_worktree=true
    fi
  }

  worktree_output="$(git -c core.quotePath=false worktree list --porcelain 2>/dev/null)" \
    || refuse 'could not read the worktree registry'

  while IFS= read -r line || [[ -n "$line" ]]; do
    case "$line" in
      worktree\ *)
        process_record
        record_path="${line#worktree }"
        record_head=''
        record_branch=''
        record_locked=false
        record_prunable=false
        ;;
      HEAD\ *) record_head="${line#HEAD }" ;;
      branch\ *) record_branch="${line#branch }" ;;
      locked*) record_locked=true ;;
      prunable*) record_prunable=true ;;
    esac
  done <<< "$worktree_output"
  process_record
}

verify_registry_state() {
  load_worktree_record
  [[ "$target_registered" == true ]] || refuse 'target is not an exact registered worktree'
  [[ "$target_worktree" != "$current_worktree" ]] || refuse 'target is the current worktree'
  [[ "$target_worktree" != "$primary_worktree" ]] || refuse 'target is the primary worktree'
  [[ "$target_locked" == false ]] || refuse 'target worktree is locked'
  [[ "$target_prunable" == false ]] || refuse 'target worktree is marked prunable'
  [[ "$nested_worktree" == false ]] || refuse 'target contains another registered worktree'
  if [[ "$target_branch_ref" != refs/heads/* ]]; then
    [[ "$allow_contained_detached" == true && -z "$target_branch_ref" ]] \
      || refuse 'target is not backed by a local branch; use --contained-detached only for an exact origin/main-contained checkout'
  fi

  local current_head
  current_head="$(git -C "$target_worktree" rev-parse HEAD 2>/dev/null)" \
    || refuse 'target HEAD cannot be resolved'
  [[ "$target_head" == "$current_head" ]] || refuse 'target registry HEAD is stale'
}

verify_clean() {
  local status_output
  status_output="$(git -C "$target_worktree" status --porcelain=v1 \
    --untracked-files=all --ignore-submodules=none 2>/dev/null)" \
    || refuse 'target status cannot be inspected'
  [[ -z "$status_output" ]] || refuse 'target has tracked or untracked changes'
}

verify_no_active_task_reference() {
  local active_dir
  local -a active_dirs=(
    "$root_dir/agent-docs/exec-plans/active"
    "$target_worktree/agent-docs/exec-plans/active"
  )
  local branch_name="${target_branch_ref#refs/heads/}"
  local inspection_output inspection_status

  command -v node >/dev/null 2>&1 || refuse 'Node.js is unavailable'

  for active_dir in "${active_dirs[@]}"; do
    [[ -d "$active_dir" ]] || refuse 'active-plan registry is missing'
    if inspection_output="$(ACTIVE_DIR="$active_dir" TARGET_BRANCH="$branch_name" TARGET_LABEL="$target_label" \
      node <<'NODE'
const fs = require('node:fs');
const path = require('node:path');

const activeDir = process.env.ACTIVE_DIR;
const branch = process.env.TARGET_BRANCH ?? '';
const label = process.env.TARGET_LABEL ?? '';
if (!activeDir || !label) process.exit(12);

const normalize = (value) => value
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-+|-+$/g, '');
const needles = new Set([
  normalize(branch),
  normalize(branch.split('/').at(-1) ?? ''),
  normalize(label),
  normalize(label.replace(/^murph[-_]/i, '')),
]);
for (const needle of [...needles]) {
  if (needle.length < 8) needles.delete(needle);
}
if (needles.size === 0) process.exit(12);

const pending = [activeDir];
while (pending.length > 0) {
  const current = pending.pop();
  let entries;
  try {
    entries = fs.readdirSync(current, { withFileTypes: true });
  } catch {
    process.exit(12);
  }
  for (const entry of entries) {
    const entryPath = path.join(current, entry.name);
    if (entry.isDirectory()) {
      pending.push(entryPath);
      continue;
    }
    if (!entry.isFile() || entry.name === 'README.md') continue;
    let contents;
    try {
      contents = normalize(fs.readFileSync(entryPath, 'utf8'));
    } catch {
      process.exit(12);
    }
    if ([...needles].some((needle) => contents.includes(needle))) {
      process.stdout.write(path.relative(activeDir, entryPath));
      process.exit(10);
    }
  }
}
NODE
)"; then
      inspection_status=0
    else
      inspection_status=$?
    fi
    case "$inspection_status" in
      0) ;;
      10) refuse "target is still referenced by active task coordination: ${inspection_output:-unknown record}" ;;
      *) refuse 'active task coordination could not be inspected' ;;
    esac
  done
}

verify_terminal_history() {
  local branch_name="${target_branch_ref#refs/heads/}"
  local pr_json parser_status

  if [[ -z "$target_branch_ref" ]]; then
    git show-ref --verify --quiet refs/remotes/origin/main \
      || refuse 'origin/main is unavailable for detached contained-history proof'
    git merge-base --is-ancestor "$target_head" refs/remotes/origin/main 2>/dev/null \
      || refuse 'detached target HEAD is not contained in origin/main'
    return
  fi

  command -v gh >/dev/null 2>&1 || refuse 'GitHub CLI is unavailable'
  command -v node >/dev/null 2>&1 || refuse 'Node.js is unavailable'

  pr_json="$(gh pr list --state all --head "$branch_name" --limit 100 \
    --json headRefName,headRefOid,state,mergedAt,closedAt 2>/dev/null)" \
    || refuse 'GitHub PR state could not be read'

  if PR_JSON="$pr_json" TARGET_BRANCH="$branch_name" TARGET_HEAD="$target_head" \
    ALLOW_INACTIVE_NO_PR="$allow_inactive_no_pr" node <<'NODE'
let pullRequests;
try {
  pullRequests = JSON.parse(process.env.PR_JSON ?? '[]');
} catch {
  process.exit(12);
}
const branch = process.env.TARGET_BRANCH;
const head = process.env.TARGET_HEAD;
const allowInactiveNoPr = process.env.ALLOW_INACTIVE_NO_PR === 'true';

if (!Array.isArray(pullRequests) || !branch || !head) process.exit(12);

const branchPullRequests = pullRequests.filter(
  (pullRequest) => pullRequest?.headRefName === branch,
);
if (branchPullRequests.some((pullRequest) => pullRequest.state === 'OPEN')) {
  process.exit(10);
}

const exactTerminal = branchPullRequests.some((pullRequest) => {
  if (pullRequest?.headRefOid !== head) return false;
  if (pullRequest.state === 'MERGED') return Boolean(pullRequest.mergedAt);
  if (pullRequest.state === 'CLOSED') return Boolean(pullRequest.closedAt);
  return false;
});

process.exit(exactTerminal || allowInactiveNoPr ? 0 : 11);
NODE
  then
    return
  else
    parser_status=$?
  fi

  case "$parser_status" in
    10) refuse 'the target branch still has an open PR' ;;
    11)
      if ! git show-ref --verify --quiet refs/remotes/origin/main; then
        refuse 'origin/main is unavailable for contained-history proof'
      fi
      if git merge-base --is-ancestor "$target_head" refs/remotes/origin/main 2>/dev/null; then
        return
      fi
      refuse 'target HEAD has no terminal PR and is not contained in origin/main'
      ;;
    *) refuse 'GitHub PR state was malformed' ;;
  esac
}

path_is_within_target() {
  [[ "$1" == "$target_worktree" || "$1" == "$target_worktree"/* ]]
}

verify_no_process_cwd() {
  local platform line open_path accessible=0 snapshot=''
  platform="$(uname -s)"

  if [[ "$platform" == 'Linux' ]]; then
    shopt -s nullglob
    local cwd_link
    for cwd_link in /proc/[0-9]*/cwd; do
      if ! open_path="$(readlink "$cwd_link" 2>/dev/null)"; then
        continue
      fi
      accessible=$((accessible + 1))
      if path_is_within_target "$open_path"; then
        refuse 'a process has a working directory inside the target'
      fi
    done
    shopt -u nullglob
    (( accessible > 0 )) || refuse 'process working directories could not be inspected'
    return
  fi

  command -v lsof >/dev/null 2>&1 || refuse 'lsof is required to inspect process working directories'
  if ! snapshot="$(lsof -nP -a -u "$(id -u)" -d cwd -Fn 2>/dev/null)"; then
    refuse 'process working directories could not be inspected'
  fi
  while IFS= read -r line; do
    [[ "$line" == n* ]] || continue
    accessible=$((accessible + 1))
    open_path="${line#n}"
    if path_is_within_target "$open_path"; then
      refuse 'a process has a working directory inside the target'
    fi
  done <<< "$snapshot"
  (( accessible > 0 )) || refuse 'process working directories could not be inspected'
}

verify_primary_package_links() {
  local inspection_output inspection_status
  if inspection_output="$(PRIMARY_WORKTREE="$primary_worktree" TARGET_WORKTREE="$target_worktree" node <<'NODE'
const fs = require('node:fs');
const path = require('node:path');

const primary = process.env.PRIMARY_WORKTREE;
const target = process.env.TARGET_WORKTREE;
if (!primary || !target) process.exit(12);
const nodeModules = path.join(primary, 'node_modules');
if (!fs.existsSync(nodeModules)) process.exit(0);

const insideTarget = (candidate) => candidate === target || candidate.startsWith(target + path.sep);
const pending = [nodeModules];
try {
  while (pending.length > 0) {
    const directory = pending.pop();
    for (const entry of fs.readdirSync(directory, { withFileTypes: true })) {
      const entryPath = path.join(directory, entry.name);
      if (entry.isDirectory()) {
        pending.push(entryPath);
        continue;
      }
      if (!entry.isSymbolicLink()) continue;
      const lexicalTarget = path.resolve(path.dirname(entryPath), fs.readlinkSync(entryPath));
      let resolvedTarget = lexicalTarget;
      try {
        resolvedTarget = fs.realpathSync(entryPath);
      } catch {
        // A dangling link still carries enough lexical evidence to block.
      }
      if (insideTarget(lexicalTarget) || insideTarget(resolvedTarget)) {
        process.stdout.write(path.relative(primary, entryPath));
        process.exit(10);
      }
    }
  }
} catch {
  process.exit(12);
}
NODE
)"; then
    inspection_status=0
  else
    inspection_status=$?
  fi
  case "$inspection_status" in
    0) ;;
    10) refuse "primary dependency link resolves through the target: ${inspection_output:-unknown link}; reinstall the primary checkout before retirement" ;;
    *) refuse 'primary dependency links could not be inspected' ;;
  esac
}

verify_all_gates() {
  verify_registry_state
  verify_clean
  verify_no_active_task_reference
  verify_terminal_history
  verify_no_process_cwd
  verify_primary_package_links
}

verify_all_gates

if [[ "$dry_run" == true ]]; then
  printf 'retire-worktree: eligible; branch will be preserved\n'
  exit 0
fi

# Revalidate immediately before the destructive phase to narrow race windows.
verify_all_gates
quarantine_worktree="${target_worktree}.retiring-${target_head:0:12}"
[[ ! -e "$quarantine_worktree" && ! -L "$quarantine_worktree" ]] \
  || refuse 'worktree quarantine path already exists'
if ! git worktree move -- "$target_worktree" "$quarantine_worktree" >/dev/null 2>&1; then
  refuse 'worktree could not be moved into retirement quarantine'
fi
target_worktree="$quarantine_worktree"
if ! git worktree remove -- "$target_worktree" >/dev/null 2>&1; then
  refuse "non-force Git worktree removal did not finish; the registered checkout remains visibly quarantined as $(basename "$target_worktree")"
fi

if [[ "$target_branch_ref" == refs/heads/* ]]; then
  target_branch_ref="${target_branch_ref#refs/heads/}"
  if ! git show-ref --verify --quiet "refs/heads/$target_branch_ref"; then
    refuse 'worktree was removed but branch preservation could not be proved'
  fi
  printf 'retire-worktree: retired one task worktree; branch preserved\n'
else
  printf 'retire-worktree: retired one contained detached worktree; no branch changed\n'
fi
