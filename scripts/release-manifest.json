{
  "repositoryUrl": "https://github.com/cobuildwithus/murph",
  "primaryPackage": "@murphai/murph",
  "releaseArtifacts": {
    "changelogPath": "packages/cli/CHANGELOG.md",
    "releaseNotesDir": "packages/cli/release-notes"
  },
  "publicApiReleaseBoundary": {
    "minimumMajor": 2,
    "reason": "Private-media hardening removes the public experiment progress-card URL codec from @murphai/contracts; publishing that removal below 2.0.0 would break the released 1.2.x root API.",
    "removals": [
      {
        "package": "@murphai/contracts",
        "rootExports": [
          "EXPERIMENT_PROGRESS_CARD_MAX_ENCODED_LENGTH",
          "encodeExperimentProgressCard",
          "decodeExperimentProgressCard",
          "buildExperimentProgressCardPath"
        ]
      }
    ]
  },
  "packages": [
    {
      "name": "@murphai/contracts",
      "path": "packages/contracts"
    },
    {
      "name": "@murphai/hosted-execution",
      "path": "packages/hosted-execution"
    },
    {
      "name": "@murphai/gateway-core",
      "path": "packages/gateway-core"
    },
    {
      "name": "@murphai/murph",
      "path": "packages/cli"
    },
    {
      "name": "@murphai/openclaw-plugin",
      "path": "packages/openclaw-plugin"
    }
  ]
}
