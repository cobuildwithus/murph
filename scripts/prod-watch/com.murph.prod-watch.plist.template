<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- murph-prod-watch-managed:v1 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>unset NODE_ENV NODE_OPTIONS MURPH_PROD_WATCH_TEST_RUNTIME_ROOT TEST_PROVIDER_FIXTURE TEST_NODE_MODULES_SOURCE TEST_DIAGNOSIS_FIXTURE TEST_CODEX_EXTRA_MCP; export PATH=&quot;__SCHEDULER_PATH__&quot;; export CODEX_HOME=&quot;$HOME/.codex-5&quot;; export MURPH_PROD_WATCH_CODEX_PROFILE=&quot;prod-watch&quot;; export MURPH_PROD_WATCH_CODEX_BIN=&quot;__CODEX_EXECUTABLE__&quot;; export MURPH_PROD_WATCH_CODEX_SHA256=&quot;__CODEX_SHA256__&quot;; export MURPH_PROD_WATCH_RUNTIME_ROOT=&quot;$HOME/__RUNTIME_HOME_RELATIVE__&quot;; export MURPH_PROD_WATCH_APPROVED_HEAD=&quot;__APPROVED_HEAD__&quot;; cd &quot;$HOME/__REPO_HOME_RELATIVE__&quot; &amp;&amp; test &quot;$(git rev-parse HEAD)&quot; = &quot;$MURPH_PROD_WATCH_APPROVED_HEAD&quot; &amp;&amp; test -z &quot;$(git status --porcelain=v1 --untracked-files=no)&quot; &amp;&amp; exec &quot;__NODE_EXECUTABLE__&quot; &quot;$HOME/__REPO_HOME_RELATIVE__/node_modules/tsx/dist/cli.mjs&quot; --tsconfig &quot;$HOME/__REPO_HOME_RELATIVE__/tsconfig.tools.json&quot; &quot;$HOME/__REPO_HOME_RELATIVE__/scripts/prod-watch.ts&quot; run --scheduled --provider-child</string>
  </array>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
  <key>Nice</key>
  <integer>10</integer>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>ExitTimeOut</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>/dev/null</string>
</dict>
</plist>
