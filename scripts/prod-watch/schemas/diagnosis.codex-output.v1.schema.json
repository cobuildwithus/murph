{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "outcome",
    "causeCode",
    "component",
    "confidence"
  ],
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "likely_repo_issue",
        "external_or_operational",
        "insufficient_evidence",
        "no_action_needed"
      ]
    },
    "causeCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9._-]+$"
    },
    "component": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    }
  }
}
