#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"

case "${1:-}" in
  install|uninstall|status|scan|verify-permissions|run) ;;
  -h|--help|help)
    cat <<'EOF'
Usage: scripts/frog-autofix {install|uninstall|status|scan|verify-permissions|run} [options]

Commands:
  install [--codex-home <dir>]  Install and load the two-hour LaunchAgent.
  uninstall                     Unload the exact LaunchAgent and remove its local state.
  status                        Report loaded state and bounded metadata events.
  scan                          List eligible trusted Frog issue numbers without editing.
  verify-permissions             Prove the native worker filesystem and network boundary.
  run                           Process at most one eligible issue now.
EOF
    exit 0
    ;;
  *)
    echo "Usage: scripts/frog-autofix {install|uninstall|status|scan|verify-permissions|run} [options]" >&2
    exit 2
    ;;
esac

case "${1:-}" in
  install|uninstall|run)
    if [[ "${MURPH_FROG_AUTOFIX_NATIVE_LOCK_HELD:-}" != "1" ]]; then
      support_root="$HOME/Library/Application Support/Murph/FrogAutofix"
      if [[ -L "$support_root" ]]; then
        echo "Frog autofix support root must not be a symbolic link." >&2
        exit 2
      fi
      /bin/mkdir -p -m 700 "$support_root"
      /bin/chmod 700 "$support_root"
      native_gate="$support_root/run.native.lock"
      umask 077
      if [[ ! -e "$native_gate" ]]; then
        : >> "$native_gate"
      fi
      if [[ -L "$native_gate" || ! -f "$native_gate" ]]; then
        echo "Frog autofix native gate must be a regular file." >&2
        exit 2
      fi
      /bin/chmod 600 "$native_gate"
      exec /usr/bin/lockf -t 0 "$native_gate" \
        /usr/bin/env MURPH_FROG_AUTOFIX_NATIVE_LOCK_HELD=1 \
        "$repo_root/scripts/frog-autofix" "$@"
    fi
    ;;
esac

unset \
  DATABASE_URL \
  FROG_DATABASE_URL \
  FROG_NAMESPACE \
  FROG_SCHEMA \
  GH_TOKEN \
  GITHUB_TOKEN

case "${1:-}" in
  install|run)
    worktree_list="$(git -C "$repo_root" worktree list --porcelain)"
    primary_line="${worktree_list%%$'\n'*}"
    if [[ "$primary_line" != "worktree "* ]]; then
      echo "Primary worktree could not be resolved before dependency reconciliation." >&2
      exit 2
    fi
    primary_root="${primary_line#worktree }"
    primary_root="$(cd "$primary_root" && pwd -P)"
    if [[ "$repo_root" != "$primary_root" ]]; then
      echo "Mutating Frog autofix commands must run from the primary worktree." >&2
      exit 2
    fi
    if [[ -n "$(git -C "$primary_root" status --porcelain)" ]]; then
      echo "Primary worktree must be clean before dependency reconciliation." >&2
      exit 2
    fi
    /usr/bin/env node "$repo_root/scripts/frog-autofix-bootstrap" "$repo_root"
    ;;
esac

tsx_bin="$repo_root/node_modules/.bin/tsx"
if [[ ! -x "$tsx_bin" ]]; then
  echo "Frog autofix tooling is not installed; run pnpm install --frozen-lockfile." >&2
  exit 2
fi

cd "$repo_root"
exec "$tsx_bin" scripts/frog-autofix.ts "$@"
