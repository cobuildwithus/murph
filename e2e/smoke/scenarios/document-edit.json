{
  "id": "document-edit",
  "command": "vault-cli document edit <id> --vault <path> [--title <title>] [--note <text>] [--occurred-at <ts>] [--time-zone <zone>] [--day-key <YYYY-MM-DD>] [--tag <tag> ...] [--clear-title] [--clear-note] [--clear-time-zone] [--clear-day-key] [--clear-tags] [--day-key-policy keep|recompute] [--request-id <id>]",
  "vaultFixture": "fixtures/minimal-vault",
  "inputs": [
    "fixtures/minimal-vault/CORE.md"
  ],
  "goldenOutput": "fixtures/golden-outputs/document-import",
  "purpose": "Documents patching an existing imported document without changing its canonical ownership rules."
}
