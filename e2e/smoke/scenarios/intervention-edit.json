{
  "id": "intervention-edit",
  "command": "vault-cli intervention edit <id> --vault <path> [--title <title>] [--note <text>] [--occurred-at <ts>] [--time-zone <zone>] [--day-key <YYYY-MM-DD>] [--source <source>] [--tag <tag> ...] [--type <type>] [--duration <minutes>] [--regimen-id <id>] [--clear-title] [--clear-note] [--clear-time-zone] [--clear-day-key] [--clear-source] [--clear-tags] [--clear-duration] [--clear-regimen-id] [--day-key-policy keep|recompute] [--request-id <id>]",
  "vaultFixture": "fixtures/minimal-vault",
  "inputs": [
    "fixtures/minimal-vault/CORE.md"
  ],
  "goldenOutput": "fixtures/golden-outputs/intervention-add",
  "purpose": "Documents patching an existing intervention session while preserving the canonical event path."
}
