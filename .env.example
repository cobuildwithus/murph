# Murph does not auto-load dotenv files.
# If you want to use this file locally, source it explicitly in your shell:
#   set -a; source ./.env; set +a

# Composio connected apps (apps/web only; never forward this key to the runner)
COMPOSIO_API_KEY=
# COMPOSIO_BASE_URL=https://backend.composio.dev
# COMPOSIO_CONNECTED_APP_TOOLKITS=gmail,googlecalendar,outlook,zoho_mail,googledrive,one_drive,dropbox,googletasks,todoist,notion
# COMPOSIO_MAX_ACCOUNTS_PER_TOOLKIT=5

# Server-held credential for Composio OpenWeather tools
OPENWEATHER_API_KEY=

# Telegram bot integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_PREVIEW_CHAT_ID=

# Optional Telegram API overrides
# TELEGRAM_API_BASE_URL=
# TELEGRAM_FILE_BASE_URL=

# xAI x_search (Worker-held; the runner container only ever sees a sentinel)
XAI_API_KEY=

# Optional xAI x_search model override
# XAI_X_SEARCH_MODEL=grok-4.5

# Hosted Retell phone calls (apps/web only; never forward this key to the runner)
# RETELL_API_KEY=
# RETELL_FROM_NUMBER=
# RETELL_AGENT_ID=
# RETELL_AGENT_VERSION=prod
# RETELL_AGENT_DATA_STORAGE_SETTING=basic_attributes_only

# Optional local vault default for shell sessions
# VAULT=
