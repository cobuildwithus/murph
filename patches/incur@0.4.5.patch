+import { createRequire } from 'node:module'
+import type * as yaml from 'yaml'
+
+/** @internal Cached `yaml` module, loaded only by YAML-specific paths. */
+let cached: typeof yaml | undefined
+
+/** Synchronous loader for sync call paths such as Formatter.format and Skill.split. */
+export function loadSync(): typeof yaml {
+  cached ??= createRequire(import.meta.url)('yaml') as typeof yaml
+  return cached
+}
