+                | "gpt-6-sol"
+                | "gpt-6-luna"
+                | "gpt-6.2-astra"
+                | "gpt-5.6-luna"
+        ))
+    .then_some(crate::PromptCacheTtl::TwelveHours)
+}
diff --git a/codex-rs/core/src/client_tests.rs b/codex-rs/core/src/client_tests.rs
index f36687303c0919ccf589f40c503daea74d729ee9..b9357faed074ec18394161ea2fa957dc6815cdcb 100644
--- a/codex-rs/core/src/client_tests.rs
+++ b/codex-rs/core/src/client_tests.rs
@@ -3072,3 +3072,72 @@ async fn inference_tools_changes_follow_full_specs_across_turns() {
         );
     }
 }
+
+#[test]
+fn hosted_cache_retention_requires_explicit_reply_opt_in() {
+    use crate::responses_metadata::{CodexResponsesRequestKind, CompactionTurnMetadata};
+    use codex_analytics::{
+        CompactionImplementation, CompactionPhase, CompactionReason, CompactionTrigger,
+    };
+    let mut metadata = CodexResponsesMetadata::new(
+        "install".into(),
+        "session".into(),
+        "thread".into(),
+        "window".into(),
+    );
+    for model in [
+        "gpt-6.2-sol",
+        "gpt-6.1-terra",
+        "gpt-6-sol",
+        "gpt-6-luna",
+        "gpt-6.2-astra",
+        "gpt-5.6-luna",
+    ] {
+        metadata.request_kind = Some(CodexResponsesRequestKind::Turn);
+        for trigger in [
+            None,
+            Some("automation-cron"),
+            Some("unknown"),
+            Some("murph_conversation_reply_12h"),
+        ] {
+            metadata.turn_trigger = trigger.map(str::to_owned);
+            let expected =
+                (trigger == Some("murph_conversation_reply_12h")).then_some(crate::PromptCacheTtl::TwelveHours);
+            assert_eq!(
+                super::hosted_prompt_cache_ttl(model, true, true, &metadata),
+                expected
+            );
+        }
+        assert_eq!(
+            super::hosted_prompt_cache_ttl(model, true, false, &metadata),
+            None
+        );
+        assert_eq!(
+            super::hosted_prompt_cache_ttl(model, false, true, &metadata),
+            None
+        );
+        for phase in [
+            CompactionPhase::StandaloneTurn,
+            CompactionPhase::PreTurn,
+            CompactionPhase::MidTurn,
+        ] {
+            metadata.request_kind = Some(CodexResponsesRequestKind::Compaction(
+                CompactionTurnMetadata::new(
+                    CompactionTrigger::Manual,
+                    CompactionReason::UserRequested,
+                    CompactionImplementation::Responses,
+                    phase,
+                ),
+            ));
+            assert_eq!(
+                super::hosted_prompt_cache_ttl(model, true, true, &metadata),
+                None
+            );
+        }
+    }
+    metadata.request_kind = Some(CodexResponsesRequestKind::Turn);
+    assert_eq!(
+        super::hosted_prompt_cache_ttl("gpt-5.4", true, true, &metadata),
+        None
+    );
+}
