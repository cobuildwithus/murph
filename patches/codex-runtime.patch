+use super::MultitoolCli;
+use super::Subcommand;
+use clap::Parser;
+use pretty_assertions::assert_eq;
+
+#[test]
+fn app_server_user_config_isolation_is_explicit() {
+    for (args, expected) in [
+        (vec!["codex", "app-server"], false),
+        (vec!["codex", "app-server", "--ignore-user-config"], true),
+    ] {
+        let cli = MultitoolCli::try_parse_from(args).expect("parse app-server flags");
+        let Some(Subcommand::AppServer(app_server)) = cli.subcommand else {
+            panic!("expected app-server command");
+        };
+        assert_eq!(app_server.ignore_user_config, expected);
+    }
+}
