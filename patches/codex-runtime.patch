+                &base_file,
+                /*profile*/ None,
+                /*ignore_user_config*/ true,
+                retain,
+                /*strict_config*/ false,
+            )
+            .await?;
+            let expected: TomlValue = if retain {
+                toml::from_str(&format!("cli_auth_credentials_store = \"{store}\""))?
