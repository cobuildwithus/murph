diff --git a/codex-rs/app-server/src/user_config_auth_tests.rs b/codex-rs/app-server/src/user_config_auth_tests.rs
new file mode 100644
index 0000000000000000000000000000000000000000..fe33a111b92079c522b3fe37f8fd9fccdd4d5bc6
--- /dev/null
+++ b/codex-rs/app-server/src/user_config_auth_tests.rs
@@ -0,0 +1,165 @@
+//! Nextest runs this test in its own process: every keyring operation uses only
+//! this in-memory builder, installed before authentication is initialized.
+use crate::config_manager::ConfigManager;
+use codex_config::LoaderOverrides;
+use codex_config::NoopThreadConfigLoader;
+use codex_config::types::AuthCredentialsStoreMode;
+use codex_config::types::AuthKeyringBackendKind;
+use codex_login::AuthManager;
+use codex_login::login_with_api_key;
+use keyring::credential::Credential;
+use keyring::credential::CredentialApi;
+use keyring::credential::CredentialBuilderApi;
+use keyring::mock::MockCredential;
+use pretty_assertions::assert_eq;
+use std::any::Any;
+use std::collections::HashMap;
+use std::sync::Arc;
+use std::sync::Mutex;
+use tempfile::TempDir;
+
+#[derive(Default)]
+struct SyntheticKeyring(Mutex<HashMap<(String, String), Arc<MockCredential>>>);
+struct SharedCredential(Arc<MockCredential>);
+
+impl CredentialBuilderApi for SyntheticKeyring {
+    fn build(
+        &self,
+        _target: Option<&str>,
+        service: &str,
+        user: &str,
+    ) -> keyring::Result<Box<Credential>> {
+        let credential = self
+            .0
+            .lock()
+            .expect("synthetic keyring lock")
+            .entry((service.to_owned(), user.to_owned()))
+            .or_default()
+            .clone();
+        Ok(Box::new(SharedCredential(credential)))
+    }
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+impl CredentialApi for SharedCredential {
+    fn set_secret(&self, secret: &[u8]) -> keyring::Result<()> {
+        self.0.set_secret(secret)
+    }
+    fn get_secret(&self) -> keyring::Result<Vec<u8>> {
+        self.0.get_secret()
+    }
+    fn delete_credential(&self) -> keyring::Result<()> {
+        self.0.delete_credential()
+    }
+    fn as_any(&self) -> &dyn Any {
+        self
+    }
+}
+
+#[tokio::test]
+async fn isolated_startup_preserves_keyring_only_auth_and_managed_precedence() -> anyhow::Result<()>
+{
+    keyring::set_default_credential_builder(Box::<SyntheticKeyring>::default());
+    for backend in [
+        AuthKeyringBackendKind::Direct,
+        AuthKeyringBackendKind::Secrets,
+    ] {
+        let home = TempDir::new()?;
+        login_with_api_key(
+            home.path(),
+            "synthetic-keyring-only",
+            AuthCredentialsStoreMode::Keyring,
+            backend,
+        )?;
+        assert!(!home.path().join("auth.json").exists());
+        for store in ["keyring", "auto"] {
+            for isolated in [false, true] {
+                for constraint in [
+                    "none",
+                    "cli-file",
+                    "managed-file",
+                    "managed-login",
+                    "user-login",
+                ] {
+                    let user_login = if constraint == "user-login" {
+                        "forced_login_method = \"chatgpt\"\n"
+                    } else {
+                        ""
+                    };
+                    std::fs::write(
+                        home.path().join("config.toml"),
+                        format!(
+                            "cli_auth_credentials_store = \"{store}\"\ndeveloper_instructions = \"synthetic personal\"\nchatgpt_base_url = \"http://127.0.0.1:1/backend-api/\"\n{user_login}[features]\nsecret_auth_storage = {}\n",
+                            backend == AuthKeyringBackendKind::Secrets,
+                        ),
+                    )?;
+                    let managed = TempDir::new()?;
+                    let mut overrides = LoaderOverrides::with_managed_config_path_for_tests(
+                        managed.path().join("managed_config.toml"),
+                    );
+                    overrides.ignore_user_config = isolated;
+                    overrides.retain_user_auth_config = isolated;
+                    std::fs::write(
+                        managed.path().join("requirements.toml"),
+                        match constraint {
+                            "managed-file" => "cli_auth_credentials_store = \"file\"\n",
+                            "managed-login" => "allowed_login_methods = [\"chatgpt\"]\n",
+                            _ => "",
+                        },
+                    )?;
+                    let cli = if constraint == "cli-file" {
+                        vec![(
+                            "cli_auth_credentials_store".to_owned(),
+                            toml::Value::String("file".to_owned()),
+                        )]
+                    } else {
+                        vec![]
+                    };
+                    let manager = ConfigManager::new(
+                        home.path().to_path_buf(),
+                        cli,
+                        overrides,
+                        /*strict_config*/ false,
+                        Default::default(),
+                        Default::default(),
+                        Arc::new(NoopThreadConfigLoader),
+                    );
+                    let config = manager.load_startup_config(/*fallback_cwd*/ None).await?;
+                    assert_eq!(
+                        config.developer_instructions.as_deref(),
+                        if isolated {
+                            None
+                        } else {
+                            Some("synthetic personal")
+                        }
+                    );
+                    assert_eq!(config.chatgpt_base_url, "http://127.0.0.1:1/backend-api/");
+                    assert_eq!(config.auth_keyring_backend_kind(), backend);
+                    let expected_mode = match constraint {
+                        "cli-file" | "managed-file" => AuthCredentialsStoreMode::File,
+                        _ if store == "keyring" => AuthCredentialsStoreMode::Keyring,
+                        _ => AuthCredentialsStoreMode::Auto,
+                    };
+                    assert_eq!(config.cli_auth_credentials_store_mode, expected_mode);
+                    let auth = AuthManager::shared_from_config(
+                        &config, /*enable_codex_api_key_env*/ false,
+                    )
+                    .await?
+                    .auth()
+                    .await;
+                    assert_eq!(
+                        auth.as_ref().and_then(|auth| auth.api_key()),
+                        if constraint == "none" {
+                            Some("synthetic-keyring-only")
+                        } else {
+                            None
+                        }
+                    );
+                    assert!(!home.path().join("auth.json").exists());
+                }
+            }
+        }
+    }
+    Ok(())
+}
