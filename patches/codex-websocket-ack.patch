+++ b/codex-rs/codex-api/src/endpoint/responses_websocket_acknowledgement_tests.rs
@@ -0,0 +1,322 @@
+use super::*;
+use crate::common::ResponseCreateWsRequest;
+use codex_http_client::OutboundProxyPolicy::ReqwestDefault;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use tokio::net::TcpListener;
+use tokio_tungstenite::accept_async_with_config;
+
+const SHORT_ACKNOWLEDGEMENT_TIMEOUT: Duration = Duration::from_millis(200);
+const LONG_TIMEOUT: Duration = Duration::from_secs(30);
+
+/// One scripted reply: each event is sent after its delay. An empty reply leaves the
+/// request unanswered while the connection stays open, like a peer that vanished silently.
+type ScriptedReply = Vec<(Duration, Value)>;
+
+struct ScriptedServer {
+    url: Url,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for ScriptedServer {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+async fn start_scripted_server(replies: Vec<ScriptedReply>) -> ScriptedServer {
+    let listener = TcpListener::bind("127.0.0.1:0")
+        .await
+        .expect("bind websocket server");
+    let address = listener.local_addr().expect("websocket server address");
+    let url = Url::parse(&format!("ws://{address}/v1/responses")).expect("websocket url");
+    let task = tokio::spawn(async move {
+        let (tcp, _) = listener.accept().await.expect("accept websocket");
+        let mut socket = accept_async_with_config(tcp, Some(websocket_config()))
+            .await
+            .expect("websocket handshake");
+        for reply in replies {
+            let Some(Ok(Message::Text(_))) = socket.next().await else {
+                return;
+            };
+            for (delay, event) in reply {
+                tokio::time::sleep(delay).await;
+                socket
+                    .send(Message::Text(event.to_string().into()))
+                    .await
+                    .expect("send scripted event");
+            }
+        }
+        // Keep the socket open without answering, so the client can only observe silence.
+        std::future::pending::<()>().await;
+    });
+    ScriptedServer { url, task }
+}
+
+async fn connect(
+    server: &ScriptedServer,
+    idle_timeout: Duration,
+    acknowledgement_timeout: Duration,
+) -> ResponsesWebsocketConnection {
+    let (stream, _status, server_reasoning_included, server_model) = connect_websocket(
+        server.url.clone(),
+        HeaderMap::new(),
+        &WebSocketConnector::new(&HttpClientFactory::new(ReqwestDefault))
+            .expect("configure websocket connector"),
+        /*turn_state*/ None,
+    )
+    .await
+    .expect("connect websocket");
+    let mut connection = ResponsesWebsocketConnection::new(
+        stream,
+        idle_timeout,
+        server_reasoning_included,
+        server_model,
+        /*telemetry*/ None,
+    );
+    connection.acknowledgement_timeout = acknowledgement_timeout;
+    connection
+}
+
+fn response_create_request() -> ResponsesWsRequest<'static> {
+    ResponsesWsRequest::ResponseCreate(ResponseCreateWsRequest {
+        model: "gpt-test",
+        previous_response_id: None,
+        input: &[],
+        tools: None,
+        tool_choice: "auto",
+        parallel_tool_calls: false,
+        reasoning: None,
+        store: false,
+        stream: true,
+        stream_options: None,
+        include: &[],
+        service_tier: None,
+        prompt_cache_key: None,
+        text: None,
+        generate: None,
+        client_metadata: None,
+        access_programs: None,
+    })
+}
+
+fn response_created(id: &str) -> Value {
+    json!({"type": "response.created", "response": {"id": id}})
+}
+
+fn response_completed(id: &str) -> Value {
+    json!({
+        "type": "response.completed",
+        "response": {
+            "id": id,
+            "usage": {
+                "input_tokens": 0,
+                "input_tokens_details": null,
+                "output_tokens": 0,
+                "output_tokens_details": null,
+                "total_tokens": 0
+            }
+        }
+    })
+}
+
+/// Streams one request and summarizes the lifecycle events until completion or failure.
+async fn stream_outcome(
+    connection: &ResponsesWebsocketConnection,
+    connection_reused: bool,
+) -> (Vec<String>, Duration) {
+    let started = Instant::now();
+    let mut stream = connection
+        .stream_request(
+            response_create_request(),
+            connection_reused,
+            /*turn_state*/ None,
+        )
+        .await
+        .expect("start websocket request");
+    let mut outcome = Vec::new();
+    while let Some(event) = stream.next().await {
+        match event {
+            Ok(ResponseEvent::Created { response_id }) => {
+                outcome.push(format!("created:{}", response_id.unwrap_or_default()));
+            }
+            Ok(ResponseEvent::Completed { response_id, .. }) => {
+                outcome.push(format!("completed:{response_id}"));
+                break;
+            }
+            Ok(_) => {}
+            Err(err) => {
+                outcome.push(format!("error:{err}"));
+                break;
+            }
+        }
+    }
+    (outcome, started.elapsed())
+}
+
+#[tokio::test]
+async fn reused_connection_without_acknowledgement_fails_before_idle_timeout() {
+    let server = start_scripted_server(vec![
+        vec![
+            (Duration::ZERO, response_created("resp-1")),
+            (Duration::ZERO, response_completed("resp-1")),
+        ],
+        Vec::new(),
+    ])
+    .await;
+    let connection = connect(&server, LONG_TIMEOUT, SHORT_ACKNOWLEDGEMENT_TIMEOUT).await;
+
+    let (first, _) = stream_outcome(&connection, /*connection_reused*/ false).await;
+    let (second, elapsed) = stream_outcome(&connection, /*connection_reused*/ true).await;
+
+    assert_eq!(
+        (first, second, connection.is_closed().await),
+        (
+            vec!["created:resp-1".to_string(), "completed:resp-1".to_string()],
+            vec![
+                "error:stream error: timeout waiting for websocket response acknowledgement"
+                    .to_string()
+            ],
+            true,
+        )
+    );
+    assert!(
+        elapsed >= SHORT_ACKNOWLEDGEMENT_TIMEOUT && elapsed < LONG_TIMEOUT / 2,
+        "acknowledgement timeout fired after {elapsed:?}"
+    );
+}
+
+#[tokio::test]
+async fn acknowledged_response_may_stay_silent_beyond_acknowledgement_timeout() {
+    let silence = SHORT_ACKNOWLEDGEMENT_TIMEOUT * 4;
+    let server = start_scripted_server(vec![vec![
+        (Duration::ZERO, response_created("resp-1")),
+        (silence, response_completed("resp-1")),
+    ]])
+    .await;
+    let connection = connect(&server, LONG_TIMEOUT, SHORT_ACKNOWLEDGEMENT_TIMEOUT).await;
+
+    let (outcome, elapsed) = stream_outcome(&connection, /*connection_reused*/ false).await;
+
+    assert_eq!(
+        outcome,
+        vec!["created:resp-1".to_string(), "completed:resp-1".to_string()]
+    );
+    assert!(elapsed >= silence, "response completed after {elapsed:?}");
+}
+
+#[tokio::test]
+async fn idle_timeout_still_bounds_unacknowledged_request_when_shorter() {
+    let idle_timeout = SHORT_ACKNOWLEDGEMENT_TIMEOUT;
+    let server = start_scripted_server(vec![Vec::new()]).await;
+    let connection = connect(&server, idle_timeout, LONG_TIMEOUT).await;
+
+    let (outcome, elapsed) = stream_outcome(&connection, /*connection_reused*/ false).await;
+
+    assert_eq!(
+        outcome,
+        vec!["error:stream error: idle timeout waiting for websocket".to_string()]
+    );
+    assert!(
+        elapsed >= idle_timeout && elapsed < LONG_TIMEOUT / 2,
+        "idle timeout fired after {elapsed:?}"
+    );
+}
+
+#[tokio::test]
+async fn acknowledged_cancellation_keeps_socket_reusable_after_acknowledgement_bound() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.expect("bind server");
+    let address = listener.local_addr().expect("server address");
+    let server = ScriptedServer {
+        url: Url::parse(&format!("ws://{address}/v1/responses")).expect("server url"),
+        task: tokio::spawn(async move {
+            let (tcp, _) = listener.accept().await.expect("accept websocket");
+            let mut socket = accept_async_with_config(tcp, Some(websocket_config()))
+                .await
+                .expect("websocket handshake");
+            assert!(matches!(socket.next().await, Some(Ok(Message::Text(_)))));
+            socket
+                .send(Message::Text(
+                    response_created("cancelled-1").to_string().into(),
+                ))
+                .await
+                .expect("send created");
+            let Some(Ok(Message::Text(interrupt))) = socket.next().await else {
+                panic!("expected response interrupt");
+            };
+            assert_eq!(
+                serde_json::from_str::<Value>(&interrupt).expect("interrupt json"),
+                json!({
+                    "type": "response.interrupt",
+                    "response_id": "cancelled-1",
+                    "mode": "discard_partial_items"
+                })
+            );
+            tokio::time::sleep(SHORT_ACKNOWLEDGEMENT_TIMEOUT * 4).await;
+            // Completion may precede the cancellation acknowledgement. Both are required
+            // before releasing the socket to the next request in the upstream protocol.
+            socket
+                .send(Message::Text(
+                    response_completed("cancelled-1").to_string().into(),
+                ))
+                .await
+                .expect("send completed");
+            socket
+                .send(Message::Text(
+                    json!({
+                        "type": "response.interrupt.accepted", "response_id": "cancelled-1"
+                    })
+                    .to_string()
+                    .into(),
+                ))
+                .await
+                .expect("send interrupt acknowledgement");
+            assert!(matches!(socket.next().await, Some(Ok(Message::Text(_)))));
+            socket
+                .send(Message::Text(response_created("next-2").to_string().into()))
+                .await
+                .expect("send next created");
+            socket
+                .send(Message::Text(
+                    response_completed("next-2").to_string().into(),
+                ))
+                .await
+                .expect("send next completed");
+            std::future::pending::<()>().await;
+        }),
+    };
+    let connection = connect(&server, LONG_TIMEOUT, SHORT_ACKNOWLEDGEMENT_TIMEOUT).await;
+    tokio::time::timeout(LONG_TIMEOUT, async {
+        let mut stream = connection
+            .stream_request(response_create_request(), false, None)
+            .await
+            .expect("start request");
+        assert!(matches!(
+            stream.next().await,
+            Some(Ok(ResponseEvent::Created { .. }))
+        ));
+        assert!(
+            stream
+                .interrupt
+                .take()
+                .expect("interrupt sender")
+                .send(ResponseInterrupt::Cancel {
+                    deadline: tokio::time::Instant::now() + LONG_TIMEOUT,
+                })
+                .is_ok()
+        );
+        assert!(matches!(
+            stream.next().await,
+            Some(Ok(ResponseEvent::Completed { .. }))
+        ));
+        assert!(stream.next().await.is_none());
+        assert!(!connection.is_closed().await);
+        let (outcome, _) = stream_outcome(&connection, true).await;
+        assert_eq!(
+            outcome,
+            vec!["created:next-2".to_string(), "completed:next-2".to_string()]
+        );
+    })
+    .await
+    .expect("cancellation and socket reuse finish");
+}
