+    }
+    const result = await sendBrowserCommand(
+      browserWsUrl,
+      'Target.closeTarget',
+      { targetId: normalizedTargetId },
+      cleanupDeadline
+    );
+    if (result?.success !== true) {
+      commandError = new Error(`Browser did not accept closure of target ${normalizedTargetId}`);
+    }
+  } catch (error) {
+    commandError = error;
+  }
+
+  let confirmationError = null;
+  do {
+    try {
+      const listed = await fetchJson(
+        '/json/list',
+        Math.max(1, cleanupDeadline - Date.now())
+      );
+      if (!Array.isArray(listed)) {
+        throw new Error('Browser target list was not an array');
+      }
+      const stillPresent = listed.some(
+        (entry) => String(entry?.id || '').trim() === normalizedTargetId
+      );
+      if (!stillPresent) return;
+      confirmationError = new Error(
+        `Browser target ${normalizedTargetId} remained present after close`
+      );
+    } catch (error) {
+      confirmationError = new Error(`Target absence check failed: ${errorMessage(error)}`);
+    }
+    if (Date.now() < cleanupDeadline) await sleep(100);
+  } while (Date.now() < cleanupDeadline);
+
+  const cleanupError = commandError && confirmationError
+    ? new Error(`${errorMessage(commandError)}; ${errorMessage(confirmationError)}`)
+    : commandError || confirmationError || new Error('Target absence was not confirmed');
+  throw createTargetCleanupFailure(normalizedTargetId, cleanupError);
