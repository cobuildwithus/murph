+# Consume both selected sides of a staged rename; the destination may have
+# changed again after git mv. Unrelated partial staging remains untouched.
+selected_rename_paths=()
+while IFS= read -r -d '' rename_status; do
+  IFS= read -r -d '' rename_source || break
+  if [[ "$rename_status" == R* ]]; then
+    IFS= read -r -d '' rename_destination || break
+    if contains_path "$rename_source" "${canonical_files[@]}" && contains_path "$rename_destination" "${canonical_files[@]}"; then
+      selected_rename_paths+=("$rename_source" "$rename_destination")
+    fi
+  fi
+done < <(GIT_INDEX_FILE="$original_index_snapshot" git -C "$repo_root" diff --cached --name-status -M -z "$comparison_tree" --)
