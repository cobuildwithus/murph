+
+describe('toErrorEnvelope', () => {
+  test('classifies parse errors without exposing tokens, values, paths, or causes', () => {
+    const privateMarker = 'private-marker-that-must-not-echo'
+    const error = new Errors.ParseError({
+      message: `Unknown flag: --${privateMarker}=sensitive-value`,
+      cause: new Error(`/private/path/${privateMarker}`),
+    })
+
+    const envelope = Errors.toErrorEnvelope(error)
+
+    expect(envelope).toEqual({
+      code: 'VALIDATION_ERROR',
+      message: 'The command arguments are invalid.',
+      retryable: false,
+      hint: 'Run the command with --help and correct its arguments or options.',
+      stage: 'validation',
+      fieldErrors: [
+        {
+          code: 'custom',
+          missing: false,
+          path: 'arguments',
+          expected: '',
+          received: 'invalid',
+          message: 'This field is invalid.',
+        },
+      ],
+    })
+    expect(JSON.stringify(envelope)).not.toContain(privateMarker)
+    expect(JSON.stringify(envelope)).not.toContain('sensitive-value')
+    expect(JSON.stringify(envelope)).not.toContain('/private/path')
+  })
+
+  test('classifies a missing config without exposing its path or cause', () => {
+    const privateMarker = 'private-marker-that-must-not-echo'
+    const error = new Errors.ParseError({
