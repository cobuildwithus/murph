+struct PublicHarness {
+    mcp: TestAppServer,
+    _home: TempDir,
+    responses: MockServer,
+    socket: PublicSideband,
+    thread_id: String,
+    call_capture: RealtimeCallRequestCapture,
+}
+
+impl PublicHarness {
+    async fn start(
+        responses: Vec<String>,
+        client_managed: bool,
+        client_managed_inputs: bool,
+    ) -> Result<Self> {
+        Self::start_with_initial_failure(
+            responses,
+            client_managed,
+            client_managed_inputs,
+            client_managed_inputs,
+            None,
+        )
+        .await
+    }
+
+    async fn start_with_initial_failure(
+        responses: Vec<String>,
+        client_managed: bool,
+        client_managed_inputs: bool,
+        flush_transcript_tail: bool,
+        initial_failure: Option<oneshot::Receiver<()>>,
+    ) -> Result<Self> {
+        let responses = create_mock_responses_server_sequence_unchecked(responses).await;
+        let call_capture = RealtimeCallRequestCapture::new();
+        Mock::given(method("POST"))
+            .and(path("/v1/live/sessions"))
+            .and(call_capture.clone())
+            .respond_with(ResponseTemplate::new(201).set_body_json(json!({
+                "session": {"id": "live_session_public"},
+                "transport": {"type": "webrtc", "sdp": "v=answer\r\n"},
+            })))
+            .mount(&responses)
+            .await;
+        let socket = PublicSideband::start(initial_failure).await?;
+        let home = TempDir::new()?;
+        MockResponsesConfig::new(&responses.uri())
+            .with_sandbox_mode("danger-full-access")
+            .with_provider_config("requires_openai_auth = true")
+            .with_root_config(&format!(
+                "experimental_realtime_ws_base_url = {:?}\nexperimental_realtime_ws_startup_context = \"startup context\"",
+                socket.uri,
+            ))
+            .with_extra_config("[features]\nrealtime_conversation = true\n[realtime]\nversion = \"v3\"\ntype = \"conversational\"")
+            .write(home.path())?;
+        let mut mcp = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+            .await?;
+        login_with_api_key(&mut mcp, "sk-test-key").await?;
+        let request = mcp
+            .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+            .await?;
+        let thread: ThreadStartResponse =
+            timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+        let thread_id = thread.thread.id;
+        let request = mcp
+            .send_thread_realtime_start_request(ThreadRealtimeStartParams {
+                client_managed_inputs,
+                backend_reasoning_status: false,
+                thread_id: thread_id.clone(),
+                client_managed_handoffs: Some(client_managed),
+                delegation_ack_filler: None,
+                flush_transcript_tail_on_session_end: Some(flush_transcript_tail),
+                codex_response_item_prefix: None,
+                codex_response_handoff_mode: Some(CodexResponseHandoffMode::BemTags),
+                codex_response_handoff_channel_prefixes: None,
+                codex_responses_as_items: None,
+                model: None,
+                output_modality: RealtimeOutputModality::Audio,
+                include_startup_context: None,
+                initial_items: None,
+                realtime_start_instructions: None,
+                realtime_end_instructions: None,
+                prompt: Some(Some("backend prompt".to_string())),
+                realtime_session_id: None,
+                transport: Some(ThreadRealtimeStartTransport::Webrtc {
+                    sdp: "v=offer\r\n".to_string(),
+                }),
+                version: Some(RealtimeConversationVersion::V3),
+                voice: None,
+            })
+            .await?;
+        let response: ThreadRealtimeStartResponse =
+            timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+        assert_eq!(response.client_managed_inputs, client_managed_inputs);
+        let _: ThreadRealtimeStartedNotification =
+            read_notification(&mut mcp, "thread/realtime/started").await?;
+        let sdp: ThreadRealtimeSdpNotification =
+            read_notification(&mut mcp, "thread/realtime/sdp").await?;
+        assert_eq!(sdp.sdp, "v=answer\r\n");
+        Ok(Self {
+            mcp,
+            _home: home,
+            responses,
+            socket,
+            thread_id,
+            call_capture,
+        })
+    }
+
+    fn delegate(&self, id: &str, fragments: &[(&str, &str)]) -> Result<()> {
+        for (index, (speaker, delta)) in fragments.iter().enumerate() {
+            self.socket.send.send(Some(json!({
+                "type": format!("session.{speaker}_transcript.delta"),
+                "delta": delta, "start_ms": index * 100, "end_ms": (index + 1) * 100,
+            })))?;
+        }
+        self.socket.send.send(Some(json!({
+            "type": "session.delegation.created", "offset_ms": fragments.len() * 100,
+            "delegation": {"id": id, "type": "delegation", "target": "client"},
+        })))?;
+        Ok(())
+    }
+
+    async fn stop(&mut self) -> Result<()> {
+        let request = self
+            .mcp
+            .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+                thread_id: self.thread_id.clone(),
+            })
+            .await?;
+        // Stop waits for the owner to drain; acknowledge through the provider first.
+        assert_eq!(
+            self.socket.next_request().await?,
+            json!({"type": "session.close"})
+        );
+        self.socket
+            .send
+            .send(Some(public_closed(15.75, "close_requested")))?;
+        let _: ThreadRealtimeStopResponse =
+            timeout(DEFAULT_TIMEOUT, self.mcp.read_response(request)).await??;
+        assert_eq!(
+            read_public_item(&mut self.mcp, "session.closed").await?,
+            public_closed(15.75, "close_requested")
+        );
+        let _: ThreadRealtimeClosedNotification =
+            read_notification(&mut self.mcp, "thread/realtime/closed").await?;
+        Ok(())
+    }
+
+    async fn shutdown(mut self) -> Result<()> {
+        self.call_capture.single_request(); // No replacement paid session or fallback endpoint.
+        self.mcp.shutdown_gracefully().await?;
+        timeout(DEFAULT_TIMEOUT, self.socket.task).await??;
+        Ok(())
+    }
+}
