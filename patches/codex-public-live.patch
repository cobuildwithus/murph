+#[tokio::test]
+async fn public_live_managed_inputs_leave_backing_work_to_normal_turn_apis() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = PublicHarness::start(
+        vec![
+            create_final_assistant_message_sse_response("first host result")?,
+            create_final_assistant_message_sse_response("second host result")?,
+        ],
+        /*client_managed*/ true,
+        /*client_managed_inputs*/ true,
+    )
+    .await?;
+    let mut input_ids = Vec::new();
+    for index in 0..2 {
+        harness.delegate(
+            &format!("managed_{index}"),
+            &[
+                ("input", "Check Friday. "),
+                ("output", "For Friday? "),
+                ("input", "Actually Thursday, not Friday."),
+            ],
+        )?;
+        let input = read_public_item(&mut harness.mcp, "input.requested").await?;
+        let text = input["text"].as_str().context("normalized input")?;
+        assert!(text.contains("Actually Thursday, not Friday."));
+        assert!(text.contains("<input>user: Check Friday."));
+        assert!(text.contains("assistant: For Friday?"));
+        assert!(
+            !text.contains(&format!("managed_{index}")),
+            "transport metadata is not task text"
+        );
+        assert_eq!(
+            input["source"],
+            json!({"type": "handoff", "handoffId": format!("managed_{index}")})
+        );
+        let input_id = input["inputId"].as_str().context("native input id")?;
+        Uuid::parse_str(input_id)?;
+        input_ids.push(input_id.to_string());
+        assert_eq!(responses_requests(&harness.responses).await?.len(), index);
+        // The client supplies its normal prepared context before provider work.
+        let prepared = format!("Host context for accepted input {index}\n{text}");
+        let request = harness
+            .mcp
+            .send_turn_start_request(TurnStartParams {
+                thread_id: harness.thread_id.clone(),
+                input: vec![V2UserInput::Text {
+                    text: prepared.clone(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+        let _: TurnStartResponse =
+            timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+        let completed: TurnCompletedNotification =
+            read_notification(&mut harness.mcp, "turn/completed").await?;
+        assert_eq!(
+            completed.turn.status,
+            codex_app_server_protocol::TurnStatus::Completed
+        );
+        assert!(response_request_contains_text(
+            &responses_requests(&harness.responses).await?[index],
+            &prepared
+        ));
+    }
+    assert_ne!(input_ids[0], input_ids[1]);
+    // A final un-delegated transcript is delivered as input, never auto-executed.
+    harness.socket.send.send(Some(json!({
+        "type": "session.input_transcript.delta", "delta": "One final unsubmitted request.",
+        "start_ms": 900, "end_ms": 950,
+    })))?;
+    let request = harness
+        .mcp
+        .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+            thread_id: harness.thread_id.clone(),
+        })
+        .await?;
+    assert_eq!(
+        harness.socket.next_request().await?,
+        json!({"type": "session.close"})
+    );
+    harness
+        .socket
+        .send
+        .send(Some(public_closed(15.75, "close_requested")))?;
+    let _: ThreadRealtimeStopResponse =
+        timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+    let tail = read_public_item(&mut harness.mcp, "input.requested").await?;
+    assert_eq!(tail["source"], json!({"type": "transcriptTail"}));
+    assert!(
+        tail["text"]
+            .as_str()
+            .context("tail text")?
+            .contains("One final unsubmitted request.")
+    );
+    let _: ThreadRealtimeClosedNotification =
+        read_notification(&mut harness.mcp, "thread/realtime/closed").await?;
+    assert_eq!(responses_requests(&harness.responses).await?.len(), 2);
