+#[test_case(PublicClosure::CleanupConfirmed, false; "failed first attach closes and drains usage")]
+#[test_case(PublicClosure::CleanupEof, false; "failed first attach cleanup EOF stays unconfirmed")]
+#[test_case(PublicClosure::CleanupTimeout, false; "failed first attach cleanup timeout stays bounded")]
+#[test_case(PublicClosure::CleanupConfirmed, true; "stop during failed first attach still closes")]
+#[tokio::test]
+async fn public_live_initial_attachment_failure(
+    closure: PublicClosure,
+    stop_during_attach: bool,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let (release, wait) = oneshot::channel();
+    let mut harness = PublicHarness::start_with_initial_failure(
+        Vec::new(),
+        /*client_managed*/ true,
+        /*client_managed_inputs*/ true,
+        /*flush_transcript_tail*/ false,
+        Some(wait),
+    )
+    .await?;
+    // Startup and browser SDP have completed while the first handshake is pending.
+    // Queue speech to prove cleanup never replays normal outbound work.
+    let request = harness
+        .mcp
+        .send_thread_realtime_append_speech_request(ThreadRealtimeAppendSpeechParams {
+            thread_id: harness.thread_id.clone(),
+            text: "queued speech must not be replayed".to_string(),
+        })
+        .await?;
+    let _: ThreadRealtimeAppendSpeechResponse =
+        timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+    if stop_during_attach {
+        harness
+            .mcp
+            .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+                thread_id: harness.thread_id.clone(),
+            })
+            .await?;
+    }
+    release.send(()).expect("initial handshake pending");
+    assert_eq!(
+        harness.socket.next_request().await?,
+        json!({"type": "session.close"})
+    );
+    match closure {
+        PublicClosure::CleanupConfirmed => {
+            harness.delegate(
+                "cleanup_delegation",
+                &[("input", "Do not admit this cleanup input.")],
+            )?;
+            harness
+                .socket
+                .send
+                .send(Some(public_closed(8.25, "close_requested")))?;
+        }
+        PublicClosure::CleanupEof => harness.socket.send.send(None)?,
+        PublicClosure::CleanupTimeout => {}
+        PublicClosure::ProviderClosed => unreachable!(),
+    }
+    let mut final_usage = false;
+    let mut unconfirmed = false;
+    timeout(DEFAULT_TIMEOUT, async {
+        loop {
+            let JSONRPCMessage::Notification(notification) =
+                harness.mcp.read_next_message().await?
+            else {
+                continue;
+            };
+            match notification.method.as_str() {
+                "thread/realtime/itemAdded" => {
+                    let event: ThreadRealtimeItemAddedNotification =
+                        serde_json::from_value(notification.params.context("item params")?)?;
+                    assert_ne!(
+                        event.item["type"], "input.requested",
+                        "cleanup must not admit input"
+                    );
+                    if event.item["type"] == "session.closed" {
+                        assert_eq!(event.item, public_closed(8.25, "close_requested"));
+                        final_usage = true;
+                    }
+                }
+                "thread/realtime/error" => {
+                    let error: ThreadRealtimeErrorNotification =
+                        serde_json::from_value(notification.params.context("error params")?)?;
+                    assert!(
+                        error
+                            .message
+                            .contains("closure and final usage are unconfirmed")
+                    );
+                    unconfirmed = true;
+                }
+                "thread/realtime/closed" => break,
+                "turn/started" => panic!("cleanup must not start backing work"),
+                _ => {}
+            }
+        }
+        Ok::<(), anyhow::Error>(())
+    })
+    .await??;
+    assert_eq!(
+        final_usage,
+        matches!(closure, PublicClosure::CleanupConfirmed)
+    );
+    assert_eq!(unconfirmed, !final_usage);
+    assert_eq!(harness.socket.attachments.load(Ordering::SeqCst), 2);
+    assert!(
+        harness.socket.received.try_recv().is_err(),
+        "only one close, with no speech replay"
+    );
+    assert!(responses_requests(&harness.responses).await?.is_empty());
+    harness.shutdown().await
+}
+
+#[tokio::test]
+async fn public_live_managed_inputs_leave_backing_work_to_normal_turn_apis() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = PublicHarness::start(
+        vec![
+            create_final_assistant_message_sse_response("first host result")?,
+            create_final_assistant_message_sse_response("second host result")?,
+        ],
+        /*client_managed*/ true,
+        /*client_managed_inputs*/ true,
+    )
+    .await?;
+    let mut input_ids = Vec::new();
+    for index in 0..2 {
+        harness.delegate(
+            &format!("managed_{index}"),
+            &[
+                ("input", "Check Friday. "),
+                ("output", "For Friday? "),
+                ("input", "Actually Thursday, not Friday."),
+            ],
+        )?;
+        let input = read_public_item(&mut harness.mcp, "input.requested").await?;
+        let text = input["text"].as_str().context("normalized input")?;
+        assert!(text.contains("Actually Thursday, not Friday."));
+        assert!(text.contains("<input>user: Check Friday."));
+        assert!(text.contains("assistant: For Friday?"));
+        assert!(
+            !text.contains(&format!("managed_{index}")),
+            "transport metadata is not task text"
+        );
+        assert_eq!(
+            input["source"],
+            json!({"type": "handoff", "handoffId": format!("managed_{index}")})
+        );
+        let input_id = input["inputId"].as_str().context("native input id")?;
+        Uuid::parse_str(input_id)?;
+        input_ids.push(input_id.to_string());
+        assert_eq!(responses_requests(&harness.responses).await?.len(), index);
+        // The client supplies its normal prepared context before provider work.
+        let prepared = format!("Host context for accepted input {index}\n{text}");
+        let request = harness
+            .mcp
+            .send_turn_start_request(TurnStartParams {
+                thread_id: harness.thread_id.clone(),
+                input: vec![V2UserInput::Text {
+                    text: prepared.clone(),
+                    text_elements: Vec::new(),
+                }],
+                ..Default::default()
+            })
+            .await?;
+        let _: TurnStartResponse =
+            timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+        let completed: TurnCompletedNotification =
+            read_notification(&mut harness.mcp, "turn/completed").await?;
+        assert_eq!(
+            completed.turn.status,
+            codex_app_server_protocol::TurnStatus::Completed
+        );
+        assert!(response_request_contains_text(
+            &responses_requests(&harness.responses).await?[index],
+            &prepared
+        ));
+    }
+    assert_ne!(input_ids[0], input_ids[1]);
+    // A final un-delegated transcript is delivered as input, never auto-executed.
+    harness.socket.send.send(Some(json!({
+        "type": "session.input_transcript.delta", "delta": "One final unsubmitted request.",
+        "start_ms": 900, "end_ms": 950,
+    })))?;
+    let request = harness
+        .mcp
+        .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+            thread_id: harness.thread_id.clone(),
+        })
+        .await?;
+    assert_eq!(
+        harness.socket.next_request().await?,
+        json!({"type": "session.close"})
+    );
+    harness
+        .socket
+        .send
+        .send(Some(public_closed(15.75, "close_requested")))?;
+    let _: ThreadRealtimeStopResponse =
+        timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+    let tail = read_public_item(&mut harness.mcp, "input.requested").await?;
+    assert_eq!(tail["source"], json!({"type": "transcriptTail"}));
+    assert!(
+        tail["text"]
+            .as_str()
+            .context("tail text")?
+            .contains("One final unsubmitted request.")
+    );
+    let _: ThreadRealtimeClosedNotification =
+        read_notification(&mut harness.mcp, "thread/realtime/closed").await?;
+    assert_eq!(responses_requests(&harness.responses).await?.len(), 2);
+    harness.shutdown().await
+}
