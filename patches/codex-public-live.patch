+//! Real sideband sockets exercise native and host-managed input ownership.
+use super::*;
+use codex_app_server_protocol::JSONRPCMessage;
+use futures::SinkExt;
+use futures::StreamExt;
+use pretty_assertions::assert_eq;
+use std::sync::atomic::AtomicUsize;
+use std::sync::atomic::Ordering;
+use test_case::test_case;
+use tokio::net::TcpListener;
+use tokio::sync::mpsc as async_mpsc;
+use tokio::sync::oneshot;
+use tokio::task::JoinHandle;
+use tokio_tungstenite::accept_hdr_async;
+use tokio_tungstenite::tungstenite::Message;
+use tokio_tungstenite::tungstenite::handshake::server::Request;
+use tokio_tungstenite::tungstenite::handshake::server::Response;
+
+pub(super) fn public_closed(seconds: f64, reason: &str) -> Value {
+    json!({
+        "type": "session.closed",
+        "reason": reason,
+        "usage": {"seconds": seconds},
+        "session": {"id": "live_session_public", "model": "gpt-live-1"},
+    })
+}
+
+pub(super) async fn read_public_item(mcp: &mut TestAppServer, event_type: &str) -> Result<Value> {
+    loop {
+        let event: ThreadRealtimeItemAddedNotification =
+            read_notification(mcp, "thread/realtime/itemAdded").await?;
+        if event.item["type"] == event_type {
+            return Ok(event.item);
+        }
+    }
+}
+
+// Unlike the older request/response socket fixture, public Live can delegate
+// immediately after attach. No dummy append or admission handshake unlocks this server.
+struct PublicSideband {
+    uri: String,
+    send: async_mpsc::UnboundedSender<Option<Value>>,
+    received: async_mpsc::UnboundedReceiver<Value>,
+    task: JoinHandle<()>,
+    attachments: Arc<AtomicUsize>,
+}
+
+impl PublicSideband {
+    async fn start(initial_failure: Option<oneshot::Receiver<()>>) -> Result<Self> {
+        let listener = TcpListener::bind("127.0.0.1:0").await?;
+        let uri = format!("ws://{}", listener.local_addr()?);
+        let (send, mut send_rx) = async_mpsc::unbounded_channel::<Option<Value>>();
+        let (received_tx, received) = async_mpsc::unbounded_channel();
+        let attachments = Arc::new(AtomicUsize::new(0));
+        let attachment_count = attachments.clone();
+        let task = tokio::spawn(async move {
+            let successful_connections = if initial_failure.is_some() { 1 } else { 2 };
+            if let Some(release) = initial_failure {
+                let (stream, _) = listener.accept().await.expect("accept initial sideband");
+                attachment_count.fetch_add(1, Ordering::SeqCst);
+                release.await.expect("release failed handshake after SDP");
+                drop(stream);
+            }
+            for _ in 0..successful_connections {
+                let (stream, _) = listener.accept().await.expect("accept public sideband");
+                let mut socket =
+                    accept_hdr_async(stream, |request: &Request, response: Response| {
+                        assert_eq!(
+                            request.uri().to_string(),
+                            "/v1/live/sessions/live_session_public/attach"
+                        );
+                        assert_eq!(request.headers()["authorization"], "Bearer sk-test-key");
+                        assert!(request.headers().get("openai-alpha").is_none());
+                        Ok(response)
+                    })
+                    .await
+                    .expect("complete public sideband handshake");
+                attachment_count.fetch_add(1, Ordering::SeqCst);
+                loop {
+                    tokio::select! {
+                        event = send_rx.recv() => match event {
+                            Some(Some(value)) => {
+                                let closed = value["type"] == "session.closed";
+                                socket.send(Message::Text(value.to_string().into())).await.expect("send public event");
+                                if closed { return; }
+                            }
+                            // Deliberate transport loss, without a provider close record.
+                            Some(None) => break,
+                            None => return,
+                        },
+                        event = socket.next() => match event {
+                            Some(Ok(Message::Text(text))) => {
+                                received_tx.send(serde_json::from_str(&text).expect("decode public request")).expect("record public request");
+                            }
+                            Some(Ok(Message::Close(_))) | None => return,
+                            Some(Err(tokio_tungstenite::tungstenite::Error::Protocol(
+                                tokio_tungstenite::tungstenite::error::ProtocolError::ResetWithoutClosingHandshake
+                            ))) => return,
+                            Some(Err(error)) => panic!("unexpected client socket failure: {error}"),
+                            Some(Ok(_)) => {}
+                        }
+                    }
+                }
+            }
+        });
+        Ok(Self {
+            uri,
+            send,
+            received,
+            task,
+            attachments,
+        })
+    }
+
+    async fn next_request(&mut self) -> Result<Value> {
+        timeout(DELEGATED_SHELL_TURN_TIMEOUT, self.received.recv())
+            .await?
+            .context("public sideband ended before the expected request")
+    }
+}
+
+struct PublicHarness {
+    mcp: TestAppServer,
+    _home: TempDir,
+    responses: MockServer,
+    socket: PublicSideband,
+    thread_id: String,
+    call_capture: RealtimeCallRequestCapture,
+}
+
+impl PublicHarness {
+    async fn start(
+        responses: Vec<String>,
+        client_managed: bool,
+        client_managed_inputs: bool,
+    ) -> Result<Self> {
+        Self::start_with_initial_failure(
+            responses,
+            client_managed,
+            client_managed_inputs,
+            client_managed_inputs,
+            None,
+        )
+        .await
+    }
+
+    async fn start_with_initial_failure(
+        responses: Vec<String>,
+        client_managed: bool,
+        client_managed_inputs: bool,
+        flush_transcript_tail: bool,
+        initial_failure: Option<oneshot::Receiver<()>>,
+    ) -> Result<Self> {
+        let responses = create_mock_responses_server_sequence_unchecked(responses).await;
+        let call_capture = RealtimeCallRequestCapture::new();
+        Mock::given(method("POST"))
+            .and(path("/v1/live/sessions"))
+            .and(call_capture.clone())
+            .respond_with(ResponseTemplate::new(201).set_body_json(json!({
+                "session": {"id": "live_session_public"},
+                "transport": {"type": "webrtc", "sdp": "v=answer\r\n"},
+            })))
+            .mount(&responses)
+            .await;
+        let socket = PublicSideband::start(initial_failure).await?;
+        let home = TempDir::new()?;
+        MockResponsesConfig::new(&responses.uri())
+            .with_sandbox_mode("danger-full-access")
+            .with_provider_config("requires_openai_auth = true")
+            .with_root_config(&format!(
+                "experimental_realtime_ws_base_url = {:?}\nexperimental_realtime_ws_startup_context = \"startup context\"",
+                socket.uri,
+            ))
+            .with_extra_config("[features]\nrealtime_conversation = true\n[realtime]\nversion = \"v3\"\ntype = \"conversational\"")
+            .write(home.path())?;
+        let mut mcp = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .build_initialized_with_timeout(DEFAULT_TIMEOUT)
+            .await?;
+        login_with_api_key(&mut mcp, "sk-test-key").await?;
+        let request = mcp
+            .send_thread_start_request_with_auto_env(ThreadStartParams::default())
+            .await?;
+        let thread: ThreadStartResponse =
+            timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+        let thread_id = thread.thread.id;
+        let request = mcp
+            .send_thread_realtime_start_request(ThreadRealtimeStartParams {
+                client_managed_inputs,
+                thread_id: thread_id.clone(),
+                client_managed_handoffs: Some(client_managed),
+                delegation_ack_filler: None,
+                flush_transcript_tail_on_session_end: Some(flush_transcript_tail),
+                codex_response_item_prefix: None,
+                codex_response_handoff_mode: Some(CodexResponseHandoffMode::BemTags),
+                codex_response_handoff_channel_prefixes: None,
+                codex_responses_as_items: None,
+                model: None,
+                output_modality: RealtimeOutputModality::Audio,
+                include_startup_context: None,
+                initial_items: None,
+                realtime_start_instructions: None,
+                realtime_end_instructions: None,
+                prompt: Some(Some("backend prompt".to_string())),
+                realtime_session_id: None,
+                transport: Some(ThreadRealtimeStartTransport::Webrtc {
+                    sdp: "v=offer\r\n".to_string(),
+                }),
+                version: Some(RealtimeConversationVersion::V3),
+                voice: None,
+            })
+            .await?;
+        let response: ThreadRealtimeStartResponse =
+            timeout(DEFAULT_TIMEOUT, mcp.read_response(request)).await??;
+        assert_eq!(response.client_managed_inputs, client_managed_inputs);
+        let _: ThreadRealtimeStartedNotification =
+            read_notification(&mut mcp, "thread/realtime/started").await?;
+        let sdp: ThreadRealtimeSdpNotification =
+            read_notification(&mut mcp, "thread/realtime/sdp").await?;
+        assert_eq!(sdp.sdp, "v=answer\r\n");
+        Ok(Self {
+            mcp,
+            _home: home,
+            responses,
+            socket,
+            thread_id,
+            call_capture,
+        })
+    }
+
+    fn delegate(&self, id: &str, fragments: &[(&str, &str)]) -> Result<()> {
+        for (index, (speaker, delta)) in fragments.iter().enumerate() {
+            self.socket.send.send(Some(json!({
+                "type": format!("session.{speaker}_transcript.delta"),
+                "delta": delta, "start_ms": index * 100, "end_ms": (index + 1) * 100,
+            })))?;
+        }
+        self.socket.send.send(Some(json!({
+            "type": "session.delegation.created", "offset_ms": fragments.len() * 100,
+            "delegation": {"id": id, "type": "delegation", "target": "client"},
+        })))?;
+        Ok(())
+    }
+
+    async fn stop(&mut self) -> Result<()> {
+        let request = self
+            .mcp
+            .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+                thread_id: self.thread_id.clone(),
+            })
+            .await?;
+        // Stop waits for the owner to drain; acknowledge through the provider first.
+        assert_eq!(
+            self.socket.next_request().await?,
+            json!({"type": "session.close"})
+        );
+        self.socket
+            .send
+            .send(Some(public_closed(15.75, "close_requested")))?;
+        let _: ThreadRealtimeStopResponse =
+            timeout(DEFAULT_TIMEOUT, self.mcp.read_response(request)).await??;
+        assert_eq!(
+            read_public_item(&mut self.mcp, "session.closed").await?,
+            public_closed(15.75, "close_requested")
+        );
+        let _: ThreadRealtimeClosedNotification =
+            read_notification(&mut self.mcp, "thread/realtime/closed").await?;
+        Ok(())
+    }
+
+    async fn shutdown(mut self) -> Result<()> {
+        self.call_capture.single_request(); // No replacement paid session or fallback endpoint.
+        self.mcp.shutdown_gracefully().await?;
+        timeout(DEFAULT_TIMEOUT, self.socket.task).await??;
+        Ok(())
+    }
+}
