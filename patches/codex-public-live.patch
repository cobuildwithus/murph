+#[tokio::test]
+async fn isolated_user_config_retains_only_auth_store_in_original_layers() -> anyhow::Result<()> {
+    let tmp = tempdir()?;
+    let base_file = AbsolutePathBuf::from_absolute_path(tmp.path().join(CONFIG_TOML_FILE))?;
+    for store in ["file", "keyring", "auto"] {
+        std::fs::write(
+            base_file.as_path(),
+            format!(
+                "cli_auth_credentials_store = \"{store}\"\ndeveloper_instructions = \"personal\"\n[permissions.personal.filesystem]\n\"/synthetic-grant\" = \"read\"\n"
+            ),
+        )?;
+        for retain in [false, true] {
+            let layer = load_user_config_layer(
+                &TestFileSystem,
+                &base_file,
+                /*profile*/ None,
+                /*ignore_user_config*/ true,
+                retain,
+                /*strict_config*/ false,
+            )
+            .await?;
+            let expected: TomlValue = if retain {
+                toml::from_str(&format!("cli_auth_credentials_store = \"{store}\""))?
+            } else {
+                TomlValue::Table(Default::default())
+            };
+            assert_eq!(layer.config, expected);
+        }
+    }
+    // The selected profile-v2 is a second user layer; only its store survives.
+    let selected = tmp.path().join("selected.toml");
+    std::fs::write(
+        &selected,
+        "cli_auth_credentials_store = \"keyring\"\ndeveloper_instructions = \"profile personal\"\n",
+    )?;
+    let managed = tmp.path().join("managed.toml");
+    for (cli, managed_store, expected) in [
+        (None, None, "keyring"),
+        (Some("file"), None, "file"),
+        (Some("file"), Some("auto"), "auto"),
+    ] {
+        let mut overrides = LoaderOverrides::without_managed_config_for_tests();
+        overrides.ignore_user_config = true;
+        overrides.retain_user_auth_config = true;
+        overrides.user_config_path = Some(AbsolutePathBuf::from_absolute_path(&selected)?);
+        overrides.user_config_profile = Some("selected".parse()?);
+        overrides.managed_config_path = Some(managed.clone());
+        std::fs::write(
+            &managed,
+            managed_store
+                .map(|value| format!("cli_auth_credentials_store = \"{value}\"\n"))
+                .unwrap_or_default(),
+        )?;
+        let cli = cli
+            .map(|value| {
+                (
+                    "cli_auth_credentials_store".to_string(),
+                    TomlValue::String(value.to_string()),
+                )
+            })
+            .into_iter()
+            .collect::<Vec<_>>();
+        let stack = load_config_layers_state(
+            &TestFileSystem,
+            tmp.path(),
+            /*cwd*/ None,
+            &cli,
+            overrides,
+            &crate::NoopThreadConfigLoader,
+        )
+        .await?;
+        assert_eq!(
+            stack.effective_config()["cli_auth_credentials_store"].as_str(),
+            Some(expected)
+        );
+        let user = stack.effective_user_config().expect("user config");
+        assert_eq!(
+            user,
+            toml::from_str::<TomlValue>("cli_auth_credentials_store = \"keyring\"")?
+        );
+    }
+    Ok(())
+}
