+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn responses_websocket_reused_connection_without_acknowledgement_fails_before_idle_timeout() {
+    skip_if_no_network!();
+
+    const STREAM_IDLE_TIMEOUT_MS: u64 = 120_000;
+    // The second request reaches a reused connection that never answers, like a peer that
+    // dropped without a close frame. That silence must not wait for the stream idle timeout.
+    let server = start_websocket_server_with_headers(vec![WebSocketConnectionConfig {
+        requests: vec![
+            vec![ev_response_created("resp-1"), ev_completed("resp-1")],
+            Vec::new(),
+        ],
+        response_headers: Vec::new(),
+        accept_delay: None,
+        close_after_requests: false,
+    }])
+    .await;
+    let mut provider = websocket_provider(&server);
+    provider.stream_idle_timeout_ms = Some(STREAM_IDLE_TIMEOUT_MS);
+    let harness = websocket_harness_with_provider_options(
+        provider,
+        /*runtime_metrics_enabled*/ false,
+        /*concurrent_reasoning_summaries_enabled*/ false,
+        /*enabled_features*/ &[],
+    )
+    .await;
+
+    {
+        let mut first_session = harness.client.new_session();
+        let prompt = prompt_with_input(vec![message_item("hello")]);
+        stream_until_complete(&mut first_session, &harness, &prompt).await;
+    }
+
+    let mut second_session = harness.client.new_session();
+    let prompt = prompt_with_input(vec![message_item("hello"), message_item("again")]);
+    let responses_metadata = turn_metadata(&harness, /*turn_id*/ None);
+    let mut second_stream = second_session
+        .stream(
+            &prompt,
+            &harness.model_info,
+            &harness.session_telemetry,
+            harness.effort.clone(),
+            harness.summary,
+            /*service_tier*/ None,
+            &responses_metadata,
+            &codex_rollout_trace::InferenceTraceContext::disabled(),
+        )
+        .await
+        .expect("websocket stream failed");
+    let error = tokio::time::timeout(Duration::from_millis(STREAM_IDLE_TIMEOUT_MS / 2), async {
+        while let Some(event) = second_stream.next().await {
+            if let Err(err) = event {
+                return err.to_string();
+            }
+        }
+        panic!("websocket stream ended without an error");
+    })
+    .await
+    .expect("unacknowledged request should fail before the stream idle timeout");
+
+    assert_eq!(
+        (error, server.handshakes().len(), server.single_connection().len()),
+        (
+            "stream disconnected before completion: timeout waiting for websocket response acknowledgement"
+                .to_string(),
+            1,
+            2,
+        )
+    );
+
+    server.shutdown().await;
+}
