+#[test_case(PublicClosure::CleanupConfirmed, false; "failed first attach closes and drains usage")]
+#[test_case(PublicClosure::CleanupEof, false; "failed first attach cleanup EOF stays unconfirmed")]
+#[test_case(PublicClosure::CleanupTimeout, false; "failed first attach cleanup timeout stays bounded")]
+#[test_case(PublicClosure::CleanupConfirmed, true; "stop during failed first attach still closes")]
+#[tokio::test]
+async fn public_live_initial_attachment_failure(
+    closure: PublicClosure,
+    stop_during_attach: bool,
+) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let (release, wait) = oneshot::channel();
+    let mut harness = PublicHarness::start_with_initial_failure(
+        Vec::new(),
+        /*client_managed*/ true,
+        /*client_managed_inputs*/ true,
+        /*flush_transcript_tail*/ false,
+        Some(wait),
+    )
+    .await?;
+    // Startup and browser SDP have completed while the first handshake is pending.
+    // Queue speech to prove cleanup never replays normal outbound work.
+    let request = harness
+        .mcp
+        .send_thread_realtime_append_speech_request(ThreadRealtimeAppendSpeechParams {
+            thread_id: harness.thread_id.clone(),
+            text: "queued speech must not be replayed".to_string(),
+        })
+        .await?;
+    let _: ThreadRealtimeAppendSpeechResponse =
+        timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+    if stop_during_attach {
+        harness
+            .mcp
+            .send_thread_realtime_stop_request(ThreadRealtimeStopParams {
+                thread_id: harness.thread_id.clone(),
+            })
+            .await?;
+    }
+    release.send(()).expect("initial handshake pending");
+    assert_eq!(
+        harness.socket.next_request().await?,
+        json!({"type": "session.close"})
+    );
+    match closure {
+        PublicClosure::CleanupConfirmed => {
+            harness.delegate(
+                "cleanup_delegation",
+                &[("input", "Do not admit this cleanup input.")],
+            )?;
+            harness
+                .socket
+                .send
+                .send(Some(public_closed(8.25, "close_requested")))?;
+        }
+        PublicClosure::CleanupEof => harness.socket.send.send(None)?,
+        PublicClosure::CleanupTimeout => {}
+        PublicClosure::ProviderClosed => unreachable!(),
+    }
+    let mut final_usage = false;
+    let mut unconfirmed = false;
+    timeout(DEFAULT_TIMEOUT, async {
+        loop {
+            let JSONRPCMessage::Notification(notification) =
+                harness.mcp.read_next_message().await?
+            else {
+                continue;
+            };
+            match notification.method.as_str() {
+                "thread/realtime/itemAdded" => {
+                    let event: ThreadRealtimeItemAddedNotification =
+                        serde_json::from_value(notification.params.context("item params")?)?;
+                    assert_ne!(
+                        event.item["type"], "input.requested",
+                        "cleanup must not admit input"
+                    );
+                    if event.item["type"] == "session.closed" {
+                        assert_eq!(event.item, public_closed(8.25, "close_requested"));
+                        final_usage = true;
+                    }
+                }
+                "thread/realtime/error" => {
+                    let error: ThreadRealtimeErrorNotification =
+                        serde_json::from_value(notification.params.context("error params")?)?;
+                    assert!(
+                        error
+                            .message
+                            .contains("closure and final usage are unconfirmed")
+                    );
+                    unconfirmed = true;
+                }
+                "thread/realtime/closed" => break,
+                "turn/started" => panic!("cleanup must not start backing work"),
+                _ => {}
+            }
+        }
+        Ok::<(), anyhow::Error>(())
+    })
+    .await??;
+    assert_eq!(
+        final_usage,
+        matches!(closure, PublicClosure::CleanupConfirmed)
+    );
+    assert_eq!(unconfirmed, !final_usage);
+    assert_eq!(harness.socket.attachments.load(Ordering::SeqCst), 2);
+    assert!(
+        harness.socket.received.try_recv().is_err(),
+        "only one close, with no speech replay"
+    );
+    assert!(responses_requests(&harness.responses).await?.is_empty());
+    harness.shutdown().await
+}
