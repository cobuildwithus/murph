+// Both normal stop and connecting-stop use this same lifetime owner. Do not close
+// the public socket before draining the provider's terminal record.
+async fn close_owned_session(
+    connection: &RealtimeWebsocketConnection,
+    event_parser: RealtimeEventParser,
+    events_tx: &Sender<RealtimeEvent>,
+) -> Result<(), ApiError> {
+    if event_parser != RealtimeEventParser::PublicLive {
+        return connection.close().await;
+    }
+    connection
+        .writer()
+        .send_payload(serde_json::json!({"type": "session.close"}).to_string())
+        .await?;
+    while let Some(event) = connection.next_event().await? {
+        let closed = matches!(
+            &event,
+            RealtimeEvent::ConversationItemAdded(item) if item["type"] == "session.closed"
+        );
+        // Stop is not a new native turn. Preserve late transcripts/usage but do not
+        // admit pending delegations while draining finalization.
+        if !matches!(event, RealtimeEvent::HandoffRequested(_)) {
+            let _ = events_tx.send(event).await;
+        }
+        if closed {
+            // The caller drops this connection. Do not put the socket-close
+            // handshake inside the finalization timeout after confirmation.
+            return Ok(());
+        }
+    }
+    Err(ApiError::Stream(
+        "public Live socket ended before session.closed".to_string(),
+    ))
+}
