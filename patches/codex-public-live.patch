+#[cfg(test)]
+mod cache_lifetime_tests {
+    use super::*;
+    #[test]
+    fn preserves_mixed_lifetime_writes_and_legacy_usage() {
+        for twelve_hour in [None, Some(25)] {
+            let mut value = serde_json::json!({
+                "input_tokens": 100,
+                "input_tokens_details": { "cached_tokens": 20, "cache_write_tokens": 60 },
+                "output_tokens": 10, "total_tokens": 110
+            });
+            if let Some(count) = twelve_hour {
+                value["input_tokens_details"]["cache_write_tokens_details"] = serde_json::json!({
+                    "ttl_30m_tokens": 35, "ttl_12h_tokens": count
+                });
+            }
+            let usage =
+                TokenUsage::from(serde_json::from_value::<ResponseCompletedUsage>(value).unwrap());
+            assert_eq!(usage.cache_write_input_tokens, 60);
+            assert_eq!(usage.cache_write_12h_input_tokens, twelve_hour.unwrap_or(0));
+            let mut total = TokenUsage::default();
+            total.add_assign(&usage);
+            total.add_assign(&usage);
+            assert_eq!(
+                total.cache_write_12h_input_tokens,
+                twelve_hour.unwrap_or(0) * 2
+            );
+        }
+    }
+}
