+#[test_case(false; "native result forwarding")]
+#[test_case(true; "client managed results still run native tools")]
+#[tokio::test]
+async fn public_live_two_tool_backed_turns_without_host_turn_start(
+    client_managed: bool,
+) -> Result<()> {
+    skip_if_remote!(
+        Ok(()),
+        "delegated shell command cwd is only materialized on the host"
+    );
+    skip_if_no_network!(Ok(()));
+    let mut harness = PublicHarness::start(
+        vec![
+            create_command_execution_sse_response(
+                realtime_tool_ok_command(),
+                /*workdir*/ None,
+                Some(DELEGATED_SHELL_TOOL_TIMEOUT_MS),
+                "public_shell_1",
+            )?,
+            create_final_assistant_message_sse_response("first check finished")?,
+            create_command_execution_sse_response(
+                realtime_tool_ok_command(),
+                /*workdir*/ None,
+                Some(DELEGATED_SHELL_TOOL_TIMEOUT_MS),
+                "public_shell_2",
+            )?,
+            create_final_assistant_message_sse_response("second check finished")?,
+        ],
+        client_managed,
+        /*client_managed_inputs*/ false,
+    )
+    .await?;
+    let mut turns = Vec::new();
+    for (index, text) in ["first check finished", "second check finished"]
+        .into_iter()
+        .enumerate()
+    {
+        let delegation_id = format!("delegation_{}", index + 1);
+        if index == 0 {
+            harness.delegate(
+                &delegation_id,
+                &[
+                    ("input", "Run the shell check for Friday. "),
+                    ("output", "For Friday? "),
+                    ("input", "Actually Thursday, not Friday."),
+                ],
+            )?;
+        } else {
+            harness.delegate(
+                &delegation_id,
+                &[("input", "Yes, run that same check again.")],
+            )?;
+        }
+        let completed = wait_for_completed_command_execution(&mut harness.mcp).await?;
+        let ThreadItem::CommandExecution {
+            id,
+            status,
+            aggregated_output,
+            ..
+        } = completed.item
+        else {
+            unreachable!("helper returns command execution items");
+        };
+        assert_eq!(
+            (id, status, aggregated_output),
+            (
+                format!("public_shell_{}", index + 1),
+                CommandExecutionStatus::Completed,
+                Some("realtime-tool-ok".to_string()),
+            )
+        );
+        let completed: TurnCompletedNotification = read_notification_with_timeout(
+            &mut harness.mcp,
+            "turn/completed",
+            DELEGATED_SHELL_TURN_TIMEOUT,
+        )
+        .await?;
+        turns.push(completed.turn.id);
+        if !client_managed {
+            let mut spoken = String::new();
+            while spoken.len() < text.len() {
+                let append = harness.socket.next_request().await?;
+                assert_eq!(append["type"], "session.commentary.append");
+                assert_eq!(append["delegation_id"], delegation_id);
+                spoken.push_str(
+                    append["content"]
+                        .as_str()
+                        .context("public append must contain a string")?,
+                );
+            }
+            assert_eq!(spoken, text);
+        }
+    }
+    assert_ne!(
+        turns[0], turns[1],
+        "two distinct native turns, not one host-steered turn"
+    );
+    let requests = responses_requests(&harness.responses).await?;
+    assert_eq!(requests.len(), 4);
+    for request in [&requests[0], &requests[2]] {
+        assert!(response_request_contains_text(
+            request,
+            "Run the shell check for Friday."
+        ));
+        assert!(response_request_contains_text(
+            request,
+            "Actually Thursday, not Friday."
+        ));
+        assert!(response_request_contains_text(
+            request,
+            "<transcript_delta>"
+        ));
+        assert!(
+            !response_request_contains_text(request, "<input>"),
+            "public metadata supplied no task text"
+        );
+    }
+    assert!(response_request_contains_text(
+        &requests[2],
+        "Yes, run that same check again."
+    ));
+    for request in [&requests[1], &requests[3]] {
+        assert!(response_request_contains_text(request, "realtime-tool-ok"));
+    }
+
+    // Explicit speech works even with clientManagedHandoffs. It also acts as an
+    // ordered barrier: no automatic output may precede it in the managed case.
+    let request = harness
+        .mcp
+        .send_thread_realtime_append_speech_request(ThreadRealtimeAppendSpeechParams {
+            thread_id: harness.thread_id.clone(),
+            text: "host-approved result".to_string(),
+        })
+        .await?;
+    let _: ThreadRealtimeAppendSpeechResponse =
+        timeout(DEFAULT_TIMEOUT, harness.mcp.read_response(request)).await??;
+    assert_eq!(
+        harness.socket.next_request().await?,
+        json!({
+            "type": "session.commentary.append", "delegation_id": null, "content": "host-approved result",
+        })
+    );
+    for seconds in [12, 15] {
+        let usage = json!({"type": "session.usage.updated", "usage": {"seconds": seconds}});
+        harness.socket.send.send(Some(usage.clone()))?;
+        assert_eq!(
+            read_public_item(&mut harness.mcp, "session.usage.updated").await?,
+            usage
+        );
+    }
+    harness.stop().await?;
+    harness.shutdown().await
+}
