+#[derive(Clone, Copy)]
+enum PublicClosure {
+    ProviderClosed,
+    CleanupConfirmed,
+    CleanupEof,
+    CleanupTimeout,
+}
+
+#[test_case(PublicClosure::ProviderClosed; "provider final usage survives subsequent EOF")]
+#[test_case(PublicClosure::CleanupConfirmed; "sideband loss closes the same call and drains final usage")]
+#[test_case(PublicClosure::CleanupEof; "cleanup EOF remains unconfirmed")]
+#[test_case(PublicClosure::CleanupTimeout; "cleanup timeout remains unconfirmed")]
+#[tokio::test]
+async fn public_live_transport_loss_and_final_usage(closure: PublicClosure) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let mut harness = PublicHarness::start(
+        Vec::new(),
+        /*client_managed*/ false,
+        /*client_managed_inputs*/ false,
+    )
+    .await?;
+    let usage = json!({"type": "session.usage.updated", "usage": {"seconds": 7.5}});
+    harness.socket.send.send(Some(usage.clone()))?;
+    assert_eq!(
+        read_public_item(&mut harness.mcp, "session.usage.updated").await?,
+        usage
+    );
+    let provider_closed = matches!(closure, PublicClosure::ProviderClosed);
+    if !provider_closed {
+        harness.socket.send.send(None)?;
+        assert_eq!(
+            harness.socket.next_request().await?,
+            json!({"type": "session.close"}),
+            "the only replacement attachment is close-only"
+        );
+    }
+    match closure {
+        PublicClosure::ProviderClosed | PublicClosure::CleanupConfirmed => {
+            if !provider_closed {
+                // Cleanup must not admit a new backing turn while draining usage.
+                harness.socket.send.send(Some(json!({
+                    "type": "session.delegation.created",
+                    "offset_ms": 100,
+                    "delegation": {"id": "cleanup_delegation", "type": "delegation", "target": "client"},
+                })))?;
+            }
+            harness
+                .socket
+                .send
+                .send(Some(public_closed(8.25, "connection_lost")))?;
+            assert_eq!(
+                read_public_item(&mut harness.mcp, "session.closed").await?,
+                public_closed(8.25, "connection_lost")
+            );
+        }
+        PublicClosure::CleanupEof | PublicClosure::CleanupTimeout => {
+            if matches!(closure, PublicClosure::CleanupEof) {
+                harness.socket.send.send(None)?;
+            }
+            let error: ThreadRealtimeErrorNotification =
+                read_notification(&mut harness.mcp, "thread/realtime/error").await?;
+            assert!(error.message.contains("live_session_public"));
+            assert!(
+                error
+                    .message
+                    .contains("closure and final usage are unconfirmed")
+            );
+        }
+    }
+    let _: ThreadRealtimeClosedNotification =
+        read_notification(&mut harness.mcp, "thread/realtime/closed").await?;
+    assert_eq!(
+        harness.socket.attachments.load(Ordering::SeqCst),
+        if provider_closed { 1 } else { 2 }
+    );
+    assert!(
+        harness.socket.received.try_recv().is_err(),
+        "no normal-input replay or repeated close"
+    );
+    assert!(
+        harness
+            .responses
+            .received_requests()
+            .await
+            .unwrap()
+            .iter()
+            .all(|request| request.url.path() != "/v1/responses"),
+        "cleanup must not start a new backing turn"
+    );
+    harness.shutdown().await
+}
