@@ -0,0 +1,21 @@
+use super::*;
+
+#[test]
+fn public_live_delegation_bounds_context_without_inventing_task_text() {
+    let transcript = format!(
+        "{}\nuser: correction: & <Thursday>",
+        "old transcript ".repeat(1000)
+    );
+    let body =
+        RealtimeDelegation::new("", Some(&transcript), RealtimeDelegationSource::Handoff).body();
+    assert!(!body.contains("<input>"));
+    assert!(body.ends_with("user: correction: &amp; &lt;Thursday&gt;</transcript_delta>\n"));
+    let content = body
+        .split_once("<transcript_delta>")
+        .unwrap()
+        .1
+        .split_once("</transcript_delta>")
+        .unwrap()
+        .0;
+    assert!(content.len() <= MAX_REALTIME_DELEGATION_FIELD_BYTES);
+}
