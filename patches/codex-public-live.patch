--- /dev/null
+++ b/codex-rs/codex-api/src/endpoint/realtime_websocket/public_live_tests.rs
@@ -0,0 +1,273 @@
+use super::*;
+use crate::provider::RetryConfig;
+use codex_protocol::protocol::RealtimeHandoffRequested;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use tokio::net::TcpListener;
+use tokio::time::timeout;
+use tokio_tungstenite::accept_hdr_async;
+use tokio_tungstenite::tungstenite::handshake::server::Request;
+use tokio_tungstenite::tungstenite::handshake::server::Response;
+
+const LIMIT: Duration = Duration::from_secs(5);
+
+#[tokio::test]
+async fn public_live_attach_collects_fragments_and_sends_plain_string_results() {
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let address = listener.local_addr().unwrap();
+    let output = "é".repeat(650);
+    let expected_output = output.clone();
+    let server = tokio::spawn(async move {
+        let (tcp, _) = listener.accept().await.unwrap();
+        let mut socket = accept_hdr_async(tcp, |request: &Request, response: Response| {
+            assert_eq!(
+                request.uri().to_string(),
+                "/gateway/v1/live/sessions/live_session_a%2Fb/attach?tenant=test"
+            );
+            assert_eq!(request.headers()["authorization"], "Bearer public-test-key");
+            assert_eq!(request.headers()["x-project"], "project-test");
+            Ok(response)
+        })
+        .await
+        .unwrap();
+        for event in [
+            json!({"type":"session.input_transcript.delta", "delta":"Check Friday ", "start_ms":0, "end_ms":100}),
+            json!({"type":"session.output_transcript.delta", "delta":"Which time?", "start_ms":50, "end_ms":150}),
+            json!({"type":"session.input_transcript.delta", "delta":"at two. Actually Thursday, not Friday.", "start_ms":101, "end_ms":300}),
+            json!({"type":"session.delegation.created", "offset_ms":301, "delegation":{"type":"delegation", "target":"client", "id":"item_first"}}),
+        ] {
+            socket
+                .send(Message::Text(event.to_string().into()))
+                .await
+                .unwrap();
+        }
+        // A public attach sends no startup/update/admission message. The first client
+        // frame is real backend progress, followed by the speakable result chunks.
+        let Message::Text(text) = socket.next().await.unwrap().unwrap() else {
+            panic!("expected progress")
+        };
+        assert_eq!(
+            serde_json::from_str::<Value>(&text).unwrap(),
+            json!({
+                "type":"session.thinking.append", "delegation_id":"item_first", "content":"Checking availability",
+            })
+        );
+        let mut received = String::new();
+        while received.len() < expected_output.len() {
+            let Message::Text(text) = socket.next().await.unwrap().unwrap() else {
+                panic!("expected result")
+            };
+            let value: Value = serde_json::from_str(&text).unwrap();
+            let content = value["content"].as_str().unwrap();
+            assert!(content.len() <= 500);
+            assert_eq!(
+                value,
+                json!({"type":"session.commentary.append", "delegation_id":"item_first", "content":content})
+            );
+            received.push_str(content);
+        }
+        assert_eq!(received, expected_output);
+        for event in [
+            json!({"type":"session.input_transcript.delta", "delta":"Yes, same time.", "start_ms":400, "end_ms":500}),
+            json!({"type":"session.delegation.created", "offset_ms":501, "delegation":{"type":"delegation", "target":"client", "id":"item_second"}}),
+            json!({"type":"session.usage.updated", "usage":{"seconds":12}}),
+            json!({"type":"session.usage.updated", "usage":{"seconds":15}}),
+            json!({"type":"session.closed", "reason":"connection_lost", "session":{"id":"live_session_a/b"}, "usage":{"seconds":15.75}}),
+        ] {
+            socket
+                .send(Message::Text(event.to_string().into()))
+                .await
+                .unwrap();
+        }
+        let _ = socket.close(None).await;
+    });
+    let provider = Provider {
+        name: "public test".to_string(),
+        base_url: format!("http://{address}/gateway/v1"),
+        query_params: Some(HashMap::from([("tenant".to_string(), "test".to_string())])),
+        headers: HeaderMap::from_iter([(
+            "x-project".parse().unwrap(),
+            "project-test".parse().unwrap(),
+        )]),
+        retry: RetryConfig {
+            max_attempts: 0,
+            base_delay: Duration::ZERO,
+            retry_429: false,
+            retry_5xx: false,
+            retry_transport: false,
+        },
+        stream_idle_timeout: LIMIT,
+    };
+    let connection = RealtimeWebsocketClient::new(provider)
+        .connect_webrtc_sideband(
+            RealtimeSessionConfig {
+                instructions: "test".to_string(),
+                initial_items: Vec::new(),
+                delegation_ack_filler: None,
+                model: Some("gpt-live-1".to_string()),
+                session_id: None,
+                event_parser: RealtimeEventParser::PublicLive,
+                session_mode: RealtimeSessionMode::Conversational,
+                output_modality: RealtimeOutputModality::Audio,
+                voice: RealtimeVoice::Marin,
+            },
+            "live_session_a/b",
+            HeaderMap::from_iter([(
+                "authorization".parse().unwrap(),
+                "Bearer public-test-key".parse().unwrap(),
+            )]),
+            HeaderMap::new(),
+            RealtimeTranscriptState::default(),
+        )
+        .await
+        .unwrap();
+    let mut raw_timing = Vec::new();
+    let handoff = loop {
+        match timeout(LIMIT, connection.next_event())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap()
+        {
+            RealtimeEvent::HandoffRequested(handoff) => break handoff,
+            RealtimeEvent::ConversationItemAdded(item) => raw_timing.push(item),
+            RealtimeEvent::InputTranscriptDone(_) | RealtimeEvent::OutputTranscriptDone(_) => {
+                panic!("fragments must not become completed turns")
+            }
+            _ => {}
+        }
+    };
+    assert_eq!(
+        handoff,
+        RealtimeHandoffRequested {
+            handoff_id: "item_first".to_string(),
+            item_id: "item_first".to_string(),
+            input_transcript: String::new(),
+            active_transcript: vec![
+                RealtimeTranscriptEntry {
+                    role: "user".to_string(),
+                    text: "Check Friday ".to_string()
+                },
+                RealtimeTranscriptEntry {
+                    role: "assistant".to_string(),
+                    text: "Which time?".to_string()
+                },
+                RealtimeTranscriptEntry {
+                    role: "user".to_string(),
+                    text: "at two. Actually Thursday, not Friday.".to_string()
+                },
+            ],
+        }
+    );
+    assert_eq!(raw_timing[2]["end_ms"], 300);
+    connection
+        .writer()
+        .send_conversation_function_call_output(
+            "item_first".to_string(),
+            "Checking availability".to_string(),
+        )
+        .await
+        .unwrap();
+    connection
+        .writer()
+        .with_context_append_channel(RealtimeContextAppendChannel::Speakable)
+        .send_conversation_function_call_output("item_first".to_string(), output)
+        .await
+        .unwrap();
+    let mut usage = Vec::new();
+    let mut second = None;
+    loop {
+        let event = timeout(LIMIT, connection.next_event())
+            .await
+            .unwrap()
+            .unwrap()
+            .unwrap();
+        match event {
+            RealtimeEvent::HandoffRequested(handoff) => second = Some(handoff),
+            RealtimeEvent::ConversationItemAdded(item)
+                if item["type"] == "session.usage.updated" =>
+            {
+                usage.push(item["usage"]["seconds"].clone())
+            }
+            RealtimeEvent::ConversationItemAdded(item) if item["type"] == "session.closed" => {
+                usage.push(item["usage"]["seconds"].clone());
+                break;
+            }
+            _ => {}
+        }
+    }
+    assert_eq!(usage, vec![json!(12), json!(15), json!(15.75)]);
+    assert_eq!(
+        second.unwrap().active_transcript,
+        vec![RealtimeTranscriptEntry {
+            role: "user".to_string(),
+            text: "Yes, same time.".to_string(),
+        }]
+    );
+    timeout(LIMIT, server).await.unwrap().unwrap();
+}
+
+#[tokio::test]
+async fn public_live_transcript_bound_retains_latest_correction() {
+    let state = RealtimeTranscriptState::default();
+    let (_tx, rx) = async_channel::unbounded();
+    let events = RealtimeWebsocketEvents {
+        rx_message: rx,
+        pending_events: Arc::new(Mutex::new(VecDeque::new())),
+        transcript_state: state,
+        event_parser: RealtimeEventParser::PublicLive,
+        is_closed: Arc::new(AtomicBool::new(false)),
+    };
+    let mut delta = RealtimeEvent::InputTranscriptDelta(RealtimeTranscriptDelta {
+        delta: format!("{} Thursday, not Friday.", "é".repeat(10_000)),
+    });
+    events.update_active_transcript(&mut delta).await;
+    let mut handoff = parse_realtime_event(
+        &json!({
+            "type":"session.delegation.created", "offset_ms":100,
+            "delegation":{"type":"delegation", "target":"client", "id":"item_bound"},
+        })
+        .to_string(),
+        RealtimeEventParser::PublicLive,
+    )
+    .unwrap();
+    events.update_active_transcript(&mut handoff).await;
+    let RealtimeEvent::HandoffRequested(handoff) = handoff else {
+        panic!("expected native handoff")
+    };
+    assert!(
+        handoff
+            .active_transcript
+            .iter()
+            .map(|entry| entry.text.len())
+            .sum::<usize>()
+            <= MAX_ACTIVE_TRANSCRIPT_BYTES
+    );
+    assert!(
+        handoff
+            .active_transcript
+            .last()
+            .unwrap()
+            .text
+            .ends_with("Thursday, not Friday.")
+    );
+    assert!(events.take_transcript_tail().await.is_empty());
+}
+
+#[test]
+fn public_live_private_usage_cannot_confirm_closure() {
+    let event = parse_realtime_event(
+        &json!({
+            "type": "session.closed", "reason": "close_requested",
+            "session": {"id": "live_session_public"},
+            "usage": {"input_tokens": 42, "output_tokens": 9},
+        })
+        .to_string(),
+        RealtimeEventParser::PublicLive,
+    );
+    assert!(
+        matches!(event, Some(RealtimeEvent::Error(message)) if message.contains("unconfirmed"))
+    );
+}
