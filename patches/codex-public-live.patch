+#[tokio::test]
+async fn isolated_user_config_preserves_identity_constraints_without_behavior() -> anyhow::Result<()>
+{
+    let tmp = tempdir()?;
+    let user_file = AbsolutePathBuf::from_absolute_path(tmp.path().join(CONFIG_TOML_FILE))?;
+    let authentication = r#"cli_auth_credentials_store = "keyring"
+forced_login_method = "chatgpt"
+forced_chatgpt_workspace_id = ["synthetic-workspace"]
+chatgpt_base_url = "https://auth.example.invalid/backend-api/"
+[features]
+secret_auth_storage = true
+"#;
+    std::fs::write(
+        user_file.as_path(),
+        format!(
+            "developer_instructions = \"personal\"\n{authentication}memories = true\nrespect_system_proxy = true\nsystem_proxy_fallback = true\n[permissions.personal.filesystem]\n\"/synthetic-grant\" = \"read\"\n"
+        ),
+    )?;
+    let layer = load_user_config_layer(
+        &TestFileSystem,
+        &user_file,
+        /*profile*/ None,
+        /*ignore_user_config*/ true,
+        /*retain_user_auth_config*/ true,
+        /*strict_config*/ false,
+    )
+    .await?;
+    assert_eq!(layer.config, toml::from_str::<TomlValue>(authentication)?);
+    Ok(())
+}
+
+#[tokio::test]
+async fn isolated_user_config_drops_unrelated_non_table_features() -> anyhow::Result<()> {
+    let tmp = tempdir()?;
+    let file = AbsolutePathBuf::from_absolute_path(tmp.path().join(CONFIG_TOML_FILE))?;
+    let authentication = "cli_auth_credentials_store = \"keyring\"\n";
+    for features in ["true", "[]", "\"personal-invalid-value\""] {
+        std::fs::write(
+            file.as_path(),
+            format!("{authentication}features = {features}\n"),
+        )?;
+        let layer = load_user_config_layer(
+            &TestFileSystem,
+            &file,
+            /*profile*/ None,
+            /*ignore_user_config*/ true,
+            /*retain_user_auth_config*/ true,
+            /*strict_config*/ false,
+        )
+        .await?;
+        assert_eq!(layer.config, toml::from_str::<TomlValue>(authentication)?);
+    }
+    Ok(())
+}
