@@ -0,0 +1,90 @@
+//! Public GPT-Live codec only. Transcript collection, routing and shutdown remain native owners.
+use super::protocol::RealtimeContextAppendChannel;
+use super::protocol::RealtimeOutboundMessage;
+use super::protocol_common::parse_error_event;
+use super::protocol_common::parse_realtime_payload;
+use super::protocol_common::parse_session_updated_event;
+use codex_protocol::protocol::RealtimeAudioFrame;
+use codex_protocol::protocol::RealtimeEvent;
+use codex_protocol::protocol::RealtimeHandoffRequested;
+use codex_protocol::protocol::RealtimeTranscriptDelta;
+
+pub(super) fn context_append(
+    delegation_id: Option<String>,
+    content: String,
+    channel: Option<RealtimeContextAppendChannel>,
+) -> RealtimeOutboundMessage {
+    RealtimeOutboundMessage::PublicAppend {
+        event_type: match channel {
+            Some(RealtimeContextAppendChannel::Commentary) | None => "session.thinking.append",
+            Some(RealtimeContextAppendChannel::Speakable) => "session.commentary.append",
+        },
+        delegation_id,
+        content,
+    }
+}
+
+pub(super) fn parse_event(payload: &str) -> Option<RealtimeEvent> {
+    let (parsed, event_type) = parse_realtime_payload(payload, "public Live")?;
+    match event_type.as_str() {
+        "session.started" | "session.updated" => parse_session_updated_event(&parsed),
+        "session.input_transcript.delta" | "session.output_transcript.delta" => {
+            // These are fragments, not completed turns. The reader preserves the raw
+            // timing on itemAdded and feeds these deltas to its bounded transcript owner.
+            let delta = RealtimeTranscriptDelta {
+                delta: parsed["delta"].as_str()?.to_string(),
+            };
+            if event_type == "session.input_transcript.delta" {
+                Some(RealtimeEvent::InputTranscriptDelta(delta))
+            } else {
+                Some(RealtimeEvent::OutputTranscriptDelta(delta))
+            }
+        }
+        "session.output_audio.delta" => Some(RealtimeEvent::AudioOut(RealtimeAudioFrame {
+            data: parsed["delta"].as_str()?.to_string(),
+            sample_rate: 24_000,
+            num_channels: 1,
+            samples_per_channel: None,
+            item_id: None,
+        })),
+        "session.delegation.created" => {
+            let delegation = &parsed["delegation"];
+            if delegation["type"].as_str() != Some("delegation")
+                || delegation["target"].as_str() != Some("client")
+            {
+                return None;
+            }
+            let id = delegation["id"].as_str().filter(|id| !id.is_empty())?;
+            Some(RealtimeEvent::HandoffRequested(RealtimeHandoffRequested {
+                handoff_id: id.to_string(),
+                item_id: id.to_string(),
+                // The public event contains NO task text. Never treat metadata as
+                // user instructions; the existing reader supplies the transcript.
+                input_transcript: String::new(),
+                active_transcript: Vec::new(),
+            }))
+        }
+        "session.usage.updated" | "session.closed" => {
+            // Public seconds are cumulative, not private token/audio counters. Preserve
+            // the provider record verbatim on the existing generic notification seam.
+            let valid_usage = parsed["usage"]["seconds"]
+                .as_f64()
+                .is_some_and(|seconds| seconds.is_finite() && seconds >= 0.0);
+            let valid_close = event_type != "session.closed"
+                || (parsed["reason"]
+                    .as_str()
+                    .is_some_and(|reason| !reason.is_empty())
+                    && parsed["session"]["id"]
+                        .as_str()
+                        .is_some_and(|id| !id.is_empty()));
+            if !valid_usage || !valid_close {
+                return Some(RealtimeEvent::Error(format!(
+                    "invalid public Live {event_type}; final usage and closure are unconfirmed"
+                )));
+            }
+            Some(RealtimeEvent::ConversationItemAdded(parsed))
+        }
+        "error" => parse_error_event(&parsed),
+        _ => None,
+    }
+}
diff --git a/codex-rs/codex-api/src/endpoint/realtime_websocket/public_live_tests.rs b/codex-rs/codex-api/src/endpoint/realtime_websocket/public_live_tests.rs
