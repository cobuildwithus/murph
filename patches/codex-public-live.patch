+use super::tests::DummyAuth;
+use super::tests::provider;
+use super::tests::realtime_session_config;
+use super::*;
+use crate::endpoint::realtime_websocket::protocol::RealtimeVoice;
+use codex_client::Response;
+use codex_client::StreamResponse;
+use codex_client::TransportError;
+use codex_protocol::protocol::ConversationTextParams;
+use codex_protocol::protocol::ConversationTextRole;
+use http::StatusCode;
+use pretty_assertions::assert_eq;
+use serde_json::json;
+use std::sync::Mutex;
+
+#[derive(Clone)]
+struct PublicTransport {
+    requests: Arc<Mutex<Vec<Request>>>,
+    result: Result<Value, StatusCode>,
+}
+
+impl HttpTransport for PublicTransport {
+    async fn execute(&self, request: Request) -> Result<Response, TransportError> {
+        self.requests.lock().unwrap().push(request);
+        match &self.result {
+            Ok(body) => Ok(Response {
+                status: StatusCode::CREATED,
+                headers: HeaderMap::new(),
+                body: Bytes::from(serde_json::to_vec(body).unwrap()),
+            }),
+            Err(StatusCode::REQUEST_TIMEOUT) => Err(TransportError::Timeout),
+            Err(status) => Err(TransportError::Http {
+                status: *status,
+                url: None,
+                headers: None,
+                body: None,
+            }),
+        }
+    }
+
+    async fn stream(&self, _request: Request) -> Result<StreamResponse, TransportError> {
+        panic!("call creation is unary");
+    }
+}
+
+fn public_config() -> RealtimeSessionConfig {
+    RealtimeSessionConfig {
+        event_parser: RealtimeEventParser::PublicLive,
+        model: Some("gpt-live-1".to_string()),
+        voice: RealtimeVoice::Marin,
+        initial_items: vec![
+            ConversationTextParams {
+                role: ConversationTextRole::User,
+                text: "Friday".to_string(),
+            },
+            ConversationTextParams {
+                role: ConversationTextRole::Assistant,
+                text: "Which time?".to_string(),
+            },
+        ],
+        ..realtime_session_config("native-thread")
+    }
+}
+
+#[tokio::test]
+async fn public_live_create_uses_json_provider_prefix_and_auth_and_returned_id() {
+    let transport = PublicTransport {
+        requests: Arc::new(Mutex::new(Vec::new())),
+        result: Ok(json!({
+            "session": {"id": "live_session_public"},
+            "transport": {"type": "webrtc", "sdp": "answer"},
+        })),
+    };
+    let mut provider = provider("https://gateway.example/prefix/v1");
+    provider.query_params = Some(std::collections::HashMap::from([(
+        "tenant".to_string(),
+        "test".to_string(),
+    )]));
+    provider
+        .headers
+        .insert("x-project", HeaderValue::from_static("project-test"));
+    let client = RealtimeCallClient::new(transport.clone(), provider, Arc::new(DummyAuth));
+    assert_eq!(
+        client
+            .create_with_session("offer".to_string(), public_config())
+            .await
+            .unwrap(),
+        RealtimeCallResponse {
+            call_id: "live_session_public".to_string(),
+            sdp: "answer".to_string(),
+        }
+    );
+    let requests = transport.requests.lock().unwrap();
+    assert_eq!(requests.len(), 1);
+    let request = &requests[0];
+    assert_eq!(request.method, Method::POST);
+    assert_eq!(
+        request.url,
+        "https://gateway.example/prefix/v1/live/sessions?tenant=test"
+    );
+    assert_eq!(request.headers["authorization"], "Bearer test-token");
+    assert_eq!(request.headers["x-project"], "project-test");
+    assert!(request.headers.get("openai-alpha").is_none());
+    let Some(RequestBody::Json(body)) = &request.body else {
+        panic!("expected JSON, not multipart")
+    };
+    assert_eq!(
+        body,
+        &json!({
+            "session": {
+                "model": "gpt-live-1", "instructions": "hi",
+                "audio": {"output": {"voice": "marin"}}, "delegation": {"type": "client"},
+                "client": {"data_channel": {
+                    "allowed_client_events": ["session.input_audio.mute", "session.input_audio.unmute", "session.close"],
+                    "allowed_server_events": [
+                        {"type": "session.started"}, {"type": "session.closed"},
+                        {"type": "session.input_audio.muted"}, {"type": "session.input_audio.unmuted"},
+                        {"type": "session.input_transcript.delta"}, {"type": "session.output_transcript.delta"},
+                        {"type": "session.usage.updated"}, {"type": "error"}, {"type": "info"},
+                    ],
+                }},
+                "input": [
+                    {"type": "message", "role": "user", "content": [{"type": "input_text", "text": "Friday"}]},
+                    {"type": "message", "role": "assistant", "content": [{"type": "output_text", "text": "Which time?"}]},
+                ],
+            },
+            "transport": {"type": "webrtc", "sdp": "offer"},
+        })
+    );
+}
+
+#[tokio::test]
+async fn public_live_creation_never_retries_paid_or_rejected_requests() {
+    for status in [
+        StatusCode::REQUEST_TIMEOUT,
+        StatusCode::FORBIDDEN,
+        StatusCode::NOT_FOUND,
+        StatusCode::TOO_MANY_REQUESTS,
+        StatusCode::INTERNAL_SERVER_ERROR,
+    ] {
+        let transport = PublicTransport {
+            requests: Arc::new(Mutex::new(Vec::new())),
+            result: Err(status),
+        };
+        let mut provider = provider("https://gateway.example/v1");
+        provider.retry.max_attempts = 4;
+        provider.retry.retry_429 = true;
+        provider.retry.retry_5xx = true;
+        provider.retry.retry_transport = true;
+        let client = RealtimeCallClient::new(transport.clone(), provider, Arc::new(DummyAuth));
+        assert!(
+            client
+                .create_with_session("offer".to_string(), public_config())
+                .await
+                .is_err()
+        );
+        assert_eq!(
+            transport.requests.lock().unwrap().len(),
+            1,
+            "status {status}"
+        );
+    }
+}
+
+#[tokio::test]
+async fn public_live_invalid_created_response_is_explicitly_ambiguous_and_not_retried() {
+    let transport = PublicTransport {
+        requests: Arc::new(Mutex::new(Vec::new())),
+        result: Ok(json!({"session": {"id": "live_session_public"}})),
+    };
+    let client = RealtimeCallClient::new(
+        transport.clone(),
+        provider("https://gateway.example/v1"),
+        Arc::new(DummyAuth),
+    );
+    let error = client
+        .create_with_session("offer".to_string(), public_config())
+        .await
+        .unwrap_err();
+    assert!(error.to_string().contains("outcome unconfirmed"));
+    assert_eq!(transport.requests.lock().unwrap().len(), 1);
+}
