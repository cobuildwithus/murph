 #[ts(export_to = "v2/")]
 pub struct ThreadRealtimeStartParams {
+    /// Emits normalized input.requested items instead of starting or steering backing turns.
+    /// The client owns durable acceptance and uses the ordinary turn APIs. Defaults to false.
+    #[serde(default, skip_serializing_if = "std::ops::Not::not")]
+    pub client_managed_inputs: bool,
     pub thread_id: String,
     /// Leaves Codex response handoffs to the client's explicit append calls instead of forwarding
