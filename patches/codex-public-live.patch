diff --git a/codex-rs/app-server/tests/suite/v2/ignore_user_config.rs b/codex-rs/app-server/tests/suite/v2/ignore_user_config.rs
new file mode 100644
index 0000000000000000000000000000000000000000..90dc0e27f7164b921eaaa38476575a3260fef53f
--- /dev/null
+++ b/codex-rs/app-server/tests/suite/v2/ignore_user_config.rs
@@ -0,0 +1,132 @@
+//! Explicit app-server isolation excludes personal inputs without moving the auth home.
+
+use anyhow::Result;
+use app_test_support::TestAppServer;
+use codex_app_server_protocol::Account;
+use codex_app_server_protocol::ConfigReadParams;
+use codex_app_server_protocol::ConfigReadResponse;
+use codex_app_server_protocol::GetAccountParams;
+use codex_app_server_protocol::GetAccountResponse;
+use codex_app_server_protocol::ThreadStartParams;
+use codex_app_server_protocol::ThreadStartResponse;
+use pretty_assertions::assert_eq;
+use serde_json::Value;
+use serde_json::json;
+use std::time::Duration;
+use tempfile::TempDir;
+use tokio::time::timeout;
+
+const READ_TIMEOUT: Duration = Duration::from_secs(60);
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn ignore_user_config_retains_auth_and_managed_requirements() -> Result<()> {
+    let home = TempDir::new()?;
+    std::fs::write(
+        home.path().join("config.toml"),
+        r#"cli_auth_credentials_store = "file"
+default_permissions = "synthetic"
+developer_instructions = "synthetic personal instructions"
+[permissions.synthetic.filesystem]
+"/synthetic-extra-read" = "read"
+"#,
+    )?;
+    std::fs::write(
+        home.path().join("auth.json"),
+        r#"{"OPENAI_API_KEY":"synthetic-test-key"}"#,
+    )?;
+    std::fs::write(
+        home.path().join("requirements.toml"),
+        "allow_remote_control = false\n[application.network]\nenabled = false\n",
+    )?;
+    for isolated in [false, true] {
+        let mut args = vec![];
+        if isolated {
+            args.push("--ignore-user-config");
+        }
+        let mut server = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .with_args(&args)
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await?;
+        let config_id = server
+            .send_config_read_request(ConfigReadParams {
+                include_layers: false,
+                cwd: None,
+            })
+            .await?;
+        let config: ConfigReadResponse =
+            timeout(READ_TIMEOUT, server.read_response(config_id)).await??;
+        let config_json = serde_json::to_value(config.config)?;
+        assert_eq!(
+            config_json
+                .to_string()
+                .contains("synthetic personal instructions"),
+            !isolated
+        );
+        assert_eq!(
+            config_json.to_string().contains("synthetic-extra-read"),
+            !isolated
+        );
+
+        let requirements_id = server.send_config_requirements_read_request().await?;
+        let requirements: Value =
+            timeout(READ_TIMEOUT, server.read_response(requirements_id)).await??;
+        assert_eq!(
+            requirements["requirements"]["application"]["network"]["enabled"],
+            json!(false)
+        );
+
+        let account_id = server
+            .send_get_account_request(GetAccountParams {
+                refresh_token: false,
+            })
+            .await?;
+        let account: GetAccountResponse =
+            timeout(READ_TIMEOUT, server.read_response(account_id)).await??;
+        assert_eq!(account.account, Some(Account::ApiKey {}));
+        assert_eq!(
+            std::fs::read_to_string(home.path().join("auth.json"))?,
+            r#"{"OPENAI_API_KEY":"synthetic-test-key"}"#
+        );
+    }
+    Ok(())
+}
+
+#[tokio::test(flavor = "multi_thread", worker_threads = 2)]
+async fn ignore_user_config_excludes_global_but_keeps_project_instructions() -> Result<()> {
+    for isolated in [false, true] {
+        let home = TempDir::new()?;
+        let workspace = TempDir::new()?;
+        let global = home.path().join("AGENTS.override.md");
+        let project = workspace.path().join("AGENTS.md");
+        std::fs::write(&global, "synthetic global instructions")?;
+        std::fs::write(&project, "synthetic project instructions")?;
+        let args = if isolated {
+            vec!["--ignore-user-config"]
+        } else {
+            vec![]
+        };
+        let mut server = TestAppServer::builder()
+            .with_codex_home(home.path())
+            .without_auto_env()
+            .with_args(&args)
+            .build_initialized_with_timeout(READ_TIMEOUT)
+            .await?;
+        let request_id = server
+            .send_thread_start_request(ThreadStartParams {
+                cwd: Some(workspace.path().display().to_string()),
+                ..Default::default()
+            })
+            .await?;
+        let response: ThreadStartResponse =
+            timeout(READ_TIMEOUT, server.read_response(request_id)).await??;
+        let sources = response
+            .instruction_sources
+            .into_iter()
+            .map(|path| std::fs::canonicalize(path.as_str()))
+            .collect::<std::io::Result<Vec<_>>>()?;
+        assert!(sources.contains(&std::fs::canonicalize(project)?));
+        assert_eq!(sources.contains(&std::fs::canonicalize(global)?), !isolated);
+    }
+    Ok(())
+}
