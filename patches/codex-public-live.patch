+#[tokio::test]
+async fn reused_connection_without_acknowledgement_fails_before_idle_timeout() {
+    let server = start_scripted_server(vec![
+        vec![
+            (Duration::ZERO, response_created("resp-1")),
+            (Duration::ZERO, response_completed("resp-1")),
+        ],
+        Vec::new(),
+    ])
+    .await;
+    let connection = connect(&server, LONG_TIMEOUT, SHORT_ACKNOWLEDGEMENT_TIMEOUT).await;
+
+    let (first, _) = stream_outcome(&connection, /*connection_reused*/ false).await;
+    let (second, elapsed) = stream_outcome(&connection, /*connection_reused*/ true).await;
+
+    assert_eq!(
+        (first, second, connection.is_closed().await),
+        (
+            vec!["created:resp-1".to_string(), "completed:resp-1".to_string()],
+            vec![
+                "error:stream error: timeout waiting for websocket response acknowledgement"
+                    .to_string()
+            ],
+            true,
+        )
+    );
+    assert!(
+        elapsed >= SHORT_ACKNOWLEDGEMENT_TIMEOUT && elapsed < LONG_TIMEOUT / 2,
+        "acknowledgement timeout fired after {elapsed:?}"
+    );
+}
+
+#[tokio::test]
+async fn acknowledged_response_may_stay_silent_beyond_acknowledgement_timeout() {
+    let silence = SHORT_ACKNOWLEDGEMENT_TIMEOUT * 4;
+    let server = start_scripted_server(vec![vec![
+        (Duration::ZERO, response_created("resp-1")),
+        (silence, response_completed("resp-1")),
+    ]])
+    .await;
+    let connection = connect(&server, LONG_TIMEOUT, SHORT_ACKNOWLEDGEMENT_TIMEOUT).await;
+
+    let (outcome, elapsed) = stream_outcome(&connection, /*connection_reused*/ false).await;
+
+    assert_eq!(
+        outcome,
+        vec!["created:resp-1".to_string(), "completed:resp-1".to_string()]
+    );
+    assert!(elapsed >= silence, "response completed after {elapsed:?}");
+}
+
+#[tokio::test]
+async fn idle_timeout_still_bounds_unacknowledged_request_when_shorter() {
+    let idle_timeout = SHORT_ACKNOWLEDGEMENT_TIMEOUT;
+    let server = start_scripted_server(vec![Vec::new()]).await;
+    let connection = connect(&server, idle_timeout, LONG_TIMEOUT).await;
+
+    let (outcome, elapsed) = stream_outcome(&connection, /*connection_reused*/ false).await;
+
+    assert_eq!(
+        outcome,
+        vec!["error:stream error: idle timeout waiting for websocket".to_string()]
+    );
+    assert!(
+        elapsed >= idle_timeout && elapsed < LONG_TIMEOUT / 2,
+        "idle timeout fired after {elapsed:?}"
+    );
+}
