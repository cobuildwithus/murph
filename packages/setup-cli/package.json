{
  "name": "@murphai/setup-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "exports": {
    "./setup-cli": {
      "types": "./dist/setup-cli.d.ts",
      "default": "./dist/setup-cli.js"
    },
    "./setup-assistant": {
      "types": "./dist/setup-assistant.d.ts",
      "default": "./dist/setup-assistant.js"
    },
    "./setup-assistant-wizard": {
      "types": "./dist/setup-assistant-wizard.d.ts",
      "default": "./dist/setup-assistant-wizard.js"
    },
    "./setup-assistant-defaults": {
      "types": "./dist/setup-assistant-defaults.d.ts",
      "default": "./dist/setup-assistant-defaults.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/assistant-engine": "workspace:*",
    "@murphai/inbox-services": "workspace:*",
    "@murphai/operator-config": "workspace:*",
    "@murphai/vault-usecases": "workspace:*",
    "incur": "0.4.5",
    "ink": "^6.8.0",
    "react": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
