{
  "name": "@murphai/assistant-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./hosted-device-sync-status": {
      "types": "./dist/hosted-device-sync-status.d.ts",
      "import": "./dist/hosted-device-sync-status.js",
      "default": "./dist/hosted-device-sync-status.js"
    },
    "./hosted-device-sync-testkit": {
      "types": "./dist/hosted-device-sync-testkit.d.ts",
      "import": "./dist/hosted-device-sync-testkit.js",
      "default": "./dist/hosted-device-sync-testkit.js"
    },
    "./hosted-assistant-bootstrap": {
      "types": "./dist/hosted-assistant-bootstrap.d.ts",
      "import": "./dist/hosted-assistant-bootstrap.js",
      "default": "./dist/hosted-assistant-bootstrap.js"
    },
    "./hosted-runtime-contracts": {
      "types": "./dist/hosted-runtime-contracts.d.ts",
      "import": "./dist/hosted-runtime-contracts.js",
      "default": "./dist/hosted-runtime-contracts.js"
    },
    "./hosted-runtime-worker-contracts": {
      "types": "./dist/hosted-runtime-worker-contracts.d.ts",
      "import": "./dist/hosted-runtime-worker-contracts.js",
      "default": "./dist/hosted-runtime-worker-contracts.js"
    },
    "./hosted-invocation": {
      "types": "./dist/hosted-invocation.d.ts",
      "import": "./dist/hosted-invocation.js",
      "default": "./dist/hosted-invocation.js"
    },
    "./hosted-checkpoint-bridge": {
      "types": "./dist/hosted-checkpoint-bridge.d.ts",
      "import": "./dist/hosted-checkpoint-bridge.js",
      "default": "./dist/hosted-checkpoint-bridge.js"
    },
    "./hosted-invocation-testkit": {
      "types": "./dist/hosted-invocation-testkit.d.ts",
      "import": "./dist/hosted-invocation-testkit.js",
      "default": "./dist/hosted-invocation-testkit.js"
    },
    "./hosted-provider-effects": {
      "types": "./dist/hosted-provider-effects.d.ts",
      "import": "./dist/hosted-provider-effects.js",
      "default": "./dist/hosted-provider-effects.js"
    },
    "./hosted-email": {
      "types": "./dist/hosted-email.d.ts",
      "import": "./dist/hosted-email.js",
      "default": "./dist/hosted-email.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --isolate=true --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --isolate=true --coverage"
  },
  "dependencies": {
    "@murphai/assistant-engine": "workspace:*",
    "@murphai/clinical-records": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/operator-config": "workspace:*",
    "@murphai/core": "workspace:*",
    "@murphai/device-syncd": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/inbox-services": "workspace:*",
    "@murphai/inboxd": "workspace:*",
    "@murphai/messaging-ingress": "workspace:*",
    "@murphai/parsers": "workspace:*",
    "@murphai/query": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "@murphai/vault-usecases": "workspace:*"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
