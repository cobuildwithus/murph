{
  "name": "@murphai/health-commons",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    },
    "./biomarker-entity-mappings": {
      "types": "./dist/biomarker-entity-mappings.d.ts",
      "import": "./dist/biomarker-entity-mappings.js",
      "default": "./dist/biomarker-entity-mappings.js"
    },
    "./biomarker-fallback-ranges": {
      "types": "./dist/biomarker-fallback-ranges.d.ts",
      "import": "./dist/biomarker-fallback-ranges.js",
      "default": "./dist/biomarker-fallback-ranges.js"
    },
    "./generated/*": "./generated/*"
  },
  "files": [
    "content",
    "generated",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json --pretty false && node dist/build.js",
    "typecheck": "pnpm generate && node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "generate": "pnpm --dir ../.. exec tsx --tsconfig packages/health-commons/tsconfig.json packages/health-commons/src/build.ts",
    "generate:watch": "pnpm --dir ../.. health-commons:generate:watch",
    "generate:check": "pnpm generate --check",
    "artifacts:r2:dry-run": "pnpm --dir ../.. exec tsx --tsconfig packages/health-commons/tsconfig.json packages/health-commons/src/sync-cloudflare-r2.ts --dry-run",
    "test:vitest": "pnpm generate && pnpm --dir ../.. exec vitest run --config packages/health-commons/vitest.config.ts --no-coverage",
    "test:coverage": "pnpm generate && pnpm --dir ../.. exec vitest run --config packages/health-commons/vitest.config.ts --coverage",
    "test": "pnpm test:vitest",
    "verify": "pnpm typecheck && pnpm test && pnpm generate:check",
    "prepack": "pnpm build",
    "artifacts:hash": "pnpm --dir ../.. exec tsx --tsconfig packages/health-commons/tsconfig.json packages/health-commons/src/hash-artifact.ts",
    "artifacts:r2": "pnpm --dir ../.. exec tsx --tsconfig packages/health-commons/tsconfig.json packages/health-commons/src/sync-cloudflare-r2.ts"
  },
  "dependencies": {
    "@murphai/contracts": "workspace:*",
    "@murphai/health-metrics": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
