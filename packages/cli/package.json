{
  "name": "@murphai/murph",
  "version": "1.3.5",
  "private": true,
  "description": "Typed vault CLI for the hosted Murph runtime and operators.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "config.schema.json",
    "LICENSE"
  ],
  "keywords": [
    "murph",
    "health",
    "assistant",
    "personal-ai",
    "cli"
  ],
  "bin": {
    "vault-cli": "dist/bin.js"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.build.json",
    "gen:config-schema": "tsx ./scripts/generate-incur-config-schema.ts",
    "typecheck": "node ../../scripts/run-typescript.mjs check -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm test:source",
    "test:source": "pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --no-coverage",
    "test:coverage": "pnpm test:source:coverage",
    "test:source:coverage": "pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --coverage",
    "verify:prepared-runtime": "pnpm --dir ../.. exercise-library:generate && pnpm --dir ../.. health-commons:generate && pnpm --dir ../.. build:test-runtime:prepared",
    "verify:runtime-artifacts": "pnpm build && node --import=tsx ./scripts/verify-runtime-artifacts.ts",
    "test:built-runtime": "MURPH_PREPARED_CLI_RUNTIME_ARTIFACTS=1 pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --no-coverage",
    "test:built-runtime:coverage": "MURPH_PREPARED_CLI_RUNTIME_ARTIFACTS=1 pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --coverage",
    "verify": "pnpm verify:prepared-runtime && pnpm verify:runtime-artifacts && pnpm test:built-runtime",
    "verify:coverage": "pnpm verify:prepared-runtime && pnpm verify:runtime-artifacts && pnpm test:built-runtime:coverage"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@elevenlabs/elevenlabs-js": "2.62.0",
    "@junction-api/sdk": "1.2.0",
    "@linqapp/sdk": "0.34.0",
    "@modelcontextprotocol/server": "2.0.0-alpha.4",
    "@murphai/assistant-engine": "workspace:*",
    "@murphai/clinical-records": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/core": "workspace:*",
    "@murphai/device-syncd": "workspace:*",
    "@murphai/exercise-library": "workspace:*",
    "@murphai/gateway-core": "workspace:*",
    "@murphai/health-commons": "workspace:*",
    "@murphai/health-metrics": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/importers": "workspace:*",
    "@murphai/inbox-services": "workspace:*",
    "@murphai/inboxd": "workspace:*",
    "@murphai/messaging-ingress": "workspace:*",
    "@murphai/operator-config": "workspace:*",
    "@murphai/parsers": "workspace:*",
    "@murphai/query": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "@murphai/vault-usecases": "workspace:*",
    "@scalar/openapi-types": "^0.8.0",
    "@toon-format/toon": "^2.1.0",
    "incur": "0.5.1",
    "mpg123-decoder": "1.0.3",
    "openai": "7.55.0",
    "sharp": "0.35.5",
    "tokenx": "^1.3.0",
    "ws": "^8.22.2",
    "yaml": "^2.9.1",
    "zod": "^4.5.4",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
