{
  "name": "@murphai/murph",
  "version": "1.3.0",
  "private": false,
  "description": "Murph is a personal health assistant you run locally. Install this package to get the murph CLI.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "config.schema.json",
    "LICENSE"
  ],
  "keywords": [
    "murph",
    "health",
    "assistant",
    "personal-ai",
    "local-first",
    "cli"
  ],
  "bin": {
    "vault-cli": "dist/bin.js",
    "murph": "dist/bin.js"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.build.json",
    "gen:config-schema": "tsx ./scripts/generate-incur-config-schema.ts",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm test:source",
    "test:source": "pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --no-coverage",
    "test:coverage": "pnpm test:source:coverage",
    "test:source:coverage": "pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --coverage",
    "verify:prepared-runtime": "pnpm --dir ../.. exercise-library:generate && pnpm --dir ../.. health-commons:generate && pnpm --dir ../.. build:test-runtime:prepared",
    "verify:package-shape": "pnpm build && node --import=tsx ./scripts/verify-package-shape.ts",
    "test:built-runtime": "MURPH_PREPARED_CLI_RUNTIME_ARTIFACTS=1 MURPH_CLI_RELEASE_TARBALL_TEST=1 pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --no-coverage",
    "test:built-runtime:coverage": "MURPH_PREPARED_CLI_RUNTIME_ARTIFACTS=1 MURPH_CLI_RELEASE_TARBALL_TEST=1 pnpm --dir ../.. exec vitest run --config packages/cli/vitest.workspace.ts --coverage",
    "verify": "pnpm verify:prepared-runtime && pnpm verify:package-shape && pnpm test:built-runtime",
    "verify:coverage": "pnpm verify:prepared-runtime && pnpm verify:package-shape && pnpm test:built-runtime:coverage",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@alcalzone/ansi-tokenize": "^0.2.4",
    "@cfworker/json-schema": "^4.1.1",
    "@elevenlabs/elevenlabs-js": "2.62.0",
    "@junction-api/sdk": "1.2.0",
    "@linqapp/sdk": "0.34.0",
    "@modelcontextprotocol/server": "^2.0.0-alpha.2",
    "@murphai/assistant-cli": "workspace:*",
    "@murphai/assistant-engine": "workspace:*",
    "@murphai/assistantd": "workspace:*",
    "@murphai/clinical-records": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/core": "workspace:*",
    "@murphai/device-syncd": "workspace:*",
    "@murphai/exercise-library": "workspace:*",
    "@murphai/gateway-core": "workspace:*",
    "@murphai/health-commons": "workspace:*",
    "@murphai/health-metrics": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/importers": "workspace:*",
    "@murphai/inbox-services": "workspace:*",
    "@murphai/inboxd": "workspace:*",
    "@murphai/messaging-ingress": "workspace:*",
    "@murphai/operator-config": "workspace:*",
    "@murphai/parsers": "workspace:*",
    "@murphai/query": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "@murphai/setup-cli": "workspace:*",
    "@murphai/vault-usecases": "workspace:*",
    "@toon-format/toon": "^2.1.0",
    "ansi-escapes": "^7.3.0",
    "ansi-styles": "^6.2.1",
    "auto-bind": "^5.0.1",
    "chalk": "^5.6.0",
    "cli-boxes": "^3.0.0",
    "cli-cursor": "^4.0.0",
    "cli-truncate": "^5.1.1",
    "code-excerpt": "^4.0.0",
    "es-toolkit": "^1.39.10",
    "exa-js": "2.17.0",
    "grammy": "1.42.0",
    "incur": "0.4.5",
    "indent-string": "^5.0.0",
    "ink": "^6.8.0",
    "is-in-ci": "^2.0.0",
    "openai": "6.45.0",
    "patch-console": "^2.0.0",
    "react": "^19.2.6",
    "react-reconciler": "^0.33.0",
    "scheduler": "^0.27.0",
    "sharp": "0.34.5",
    "signal-exit": "^3.0.7",
    "slice-ansi": "^8.0.0",
    "stack-utils": "^2.0.6",
    "string-width": "^8.1.1",
    "terminal-size": "^4.0.1",
    "tokenx": "^1.3.0",
    "type-fest": "^5.4.1",
    "widest-line": "^6.0.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.2",
    "yoga-layout": "~3.2.1",
    "zod": "^4.4.3",
    "zxing-wasm": "3.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "typescript": "^7.0.2"
  },
  "bundleDependencies": [
    "@murphai/assistant-cli",
    "@murphai/assistant-engine",
    "@murphai/assistantd",
    "@murphai/clinical-records",
    "@murphai/core",
    "@murphai/device-syncd",
    "@murphai/exercise-library",
    "@murphai/health-commons",
    "@murphai/health-metrics",
    "@murphai/importers",
    "@murphai/inbox-services",
    "@murphai/inboxd",
    "@murphai/messaging-ingress",
    "@murphai/operator-config",
    "@murphai/parsers",
    "@murphai/query",
    "@murphai/runtime-state",
    "@murphai/setup-cli",
    "@murphai/vault-usecases",
    "incur",
    "ink"
  ]
}
