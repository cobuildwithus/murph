{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.goal.v1"
    },
    "docType": {
      "type": "string",
      "const": "goal"
    },
    "goalId": {
      "type": "string",
      "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "horizon": {
      "type": "string",
      "enum": [
        "short_term",
        "medium_term",
        "long_term",
        "ongoing"
      ]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "window": {
      "type": "object",
      "properties": {
        "startAt": {
          "type": "string",
          "format": "date"
        },
        "targetAt": {
          "type": "string",
          "format": "date"
        }
      },
      "required": [
        "startAt"
      ],
      "additionalProperties": false
    },
    "parentGoalId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "relatedGoalIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "uniqueItems": true
    },
    "relatedExperimentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "parent_goal"
              },
              "targetId": {
                "type": "string",
                "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            },
            "required": [
              "type",
              "targetId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "related_goal"
              },
              "targetId": {
                "type": "string",
                "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            },
            "required": [
              "type",
              "targetId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "related_experiment"
              },
              "targetId": {
                "type": "string",
                "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
              }
            },
            "required": [
              "type",
              "targetId"
            ],
            "additionalProperties": false
          }
        ]
      },
      "uniqueItems": true
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "metricTargets": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "targetId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "const": "metric"
          },
          "metricKey": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "biomarkerKey": {
            "type": "string",
            "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
          },
          "comparator": {
            "type": "string",
            "enum": [
              "<",
              "<=",
              ">",
              ">=",
              "between"
            ]
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/%^-]+$"
          },
          "highValue": {
            "type": "number"
          },
          "evaluation": {
            "default": {
              "kind": "selected-value"
            },
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "selected-value"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "latest-lab"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "rolling-window"
                  },
                  "statistic": {
                    "type": "string",
                    "enum": [
                      "mean",
                      "median"
                    ]
                  },
                  "windowDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  }
                },
                "required": [
                  "kind",
                  "statistic",
                  "windowDays"
                ],
                "additionalProperties": false
              }
            ]
          },
          "selectionPolicyOverride": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "latest-valid"
                  },
                  "staleAfterDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "latest-lab"
                  },
                  "preferCollectedAt": {
                    "default": true,
                    "type": "boolean",
                    "const": true
                  },
                  "preferFasting": {
                    "type": "boolean"
                  },
                  "staleAfterDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "required": [
                  "kind",
                  "preferCollectedAt"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "daily-aggregate"
                  },
                  "statistic": {
                    "type": "string",
                    "enum": [
                      "mean",
                      "median",
                      "min",
                      "max",
                      "sum",
                      "count"
                    ]
                  },
                  "latestWindowDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 365
                  },
                  "minimumPoints": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100000
                  },
                  "staleAfterDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "required": [
                  "kind",
                  "statistic"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "latest-device-estimate"
                  },
                  "staleAfterDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "qualified-latest"
                  },
                  "requiredQualifiers": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "additionalProperties": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        },
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160
                        },
                        {
                          "type": "number"
                        },
                        {
                          "type": "boolean"
                        }
                      ]
                    }
                  },
                  "staleAfterDays": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3650
                  }
                },
                "required": [
                  "kind",
                  "requiredQualifiers"
                ],
                "additionalProperties": false
              }
            ]
          },
          "startAt": {
            "type": "string",
            "format": "date"
          },
          "targetAt": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "targetId",
          "kind",
          "metricKey",
          "comparator",
          "value",
          "unit",
          "evaluation"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "docType",
    "goalId",
    "slug",
    "title",
    "status",
    "horizon",
    "priority",
    "window"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-goal.schema.json",
  "title": "Murph Goal Frontmatter"
}
