{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.inbox-attachment-retention.v1"
    },
    "captureId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "attachmentId": {
      "type": "string",
      "pattern": "^att_[A-Za-z0-9][A-Za-z0-9_-]*_[0-9]{2}$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "image",
        "audio",
        "video"
      ]
    },
    "mime": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "fileName": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        {
          "type": "null"
        }
      ]
    },
    "byteSize": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "storedPath": {
      "type": "string",
      "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "captureOccurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "purgedAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "const": "inbox_media_retention"
    },
    "retainedDerivative": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parser-manifest"
            },
            "path": {
              "type": "string",
              "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "captureId",
    "attachmentId",
    "ordinal",
    "kind",
    "storedPath",
    "sha256",
    "captureOccurredAt",
    "recordedAt",
    "purgedAt",
    "reason"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/inbox-attachment-retention-record.schema.json",
  "title": "Murph Inbox Attachment Retention Record"
}
