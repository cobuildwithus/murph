              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "timeZoneOffsetMinutes": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": -1440,
                  "maximum": 1440
                },
                {
                  "type": "null"
                }
              ]
