          ],
          "additionalProperties": false
        },
        "dataOrigin": {
          "type": "object",
          "properties": {
            "version": {
              "type": "number",
              "const": 1
            },
            "aggregatorProvider": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            "sourceProviderSlug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            "sourceType": {
              "type": "string",
