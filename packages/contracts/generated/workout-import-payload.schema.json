{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "activity_session"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "type": "string",
          "enum": [
            "manual",
            "import",
            "device",
            "derived"
          ]
        },
        "activityType": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "durationMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        },
        "distanceKm": {
          "type": "number",
          "minimum": 0
        },
        "rawRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
          },
          "uniqueItems": true
        },
        "externalRef": {
          "type": "object",
