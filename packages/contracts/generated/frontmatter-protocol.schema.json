{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.protocol.v1"
    },
    "docType": {
      "type": "string",
      "const": "protocol"
    },
    "protocolId": {
      "type": "string",
      "pattern": "^prot_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "archived"
      ]
    },
    "commonsProtocolRef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
        },
        "pageRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "runSpecRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "testPlanId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      },
      "required": [
        "key",
        "pageRevisionId",
        "runSpecRevisionId"
      ],
      "additionalProperties": false
    },
    "lineage": {
      "type": "object",
      "properties": {
        "sourceKind": {
          "type": "string",
          "enum": [
            "health_commons_protocol",
            "protocol"
          ]
        },
        "parentProtocolRef": {
          "type": "object",
          "properties": {
            "protocolId": {
              "type": "string",
              "pattern": "^prot_[0-9A-HJKMNP-TV-Z]{26}$"
            },
            "protocolRevisionId": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "effectiveSpecHash": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "required": [
            "protocolId",
            "protocolRevisionId",
            "effectiveSpecHash"
          ],
          "additionalProperties": false
        },
        "notes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "sourceKind"
      ],
      "additionalProperties": false
    },
    "diff": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "op": {
            "type": "string",
            "enum": [
              "add",
              "remove",
              "replace"
            ]
          },
          "before": {
            "$ref": "#/$defs/__schema0"
          },
          "after": {
            "$ref": "#/$defs/__schema0"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "path",
          "op"
        ],
        "additionalProperties": false
      }
    },
    "effectiveSpec": {
      "type": "object",
      "properties": {
        "doseSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "modality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "activitySessionEvidence": {
          "type": "object",
          "properties": {
            "activityKinds": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "uniqueItems": true
            },
            "minimumDurationMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "activityKinds"
          ],
          "additionalProperties": false
        },
        "frequency": {
          "type": "object",
          "properties": {
            "sessionsPerDay": {
              "type": "number",
              "minimum": 0
            },
            "sessionsPerWeek": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "durationMinutes": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "target": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "temperatureC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "targetSessions": {
          "type": "integer",
          "minimum": 0
        },
        "minimumUsefulSessions": {
          "type": "integer",
          "minimum": 0
        },
        "instructions": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "stopConditions": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "notes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "doseSignature"
      ],
      "additionalProperties": false
    },
    "personalization": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "constraints": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "preferences": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "rationale": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "notes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "effectiveSpecHash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "protocolRevisionId": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "docType",
    "protocolId",
    "slug",
    "title",
    "status",
    "commonsProtocolRef",
    "lineage",
    "diff",
    "effectiveSpec",
    "personalization",
    "effectiveSpecHash",
    "protocolRevisionId"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-protocol.schema.json",
  "title": "Murph Protocol Frontmatter",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
