{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.automation.v1"
    },
    "docType": {
      "type": "string",
      "const": "automation"
    },
    "automationId": {
      "type": "string",
      "minLength": 1
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "paused",
        "archived"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "schedule": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "at"
            },
            "at": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "every"
            },
            "everyMs": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "everyMs"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cron"
            },
            "expression": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "expression"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "dailyLocal"
            },
            "localTime": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "kind",
            "localTime"
          ],
          "additionalProperties": false
        }
      ]
    },
    "route": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "deliveryTarget": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "identityId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "participantId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "threadId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "channel",
        "deliveryTarget",
        "identityId",
        "participantId",
        "threadId"
      ],
      "additionalProperties": false
    },
    "continuityPolicy": {
      "type": "string",
      "enum": [
        "fresh",
        "preserve"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "docType",
    "automationId",
    "slug",
    "title",
    "status",
    "schedule",
    "route",
    "continuityPolicy",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-automation.schema.json",
  "title": "Murph Automation Frontmatter"
}
