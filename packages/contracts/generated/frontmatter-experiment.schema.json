{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.experiment.v1"
    },
    "docType": {
      "type": "string",
      "const": "experiment"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "startedOn": {
      "type": "string",
      "format": "date"
    },
    "endedOn": {
      "type": "string",
      "format": "date"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "commonsProtocolRef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
        },
        "pageRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "runSpecRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "testPlanId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      },
      "required": [
        "key",
        "pageRevisionId",
        "runSpecRevisionId"
      ],
      "additionalProperties": false
    },
    "protocolRef": {
      "type": "object",
      "properties": {
        "protocolId": {
          "type": "string",
          "pattern": "^prot_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "protocolRevisionId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "effectiveSpecHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocolId",
        "protocolRevisionId",
        "effectiveSpecHash"
      ],
      "additionalProperties": false
    },
    "effectiveProtocolSnapshot": {
      "type": "object",
      "properties": {
        "effectiveSpecHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "doseSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "modality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "activitySessionEvidence": {
          "type": "object",
          "properties": {
            "activityKinds": {
              "minItems": 1,
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "uniqueItems": true
            },
            "minimumDurationMinutes": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "activityKinds"
          ],
          "additionalProperties": false
        },
        "frequency": {
          "type": "object",
          "properties": {
            "sessionsPerDay": {
              "type": "number",
              "minimum": 0
            },
            "sessionsPerWeek": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "durationMinutes": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "target": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "temperatureC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "targetSessions": {
          "type": "integer",
          "minimum": 0
        },
        "minimumUsefulSessions": {
          "type": "integer",
          "minimum": 0
        },
        "stopConditions": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "effectiveSpecHash",
        "doseSignature"
      ],
      "additionalProperties": false
    },
    "runPlan": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "prospective",
                "retrospective",
                "omitted"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "wearable_history",
                "manual_measurements"
              ]
            },
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "baselineStart": {
          "type": "string",
          "format": "date"
        },
        "baselineEnd": {
          "type": "string",
          "format": "date"
        },
        "interventionStart": {
          "type": "string",
          "format": "date"
        },
        "interventionEnd": {
          "type": "string",
          "format": "date"
        },
        "adherenceTargets": {
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "targetId": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              },
              "phase": {
                "type": "string",
                "enum": [
                  "baseline",
                  "intervention",
                  "run"
                ]
              },
              "calendar": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "daily"
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "description": "IANA time zone; runtime validates support with Intl."
                      },
                      "localTime": {
                        "type": "string",
                        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "targetCountPerDay": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "kind",
                      "timeZone"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "weekdays"
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "description": "IANA time zone; runtime validates support with Intl."
                      },
                      "weekdays": {
                        "minItems": 1,
                        "maxItems": 7,
                        "type": "array",
                        "items": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 6
                        },
                        "uniqueItems": true
                      },
                      "localTime": {
                        "type": "string",
                        "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "targetCountPerDay": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "kind",
                      "timeZone",
                      "weekdays"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "explicitDates"
                      },
                      "timeZone": {
                        "type": "string",
                        "minLength": 3,
                        "maxLength": 64,
                        "description": "IANA time zone; runtime validates support with Intl."
                      },
                      "dates": {
                        "minItems": 1,
                        "maxItems": 100,
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "localDate": {
                              "type": "string",
                              "format": "date"
                            },
                            "label": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 160
                            },
                            "localTime": {
                              "type": "string",
                              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                            },
                            "targetCount": {
                              "type": "integer",
                              "minimum": 1
                            }
                          },
                          "required": [
                            "localDate"
                          ],
                          "additionalProperties": false
                        }
                      }
                    },
                    "required": [
                      "kind",
                      "timeZone",
                      "dates"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "evidence": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "linkedEventCount"
                      },
                      "eventKind": {
                        "type": "string",
                        "enum": [
                          "intervention_session",
                          "supplement_intake",
                          "medication_intake",
                          "activity_session",
                          "measurement"
                        ]
                      },
                      "missing": {
                        "type": "string",
                        "enum": [
                          "missed_after_grace",
                          "assumed_after_grace",
                          "unknown"
                        ]
                      },
                      "activityKind": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "activityKinds": {
                        "minItems": 1,
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "uniqueItems": true
                      },
                      "minimumDurationMinutes": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "partialCredit": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "required": [
                      "kind",
                      "eventKind",
                      "missing"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "metricThreshold"
                      },
                      "metricKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "op": {
                        "type": "string",
                        "enum": [
                          ">=",
                          "<=",
                          "==",
                          "between"
                        ]
                      },
                      "value": {
                        "type": "number"
                      },
                      "min": {
                        "type": "number"
                      },
                      "max": {
                        "type": "number"
                      },
                      "missing": {
                        "type": "string",
                        "enum": [
                          "unknown",
                          "failed_after_grace"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "metricKey",
                      "op",
                      "missing"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "metricPresence"
                      },
                      "metricKey": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 160
                      },
                      "missing": {
                        "type": "string",
                        "enum": [
                          "missed_after_grace",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "kind",
                      "metricKey",
                      "missing"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "grace": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "hours": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "hours"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "days": {
                        "type": "number",
                        "minimum": 0
                      }
                    },
                    "required": [
                      "days"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "rollup": {
                "type": "object",
                "properties": {
                  "targetCompletions": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "minimumUsefulCompletions": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "required": [
              "targetId",
              "label",
              "phase",
              "evidence"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "modality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "schedule": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "dailyLocal"
                },
                "localTime": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "timeZone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "localTime",
                "timeZone"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "cron"
                },
                "expression": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400,
                  "pattern": "^(?:[0-5]?\\d)\\s+(?:[01]?\\d|2[0-3])\\s+\\*\\s+\\*\\s+[0-7](?:,[0-7])*$"
                },
                "timeZone": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                }
              },
              "required": [
                "kind",
                "expression",
                "timeZone"
              ],
              "additionalProperties": false
            }
          ]
        },
        "dose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sessionsPerWeek": {
          "type": "number",
          "minimum": 0
        },
        "targetSessions": {
          "type": "integer",
          "minimum": 0
        },
        "minimumUsefulSessions": {
          "type": "integer",
          "minimum": 0
        },
        "logging": {
          "type": "object",
          "properties": {
            "sessionFields": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "uniqueItems": true
            },
            "confounderFields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "sessionFields"
          ],
          "additionalProperties": false
        },
        "stopConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "analysisPlan": {
      "type": "object",
      "properties": {
        "primaryBiomarkerKey": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
        },
        "primaryOutcome": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "metric"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "statistic": {
                  "type": "string",
                  "enum": [
                    "latest",
                    "count",
                    "mean",
                    "median",
                    "min",
                    "max",
                    "sum"
                  ]
                },
                "capture": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "measurement"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "session_field"
                        },
                        "fieldId": {
                          "type": "string",
                          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
                        },
                        "unit": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9._/%^-]+$"
                        }
                      },
                      "required": [
                        "kind",
                        "fieldId"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "derived_metric"
                        },
                        "sourceMetricKey": {
                          "type": "string",
                          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                        }
                      },
                      "required": [
                        "kind",
                        "sourceMetricKey"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "structured_review"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              },
              "required": [
                "kind",
                "key"
              ],
              "additionalProperties": false
            }
          ]
        },
        "secondaryBiomarkerKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
          },
          "uniqueItems": true
        },
        "desiredDirection": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "stabilize"
          ]
        },
        "expectedDirections": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "biomarkerKey": {
                "type": "string",
                "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "increase",
                  "decrease",
                  "stabilize"
                ]
              }
            },
            "required": [
              "biomarkerKey",
              "direction"
            ],
            "additionalProperties": false
          }
        },
        "measurementAnchors": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "baseline",
                  "followup"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "lab_panel",
                  "wearable_summary",
                  "manual_measurement",
                  "text",
                  "photo",
                  "document"
                ]
              },
              "recordId": {
                "type": "string",
                "pattern": "^(?:(?:evt|sample|batch|metric_sample)_[A-Za-z0-9][A-Za-z0-9_-]*|sample-summary:[0-9]{4}-[0-9]{2}-[0-9]{2}:[A-Za-z0-9_-]+:[A-Za-z0-9_.%/-]+|sample-summary:[A-Za-z0-9_-]+:[0-9]{4}-[0-9]{2}-[0-9]{2})$"
              },
              "biomarkerKeys": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
                },
                "uniqueItems": true
              },
              "observedOn": {
                "type": "string",
                "format": "date"
              }
            },
            "required": [
              "role",
              "kind",
              "recordId",
              "biomarkerKeys"
            ],
            "additionalProperties": false
          }
        },
        "plannedMeasurements": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "baseline",
                  "followup"
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "lab_panel",
                  "wearable_summary",
                  "manual_measurement",
                  "text",
                  "photo",
                  "document"
                ]
              },
              "biomarkerKeys": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
                },
                "uniqueItems": true
              },
              "targetWindow": {
                "type": "object",
                "properties": {
                  "start": {
                    "type": "string",
                    "format": "date"
                  },
                  "end": {
                    "type": "string",
                    "format": "date"
                  }
                },
                "required": [
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "role",
              "kind",
              "biomarkerKeys",
              "targetWindow"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "setupAnswers": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "safety": {
          "type": "object",
          "properties": {
            "cautionLevel": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high",
