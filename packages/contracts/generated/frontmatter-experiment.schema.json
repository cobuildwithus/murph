{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.experiment.v1"
    },
    "docType": {
      "type": "string",
      "const": "experiment"
    },
    "experimentId": {
      "type": "string",
      "pattern": "^exp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "startedOn": {
      "type": "string",
      "format": "date"
    },
    "endedOn": {
      "type": "string",
      "format": "date"
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "uniqueItems": true
    },
    "commonsProtocolRef": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
        },
        "pageRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "runSpecRevisionId": {
          "type": "string",
          "pattern": "^sha256:.*"
        },
        "testPlanId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        }
      },
      "required": [
        "key",
        "pageRevisionId",
        "runSpecRevisionId"
      ],
      "additionalProperties": false
    },
    "protocolRef": {
      "type": "object",
      "properties": {
        "protocolId": {
          "type": "string",
          "pattern": "^prot_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "protocolRevisionId": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "effectiveSpecHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "protocolId",
        "protocolRevisionId",
        "effectiveSpecHash"
      ],
      "additionalProperties": false
    },
    "effectiveProtocolSnapshot": {
      "type": "object",
      "properties": {
        "effectiveSpecHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "doseSignature": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "modality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "frequency": {
          "type": "object",
          "properties": {
            "sessionsPerDay": {
              "type": "number",
              "minimum": 0
            },
            "sessionsPerWeek": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "durationMinutes": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            },
            "target": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "temperatureC": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "target": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "targetSessions": {
          "type": "integer",
          "minimum": 0
        },
        "minimumUsefulSessions": {
          "type": "integer",
          "minimum": 0
        },
        "stopConditions": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "required": [
        "effectiveSpecHash",
        "doseSignature"
      ],
      "additionalProperties": false
    },
    "runPlan": {
      "type": "object",
      "properties": {
        "baseline": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "prospective",
                "retrospective",
                "omitted"
              ]
            },
            "source": {
              "type": "string",
              "enum": [
                "wearable_history",
                "manual_measurements"
              ]
            },
            "start": {
              "type": "string",
              "format": "date"
            },
            "end": {
              "type": "string",
              "format": "date"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        "baselineStart": {
          "type": "string",
          "format": "date"
        },
        "baselineEnd": {
          "type": "string",
          "format": "date"
        },
        "interventionStart": {
          "type": "string",
          "format": "date"
        },
        "interventionEnd": {
          "type": "string",
          "format": "date"
        },
        "modality": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "schedule": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "dose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "sessionsPerWeek": {
          "type": "number",
          "minimum": 0
        },
        "targetSessions": {
          "type": "integer",
          "minimum": 0
        },
        "minimumUsefulSessions": {
          "type": "integer",
          "minimum": 0
        },
        "logging": {
          "type": "object",
          "properties": {
            "sessionFields": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "uniqueItems": true
            },
            "confounderFields": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "sessionFields"
          ],
          "additionalProperties": false
        },
        "stopConditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "analysisPlan": {
      "type": "object",
      "properties": {
        "primaryBiomarkerKey": {
          "type": "string",
          "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
        },
        "secondaryBiomarkerKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z_]+:[A-Za-z0-9][A-Za-z0-9._:/-]*(?:@[A-Za-z0-9._:-]+)?$"
          },
          "uniqueItems": true
        },
        "desiredDirection": {
          "type": "string",
          "enum": [
            "increase",
            "decrease",
            "stabilize"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "setupAnswers": {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "safety": {
          "type": "object",
          "properties": {
            "cautionLevel": {
              "type": "string",
              "enum": [
                "low",
                "moderate",
                "high",
                "unknown"
              ]
            },
            "disposition": {
              "type": "string",
              "enum": [
                "continue_with_caution",
                "clinician_guidance_before_unsupervised_start",
                "do_not_start_unsupervised"
              ]
            },
            "positiveQuestionIds": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
              },
              "uniqueItems": true
            },
            "notes": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4000
              }
            }
          },
          "additionalProperties": false
        },
        "contextNotes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        }
      },
      "additionalProperties": false
    },
    "assistantSupport": {
      "type": "object",
      "properties": {
        "reminderPolicy": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "reminderOptionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]*$"
        },
        "remindersEnabled": {
          "type": "boolean"
        },
        "checkInCadence": {
          "type": "string",
          "enum": [
            "none",
            "daily",
            "every_3_days",
            "weekly"
          ]
        },
        "notificationStyle": {
          "type": "string",
          "enum": [
            "skip_by_default",
            "send_scheduled_summary"
          ]
        },
        "missedLogFollowup": {
          "type": "string",
          "enum": [
            "never",
            "opt_in_only",
            "default_on"
          ]
        },
        "weeklyDigestEnabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "properties": {
        "latestOutcomeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "readyForReviewAt": {
          "type": "string",
          "format": "date-time"
        },
        "finalAnalysisStatus": {
          "type": "string",
          "enum": [
            "not_ready",
            "ready",
            "generated"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcomeRef": {
      "type": "object",
      "properties": {
        "outcomeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "generatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "relativePath": {
          "type": "string",
          "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
        }
      },
      "required": [
        "outcomeId"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "docType",
    "experimentId",
    "slug",
    "status",
    "title",
    "startedOn"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-experiment.schema.json",
  "title": "Murph Experiment Frontmatter",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  },
  "dependentRequired": {
    "commonsProtocolRef": [
      "effectiveProtocolSnapshot"
    ],
    "protocolRef": [
      "commonsProtocolRef",
      "effectiveProtocolSnapshot"
    ]
  }
}
