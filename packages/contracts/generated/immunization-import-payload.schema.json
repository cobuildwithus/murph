              "type": "string",
              "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(\\.(\\d+))?([Zz]|([+-])(\\d{2}):(\\d{2}))$",
              "format": "date-time"
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "timeZone": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "description": "IANA time zone; runtime validates support with Intl."
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "manual",
            "import",
            "device",
            "derived"
          ]
