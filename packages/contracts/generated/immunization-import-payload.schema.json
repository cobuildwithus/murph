            "required": [
              "sourceDocumentId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "sourceLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "page": {
                "type": "integer",
                "minimum": 1
              },
              "chunkId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "spanStart": {
                "type": "integer",
                "minimum": 0
              },
              "spanEnd": {
                "type": "integer",
                "minimum": 0
              },
              "excerpt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "sourceDocumentId": {
                "type": "string",
                "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "rawRef": {
                "type": "string",
                "pattern": "^raw\\/[A-Za-z0-9._/-]+$"
              }
            },
            "required": [
              "rawRef"
            ],
            "additionalProperties": false
          }
        ]
      }
