    "eventId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
        },
        {
          "type": "string",
          "const": ""
        },
        {
          "type": "null"
        }
      ]
    },
    "occurredAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "string",
          "pattern": "^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2}):(\\d{2})(\\.(\\d+))?([Zz]|([+-])(\\d{2}):(\\d{2}))$",
          "format": "date-time"
        }
      ]
    },
    "recordedAt": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "format": "date"
