{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.metric-sample.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^smp_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "value": {
      "type": "number"
    },
    "unit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[A-Za-z0-9._/%^-]+$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "dayKey": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "device",
        "import",
        "manual",
        "derived"
      ]
    },
    "quality": {
      "type": "string",
      "enum": [
        "raw",
        "normalized",
        "derived"
      ]
    },
    "qualifiers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "externalRef": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resourceType": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "facet": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        }
      },
      "required": [
        "system",
        "resourceType",
        "resourceId"
      ],
      "additionalProperties": false
    },
    "dataOrigin": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "aggregatorProvider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "sourceProviderSlug": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "sourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
        },
        "sourceInstanceId": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAtRaw": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "timeZoneOffsetMinutes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -1440,
              "maximum": 1440
            },
            {
              "type": "null"
            }
          ]
        },
        "timestampSemantics": {
          "type": "string",
          "enum": [
            "utc",
            "offset",
            "floating",
            "unknown"
          ]
        },
        "originConfidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        },
        "normalizerVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "timeZone": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "description": "IANA time zone; runtime validates support with Intl."
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "metric",
    "value",
    "unit",
    "recordedAt",
    "dayKey",
    "source",
    "quality"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/metric-sample-record.schema.json",
  "title": "Murph Metric Sample Record"
}
