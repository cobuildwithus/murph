{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.audit.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^aud_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "allergy_upsert",
        "automation_upsert",
        "scheduled_log_upsert",
        "condition_upsert",
        "family_upsert",
        "genetics_upsert",
        "goal_upsert",
        "food_delete",
        "food_upsert",
        "history_add",
        "inbox_capture_canonical_evidence",
        "inbox_capture_persist",
        "inbox_promote_experiment_note",
        "inbox_promote_journal",
        "intake_import",
        "intake_project",
        "jsonl_append",
        "journal_append",
        "journal_ensure",
        "journal_link",
        "journal_unlink",
        "knowledge_write",
        "memory_forget",
        "memory_upsert",
        "document_import",
        "device_import",
        "experiment_create",
        "experiment_lifecycle",
        "experiment_update",
        "event_delete",
        "event_upsert",
        "list",
        "meal_add",
        "export_pack",
        "preferences_update",
        "provider_delete",
        "provider_upsert",
        "raw_copy",
        "recipe_delete",
        "recipe_upsert",
        "research_note_write",
        "regimen_stop",
        "regimen_upsert",
        "protocol_upsert",
        "samples_import_csv",
        "show",
        "validate",
        "vault_init",
        "vault_repair",
        "vault_summary_update",
        "workout_format_save",
        "workout_import_csv"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failure"
      ]
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string",
      "enum": [
        "cli",
        "core",
        "importer",
        "query"
      ]
    },
    "commandName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "targetIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255
      },
      "uniqueItems": true
    },
    "errorCode": {
      "type": "string",
      "enum": [
        "CONTRACT_INVALID",
        "ID_INVALID",
        "PATH_INVALID",
        "VAULT_INVALID",
        "EVENT_INVALID",
        "SAMPLE_INVALID",
        "AUDIT_INVALID",
        "FRONTMATTER_INVALID",
        "ENUM_UNSUPPORTED",
        "SHARD_KEY_INVALID",
        "SCHEMA_ARTIFACT_STALE"
      ]
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9._/-]+$"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "append",
              "update",
              "copy",
              "delete"
            ]
          }
        },
        "required": [
          "path",
          "op"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "action",
    "status",
    "occurredAt",
    "actor",
    "commandName",
    "summary",
    "changes"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/audit-record.schema.json",
  "title": "Murph Audit Record"
}
