{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "conditionId": {
      "type": "string",
      "pattern": "^cond_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "clinicalStatus": {
      "type": "string",
      "enum": [
        "active",
        "inactive",
        "resolved"
      ]
    },
    "verificationStatus": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "unconfirmed",
            "provisional",
            "confirmed",
            "refuted"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "assertedOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "resolvedOn": {
      "anyOf": [
        {
          "type": "string",
          "format": "date"
        },
        {
          "type": "null"
        }
      ]
    },
    "severity": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "mild",
            "moderate",
            "severe"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "bodySites": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "relatedGoalIds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "relatedRegimenIds": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^reg_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "links": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "related_goal"
                  },
                  "targetId": {
                    "type": "string",
                    "pattern": "^goal_[0-9A-HJKMNP-TV-Z]{26}$"
                  }
                },
                "required": [
                  "type",
                  "targetId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "related_regimen"
                  },
                  "targetId": {
                    "type": "string",
                    "pattern": "^reg_[0-9A-HJKMNP-TV-Z]{26}$"
                  }
                },
                "required": [
                  "type",
                  "targetId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "uniqueItems": true
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "$id": "@murphai/contracts/condition-upsert-patch-payload.schema.json",
  "title": "Murph Condition Upsert Patch Payload"
}
