              "const": "dailyLocal"
            },
            "localTime": {
              "type": "string",
              "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
            }
          },
          "required": [
            "kind",
            "localTime"
          ],
          "additionalProperties": false
        }
      ]
    },
