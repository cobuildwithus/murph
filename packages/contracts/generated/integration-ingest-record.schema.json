{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.integration-ingest.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^xfm_[0-9A-Za-z]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "source": {
      "type": "string",
      "enum": [
        "manual",
        "import",
        "device",
        "derived"
      ]
    },
    "importedAt": {
      "type": "string",
      "minLength": 1
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "wearable.raw_ingest_receipt.v1"
        },
        "id": {
          "type": "string",
          "pattern": "^wearable_raw_[a-f0-9]{24}$"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "poll",
            "webhook",
            "sdk",
            "xml",
            "manual"
          ]
        },
        "deliveryMode": {
          "type": "string",
          "enum": [
            "full_payload",
            "notification_only",
            "scheduled_reconcile"
          ]
        },
        "resourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "providerEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "eventType": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "deauthorize"
          ]
        },
        "observedAt": {
          "type": "string",
          "minLength": 1
        },
        "occurredAt": {
          "type": "string",
          "minLength": 1
        },
        "windowStart": {
          "type": "string",
          "minLength": 1
        },
        "windowEnd": {
          "type": "string",
          "minLength": 1
        },
        "cursor": {
          "type": "string",
          "maxLength": 4000
        },
        "signatureVerified": {
          "type": "boolean"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "provider",
        "sourceKind",
        "deliveryMode",
        "observedAt",
        "payloadHash"
      ],
      "additionalProperties": false
    },
    "parts": {
      "maxItems": 10000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!\\.\\.?$)[^/\\\\\\u0000-\\u001f\\u007f]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[^\\s/]+\\/[^\\s/]+$"
          },
          "content": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadata": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "role",
          "fileName",
          "mediaType",
          "content",
          "byteSize",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "events": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^evt_[0-9A-Za-z]+$"
              },
              "roles": {
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                }
              }
            },
            "required": [
              "id",
              "roles"
            ],
            "additionalProperties": false
          }
        },
        "eventIdsComplete": {
          "type": "boolean"
        },
        "sampleIds": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^smp_[0-9A-Za-z]+$"
          }
        },
        "sampleIdsComplete": {
          "type": "boolean"
        }
      },
      "required": [
        "events",
        "eventIdsComplete",
        "sampleIds",
        "sampleIdsComplete"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "eventCount",
        "sampleCount"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "source",
    "importedAt",
    "parts",
    "outputs",
    "counts"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/integration-ingest-record.schema.json",
  "title": "Murph Integration Ingest Record",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
