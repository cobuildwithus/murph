{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.integration-ingest.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^xfm_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "importedAt": {
      "type": "string",
      "format": "date-time"
    },
    "receipt": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "wearable.raw_ingest_receipt.v1"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "accountId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "connectionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "sourceKind": {
          "type": "string",
          "enum": [
            "poll",
            "webhook",
            "sdk",
            "xml",
            "manual"
          ]
        },
        "deliveryMode": {
          "type": "string",
          "enum": [
            "full_payload",
            "notification_only",
            "scheduled_reconcile"
          ]
        },
        "resourceType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "providerEventId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "eventType": {
          "type": "string",
          "enum": [
            "create",
            "update",
            "delete",
            "deauthorize"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "windowStart": {
          "type": "string",
          "format": "date-time"
        },
        "windowEnd": {
          "type": "string",
          "format": "date-time"
        },
        "cursor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "signatureVerified": {
          "type": "boolean"
        },
        "payloadHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$"
        },
        "rawArtifactRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "rawArtifactCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "provider",
        "sourceKind",
        "deliveryMode",
        "observedAt",
        "payloadHash"
      ],
      "additionalProperties": false
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "fileName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "content": {
            "type": "string"
          },
          "byteSize": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[a-f0-9]{64}$"
          },
          "metadata": {
            "type": "object",
            "properties": {},
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          }
        },
        "required": [
          "role",
          "fileName",
          "mediaType",
          "content",
          "byteSize",
          "sha256"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "outputs": {
      "type": "object",
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$"
              },
              "roles": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                },
                "uniqueItems": true
              }
            },
            "required": [
              "id",
              "roles"
            ],
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "sampleIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^smp_[0-9A-HJKMNP-TV-Z]{26}$"
          },
          "uniqueItems": true
        },
        "sampleIdsComplete": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "eventCount": {
          "type": "integer",
          "minimum": 0
        },
        "sampleCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "eventCount",
        "sampleCount"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "$ref": "#/$defs/__schema0"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "provider",
    "source",
    "importedAt",
    "parts",
    "counts"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/integration-ingest-record.schema.json",
  "title": "Murph Integration Ingest Record",
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "properties": {},
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    }
  }
}
