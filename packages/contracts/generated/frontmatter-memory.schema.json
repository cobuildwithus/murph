{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "docType": {
      "type": "string",
      "const": "memory"
    },
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.memory.v1"
    },
    "title": {
      "default": "Memory",
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "docType",
    "schemaVersion",
    "title",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-memory.schema.json",
  "title": "Murph Memory Frontmatter"
}
