{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "docType": {
      "type": "string",
      "const": "memory"
    },
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.memory.v1"
    },
    "title": {
      "default": "Memory",
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "lastDemographicsAction": {
      "type": "object",
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "applied",
            "unchanged",
            "rejected"
          ]
        }
      },
      "required": [
        "actionId",
        "payloadHash",
        "status"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "docType",
    "schemaVersion",
    "title",
    "updatedAt"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-memory.schema.json",
  "title": "Murph Memory Frontmatter"
}
