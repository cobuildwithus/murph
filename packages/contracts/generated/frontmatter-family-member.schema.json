{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "murph.frontmatter.family-member.v1"
    },
    "docType": {
      "type": "string",
      "const": "family_member"
    },
    "familyMemberId": {
      "type": "string",
      "pattern": "^fam_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "relationship": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      },
      "uniqueItems": true
    },
    "conditionHistory": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "codeSystem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "status": {
            "default": "present",
            "type": "string",
            "enum": [
              "present",
              "absent",
              "possible",
              "unknown"
            ]
          },
          "certainty": {
            "type": "string",
            "enum": [
              "reported",
              "documented",
              "suspected",
              "denied",
              "unknown"
            ]
          },
          "onsetAge": {
            "type": "number",
            "minimum": 0,
            "maximum": 130
          },
          "onsetText": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "deceasedCause": {
            "type": "boolean"
          },
          "sourceLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "evidence": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "sourceLabel": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chunkId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "spanStart": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "spanEnd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "sourceDocumentId": {
                      "type": "string",
                      "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "rawRef": {
                      "type": "string",
                      "pattern": "^raw\\/[A-Za-z0-9._/-]+$"
                    }
                  },
                  "required": [
                    "sourceDocumentId"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "sourceLabel": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 240
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "chunkId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120
                    },
                    "spanStart": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "spanEnd": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "excerpt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 500
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "sourceDocumentId": {
                      "type": "string",
                      "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
                    },
                    "rawRef": {
                      "type": "string",
                      "pattern": "^raw\\/[A-Za-z0-9._/-]+$"
                    }
                  },
                  "required": [
                    "rawRef"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "condition",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "deceased": {
      "type": "boolean"
    },
    "note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "relatedVariantIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^var_[0-9A-HJKMNP-TV-Z]{26}$"
      },
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "related_variant"
          },
          "targetId": {
            "type": "string",
            "pattern": "^var_[0-9A-HJKMNP-TV-Z]{26}$"
          }
        },
        "required": [
          "type",
          "targetId"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "docType",
    "familyMemberId",
    "slug",
    "title",
    "relationship"
  ],
  "additionalProperties": false,
  "$id": "@murphai/contracts/frontmatter-family-member.schema.json",
  "title": "Murph Family Member Frontmatter"
}
