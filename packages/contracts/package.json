{
  "name": "@murphai/contracts",
  "version": "1.1.0",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "generated",
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js",
      "default": "./dist/schemas.js"
    },
    "./generated/*": "./generated/*"
  },
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist && tsc -b tsconfig.build.json --force --pretty false && tsc -p tsconfig.scripts.json --pretty false",
    "typecheck": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.vitest.json --pretty false",
    "generate": "pnpm build && node ./dist/scripts/generate-json-schema.js",
    "test:vitest": "vitest run --config vitest.config.ts",
    "test:coverage:vitest": "vitest run --config vitest.config.ts --coverage",
    "test:artifacts": "pnpm build && node ./dist/scripts/verify.js",
    "test:coverage": "pnpm test:coverage:vitest && pnpm test:artifacts",
    "test": "pnpm test:vitest && pnpm test:artifacts",
    "verify": "pnpm test"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
