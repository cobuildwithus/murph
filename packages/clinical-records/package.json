{
  "name": "@murphai/clinical-records",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./retrieval-limits": {
      "types": "./dist/retrieval-limits.d.ts",
      "import": "./dist/retrieval-limits.js",
      "default": "./dist/retrieval-limits.js"
    },
    "./provider-directory": {
      "types": "./dist/provider-directory.d.ts",
      "import": "./dist/provider-directory.js",
      "default": "./dist/provider-directory.js"
    },
    "./provider-directory.v2.json": "./provider-directory.v2.json",
    "./portal-discovery-link": {
      "types": "./dist/portal-discovery-link.d.ts",
      "import": "./dist/portal-discovery-link.js",
      "default": "./dist/portal-discovery-link.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "provider-directory.v2.json"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json --pretty false",
    "typecheck": "node ../../scripts/run-typescript.mjs check -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/contracts": "workspace:*",
    "tldts": "7.0.30"
  },
  "devDependencies": {
    "zod": "^4.5.4"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
