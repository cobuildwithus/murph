{
  "name": "@murphai/importers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./clinical-records": {
      "types": "./dist/clinical-records/index.d.ts",
      "import": "./dist/clinical-records/index.js",
      "default": "./dist/clinical-records/index.js"
    },
    "./device-providers/provider-descriptors": {
      "types": "./dist/device-providers/provider-descriptors.d.ts",
      "import": "./dist/device-providers/provider-descriptors.js",
      "default": "./dist/device-providers/provider-descriptors.js"
    },
    "./device-providers/junction-origin": {
      "types": "./dist/device-providers/junction-origin.d.ts",
      "import": "./dist/device-providers/junction-origin.js",
      "default": "./dist/device-providers/junction-origin.js"
    },
    "./device-providers/junction": {
      "types": "./dist/device-providers/junction.d.ts",
      "import": "./dist/device-providers/junction.js",
      "default": "./dist/device-providers/junction.js"
    },
    "./device-providers/junction-bounded-features": {
      "types": "./dist/device-providers/junction-bounded-features.d.ts",
      "import": "./dist/device-providers/junction-bounded-features.js",
      "default": "./dist/device-providers/junction-bounded-features.js"
    },
    "./device-providers/junction-resources": {
      "types": "./dist/device-providers/junction-resources.d.ts",
      "import": "./dist/device-providers/junction-resources.js",
      "default": "./dist/device-providers/junction-resources.js"
    },
    "./device-providers/metric-catalog": {
      "types": "./dist/device-providers/metric-catalog.d.ts",
      "import": "./dist/device-providers/metric-catalog.js",
      "default": "./dist/device-providers/metric-catalog.js"
    },
    "./device-providers/raw-ingest-receipt": {
      "types": "./dist/device-providers/raw-ingest-receipt.d.ts",
      "import": "./dist/device-providers/raw-ingest-receipt.js",
      "default": "./dist/device-providers/raw-ingest-receipt.js"
    },
    "./sample-series-summary": {
      "types": "./dist/sample-series-summary.d.ts",
      "import": "./dist/sample-series-summary.js",
      "default": "./dist/sample-series-summary.js"
    }
  },
  "scripts": {
    "build": "pnpm --dir ../.. exec tsx --tsconfig tsconfig.base.json packages/importers/scripts/safe-build.ts",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/clinical-records": "workspace:*",
    "@murphai/contracts": "workspace:*",
    "@murphai/core": "workspace:*",
    "@murphai/health-metrics": "workspace:*"
  },
  "devDependencies": {
    "@medplum/fhirtypes": "^5.1.24",
    "zod": "^4.4.3"
  }
}
