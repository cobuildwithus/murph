{
  "name": "@murphai/importers",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "README.md",
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./device-providers/provider-descriptors": {
      "types": "./dist/device-providers/provider-descriptors.d.ts",
      "import": "./dist/device-providers/provider-descriptors.js",
      "default": "./dist/device-providers/provider-descriptors.js"
    },
    "./device-providers/canonical-wearable-records": {
      "types": "./dist/device-providers/canonical-wearable-records.d.ts",
      "import": "./dist/device-providers/canonical-wearable-records.js",
      "default": "./dist/device-providers/canonical-wearable-records.js"
    },
    "./device-providers/metric-catalog": {
      "types": "./dist/device-providers/metric-catalog.d.ts",
      "import": "./dist/device-providers/metric-catalog.js",
      "default": "./dist/device-providers/metric-catalog.js"
    },
    "./device-providers/raw-ingest-envelope": {
      "types": "./dist/device-providers/raw-ingest-envelope.d.ts",
      "import": "./dist/device-providers/raw-ingest-envelope.js",
      "default": "./dist/device-providers/raw-ingest-envelope.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist && tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/contracts": "workspace:*",
    "@murphai/core": "workspace:*",
    "zod": "^4.3.6"
  }
}
