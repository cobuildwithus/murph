{
  "name": "@murphai/runtime-state",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assistant-ids": {
      "types": "./dist/assistant-ids.d.ts",
      "default": "./dist/assistant-ids.js"
    },
    "./hosted-codex-subscription-auth": {
      "types": "./dist/hosted-codex-subscription-auth.d.ts",
      "default": "./dist/hosted-codex-subscription-auth.js"
    },
    "./loopback-control-plane": {
      "types": "./dist/loopback-control-plane.d.ts",
      "default": "./dist/loopback-control-plane.js"
    },
    "./node": {
      "types": "./dist/node/index.d.ts",
      "default": "./dist/node/index.js"
    },
    "./node/assistant-runtime-issues": {
      "types": "./dist/node/assistant-runtime-issues.d.ts",
      "default": "./dist/node/assistant-runtime-issues.js"
    },
    "./node/assistant-state-fs": {
      "types": "./dist/node/assistant-state-fs.d.ts",
      "default": "./dist/node/assistant-state-fs.js"
    },
    "./node/hosted-bundle-codec": {
      "types": "./dist/node/hosted-bundle-codec.d.ts",
      "default": "./dist/node/hosted-bundle-codec.js"
    },
    "./node/loopback-control-plane-auth": {
      "types": "./dist/node/loopback-control-plane-auth.d.ts",
      "default": "./dist/node/loopback-control-plane-auth.js"
    },
    "./node/runtime-paths": {
      "types": "./dist/node/runtime-paths.d.ts",
      "default": "./dist/node/runtime-paths.js"
    },
    "./node/sqlite-warning-filter": {
      "types": "./dist/node/sqlite-warning-filter.d.ts",
      "default": "./dist/node/sqlite-warning-filter.js"
    },
    "./node/ulid": {
      "types": "./dist/node/ulid.d.ts",
      "default": "./dist/node/ulid.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
