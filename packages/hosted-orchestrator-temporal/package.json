{
  "name": "@murphai/hosted-orchestrator-temporal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./activities": {
      "types": "./dist/activities/index.d.ts",
      "default": "./dist/activities/index.js"
    },
    "./client": {
      "types": "./dist/client/signal-hosted-user-runtime.d.ts",
      "default": "./dist/client/signal-hosted-user-runtime.js"
    },
    "./client/temporal-client": {
      "types": "./dist/client/temporal-client.d.ts",
      "default": "./dist/client/temporal-client.js"
    },
    "./client/device-sync-reconciler-schedule": {
      "types": "./dist/client/device-sync-reconciler-schedule.d.ts",
      "default": "./dist/client/device-sync-reconciler-schedule.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./workflows/hosted-user-runtime": {
      "types": "./dist/workflows/hosted-user-runtime.d.ts",
      "default": "./dist/workflows/hosted-user-runtime.js"
    },
    "./workflows/hosted-device-sync-reconciler": {
      "types": "./dist/workflows/hosted-device-sync-reconciler.d.ts",
      "default": "./dist/workflows/hosted-device-sync-reconciler.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && tsc -b tsconfig.json && node dist/scripts/build-workflow-bundle.js",
    "temporal:ensure-device-sync-reconciler-schedule": "pnpm exec tsx --tsconfig ../../tsconfig.base.json src/scripts/ensure-device-sync-reconciler-schedule.ts",
    "temporal:ensure-device-sync-reconciler-schedule:prod": "NODE_ENV=production node dist/scripts/ensure-device-sync-reconciler-schedule.js",
    "temporal:worker": "pnpm exec tsx --tsconfig ../../tsconfig.base.json src/worker.ts",
    "temporal:worker:prod": "NODE_ENV=production node dist/worker.js",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/hosted-execution": "workspace:*",
    "@temporalio/activity": "~1.16.3",
    "@temporalio/client": "~1.16.3",
    "@temporalio/common": "~1.16.3",
    "@temporalio/worker": "~1.16.3",
    "@temporalio/workflow": "~1.16.3"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
