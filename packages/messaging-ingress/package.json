{
  "name": "@murphai/messaging-ingress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "exports": {
    "./linq-webhook": {
      "types": "./dist/linq-webhook.d.ts",
      "default": "./dist/linq-webhook.js"
    },
    "./telegram-webhook": {
      "types": "./dist/telegram-webhook.d.ts",
      "default": "./dist/telegram-webhook.js"
    },
    "./telegram-webhook-payload": {
      "types": "./dist/telegram-webhook-payload.d.ts",
      "default": "./dist/telegram-webhook-payload.js"
    },
    "./whatsapp-webhook": {
      "types": "./dist/whatsapp-webhook.d.ts",
      "default": "./dist/whatsapp-webhook.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && tsc -b tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm build && MURPH_MESSAGING_INGRESS_TEST_BUILT_DIST=1 pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm build && MURPH_MESSAGING_INGRESS_TEST_BUILT_DIST=1 pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
