{
  "name": "@murphai/query",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./browser-biomarkers": {
      "types": "./dist/browser-biomarkers.d.ts",
      "import": "./dist/browser-biomarkers.js",
      "default": "./dist/browser-biomarkers.js"
    },
    "./browser-experiments": {
      "types": "./dist/browser-experiments.d.ts",
      "import": "./dist/browser-experiments.js",
      "default": "./dist/browser-experiments.js"
    },
    "./browser-murph-age": {
      "types": "./dist/browser-murph-age.d.ts",
      "import": "./dist/browser-murph-age.js",
      "default": "./dist/browser-murph-age.js"
    },
    "./browser-overview": {
      "types": "./dist/browser-overview.d.ts",
      "import": "./dist/browser-overview.js",
      "default": "./dist/browser-overview.js"
    },
    "./browser-replica-client": {
      "types": "./dist/browser-replica-client.d.ts",
      "import": "./dist/browser-replica-client.js",
      "default": "./dist/browser-replica-client.js"
    },
    "./entity-families": {
      "types": "./dist/entity-families.d.ts",
      "import": "./dist/entity-families.js",
      "default": "./dist/entity-families.js"
    },
    "./id-families": {
      "types": "./dist/id-families.d.ts",
      "import": "./dist/id-families.js",
      "default": "./dist/id-families.js"
    },
    "./murph-age": {
      "types": "./dist/murph-age.d.ts",
      "import": "./dist/murph-age.js",
      "default": "./dist/murph-age.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/contracts": "workspace:*",
    "@murphai/health-metrics": "workspace:*",
    "@murphai/runtime-state": "workspace:*"
  },
  "devDependencies": {
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
