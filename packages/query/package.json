{
  "name": "@murphai/query",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./entity-families": {
      "types": "./dist/entity-families.d.ts",
      "import": "./dist/entity-families.js",
      "default": "./dist/entity-families.js"
    },
    "./id-families": {
      "types": "./dist/id-families.d.ts",
      "import": "./dist/id-families.js",
      "default": "./dist/id-families.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist && tsc -b tsconfig.json --force",
    "typecheck": "tsc -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@murphai/contracts": "workspace:*",
    "@murphai/importers": "workspace:*",
    "@murphai/runtime-state": "workspace:*",
    "zod": "^4.3.6",
    "@murphai/health-metrics": "workspace:*"
  },
  "engines": {
    "node": ">=24.14.1"
  }
}
