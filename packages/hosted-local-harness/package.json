{
  "name": "@murphai/hosted-local-harness",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./dev-hosted-local/*": "./src/dev-hosted-local/*.ts",
    "./harness": "./src/harness.ts",
    "./e2e": "./src/e2e.ts",
    "./stripe-billing-live-config": "./src/stripe-billing-live-config.ts"
  },
  "dependencies": {
    "@murphai/device-syncd": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/operator-config": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage",
    "verify:package-boundary": "pnpm --dir ../hosted-execution build && pnpm --dir ../operator-config build && MURPH_HOSTED_LOCAL_HARNESS_TEST_PACKAGE_BOUNDARY=1 pnpm exec vitest run --config vitest.config.ts test/package-boundary.test.ts --no-coverage",
    "verify:package-boundary:prepared": "MURPH_HOSTED_LOCAL_HARNESS_TEST_PACKAGE_BOUNDARY=1 pnpm exec vitest run --config vitest.config.ts test/package-boundary.test.ts --no-coverage"
  },
  "engines": { "node": ">=24.14.1" }
}
