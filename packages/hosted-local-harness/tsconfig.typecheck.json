{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": true,
    "noEmit": true,
    "rootDir": "../..",
    "tsBuildInfoFile": "typecheck.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "dist",
    "coverage"
  ]
}
