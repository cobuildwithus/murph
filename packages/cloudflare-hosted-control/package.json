{
  "name": "@murphai/cloudflare-hosted-control",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/cobuildwithus/murph"
  },
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./device-webhook-queue": {
      "types": "./dist/device-webhook-queue.d.ts",
      "default": "./dist/device-webhook-queue.js"
    },
    "./inference-verification": {
      "types": "./dist/inference-verification.d.ts",
      "default": "./dist/inference-verification.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/rm-paths.mjs dist .tsbuildinfo && node ../../scripts/run-typescript.mjs package -b tsconfig.json",
    "typecheck": "node ../../scripts/run-typescript.mjs package -p tsconfig.typecheck.json --pretty false",
    "test": "pnpm exec vitest run --config vitest.config.ts --no-coverage",
    "test:coverage": "pnpm exec vitest run --config vitest.config.ts --coverage"
  },
  "engines": {
    "node": ">=24.14.1"
  },
  "dependencies": {
    "@murphai/device-syncd": "workspace:*",
    "@murphai/hosted-execution": "workspace:*",
    "@murphai/runtime-state": "workspace:*"
  }
}
