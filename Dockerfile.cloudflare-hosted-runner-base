ARG NODE_VERSION=24.14.1
ARG NODE_IMAGE_DIGEST=sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c
ARG WHISPER_CPP_VERSION=v1.8.1
ARG WHISPER_CPP_SHA256=b7c6b05635e5fda85cbcc5a012d29b3a4ca1cc22d9fa54d5b6c33e4ac271e5e0
ARG WHISPER_CPP_BUILD_JOBS=1
ARG WHISPER_MODEL_FILE=ggml-base.en.bin
ARG WHISPER_MODEL_SHA256=a03779c86df3323075f5e796cb2ce5029f00ec8869eee3fdfb897afe36c6d002
ARG WHISPER_MODEL_IMAGE=ghcr.io/cobuildwithus/murph-whisper-model:ggml-base-en-sha256-a03779c86df3323075f5e796cb2ce5029f00ec8869eee3fdfb897afe36c6d002
ARG CODEX_CLI_VERSION=0.135.0

FROM ${WHISPER_MODEL_IMAGE} AS whisper-model

FROM node:${NODE_VERSION}-bookworm-slim@${NODE_IMAGE_DIGEST} AS whisper-builder

ARG NODE_VERSION
ARG NODE_IMAGE_DIGEST
ARG WHISPER_CPP_VERSION
ARG WHISPER_CPP_SHA256
ARG WHISPER_CPP_BUILD_JOBS
ARG WHISPER_MODEL_FILE
ARG WHISPER_MODEL_SHA256

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    cmake \
    curl \
    g++ \
    make \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /tmp/whisper.cpp

RUN curl -fsSL --retry 5 --retry-delay 2 \
    "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/${WHISPER_CPP_VERSION}.tar.gz" \
    -o /tmp/whisper.cpp.tar.gz \
  && printf '%s  %s\n' "${WHISPER_CPP_SHA256}" /tmp/whisper.cpp.tar.gz | sha256sum -c - \
  && tar -xzf /tmp/whisper.cpp.tar.gz --strip-components=1 \
  && rm /tmp/whisper.cpp.tar.gz \
  && cmake -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DGGML_BACKEND_DL=ON \
    -DGGML_CPU_ALL_VARIANTS=ON \
    -DGGML_NATIVE=OFF \
  && cmake --build build -j"${WHISPER_CPP_BUILD_JOBS}" --config Release --target whisper-cli \
  && install -d /opt/whisper/bin /opt/whisper/lib \
  && install -Dm755 build/bin/whisper-cli /opt/whisper/bin/whisper-cli \
  && cp -a build/bin/libggml-cpu*.so /opt/whisper/bin/ \
  && cp -a build/src/libwhisper.so* /opt/whisper/lib/ \
  && cp -a build/ggml/src/libggml*.so* /opt/whisper/lib/

COPY --from=whisper-model /model.bin /opt/whisper/${WHISPER_MODEL_FILE}

RUN printf '%s  %s\n' "${WHISPER_MODEL_SHA256}" "/opt/whisper/${WHISPER_MODEL_FILE}" | sha256sum -c -

FROM node:${NODE_VERSION}-bookworm-slim@${NODE_IMAGE_DIGEST}

ARG NODE_VERSION
ARG NODE_IMAGE_DIGEST
ARG WHISPER_MODEL_FILE
ARG CODEX_CLI_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/runner \
    NODE_ENV=production \
    PATH=/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PORT=8080 \
    XDG_CACHE_HOME=/home/runner/.cache \
    HOSTED_HOME=/home/runner/.murph \
    HOSTED_MODELS_ROOT=/home/runner/.murph/models \
    HF_HOME=/home/runner/.cache/huggingface

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    file \
    ffmpeg \
    jq \
    mupdf-tools \
    poppler-utils \
    python-is-python3 \
    python3 \
    qpdf \
    tini \
    zstd \
  && useradd --create-home --home-dir /home/runner --shell /usr/sbin/nologin runner \
  && mkdir -p \
    /home/runner/.cache/huggingface \
    /home/runner/.murph/hosted \
    /home/runner/.murph/models/whisper \
  && chown -R runner:runner /home/runner \
  && rm -rf /var/lib/apt/lists/*

# The hosted assistant harness is Codex app-server itself; repo-local helpers
# only coordinate the mailbox/runtime around this pinned CLI.
RUN npm install --global --omit=dev --no-audit --no-fund --ignore-scripts "@openai/codex@${CODEX_CLI_VERSION}" \
  && npm cache clean --force

WORKDIR /app

COPY --from=whisper-builder /opt/whisper/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /opt/whisper/bin/libggml-cpu*.so /usr/local/bin/
COPY --from=whisper-builder /opt/whisper/lib/ /usr/local/lib/
COPY --from=whisper-builder --chown=runner:runner /opt/whisper/${WHISPER_MODEL_FILE} /home/runner/.murph/models/whisper/model.bin

RUN ldconfig

USER runner

RUN python3 --version \
  && python --version \
  && jq --version \
  && zstd --version \
  && codex --version \
  && codex app-server --help >/dev/null \
  && codex doctor --help >/dev/null

EXPOSE 8080
