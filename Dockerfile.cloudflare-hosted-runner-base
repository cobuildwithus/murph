ARG NODE_VERSION=24.14.1
ARG NODE_IMAGE_DIGEST=sha256:b506e7321f176aae77317f99d67a24b272c1f09f1d10f1761f2773447d8da26c
ARG CODEX_CLI_VERSION=0.135.0

FROM node:${NODE_VERSION}-bookworm-slim@${NODE_IMAGE_DIGEST}

ARG NODE_VERSION
ARG NODE_IMAGE_DIGEST
ARG CODEX_CLI_VERSION

ENV DEBIAN_FRONTEND=noninteractive \
    HOME=/home/runner \
    NODE_ENV=production \
    PATH=/app/node_modules/.bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PORT=8080 \
    XDG_CACHE_HOME=/home/runner/.cache \
    HOSTED_HOME=/home/runner/.murph \
    HOSTED_MODELS_ROOT=/home/runner/.murph/models \
    HF_HOME=/home/runner/.cache/huggingface

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    file \
    ffmpeg \
    jq \
    mupdf-tools \
    poppler-utils \
    python-is-python3 \
    python3 \
    qpdf \
    ripgrep \
    tini \
    zstd \
  && useradd --create-home --home-dir /home/runner --shell /usr/sbin/nologin runner \
  && mkdir -p \
    /home/runner/.cache/huggingface \
    /home/runner/.murph/hosted \
  && chown -R runner:runner /home/runner \
  && rm -rf /var/lib/apt/lists/*

# The hosted assistant harness is Codex app-server itself; repo-local helpers
# only coordinate the mailbox/runtime around this pinned CLI.
RUN npm install --global --omit=dev --no-audit --no-fund --ignore-scripts "@openai/codex@${CODEX_CLI_VERSION}" \
  && npm cache clean --force

WORKDIR /app

USER runner

RUN python3 --version \
  && python --version \
  && jq --version \
  && rg --version \
  && zstd --version \
  && ffmpeg -hide_banner -loglevel error -f lavfi -i anullsrc=channel_layout=mono:sample_rate=16000 -t 0.1 -codec:a libmp3lame -b:a 64k /tmp/murph-libmp3lame-smoke.mp3 \
  && test -s /tmp/murph-libmp3lame-smoke.mp3 \
  && rm -f /tmp/murph-libmp3lame-smoke.mp3 \
  && codex --version \
  && codex app-server --help >/dev/null \
  && codex doctor --help >/dev/null

EXPOSE 8080
